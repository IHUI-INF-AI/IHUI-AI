  <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', position: 'absolute', top: 52, right: 56 }}>
    <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 14, color: '#64748B' }}>02 · 产品</Text>
  </Box>
  <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 34, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 0.5 }}>一个人，一台电脑——14 个月建成 8 端平台</Text>
  <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 1168, height: 1, background: 'rgba(255,255,255,0.14)', marginTop: 16 }} />
  <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', marginTop: 36, gap: 60 }}>
    <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 500, flexDirection: 'column', gap: 10 }}>
      <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 104, fontWeight: 'bold', color: 'transparent', backgroundImage: 'linear-gradient(135deg, #22D3EE 0%, #818CF8 100%)', backgroundClip: 'text' }}>1 个人</Text>
      <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 24, color: '#FFFFFF', fontWeight: 'bold' }}>非科班出身，自学 AI 开发 5 年</Text>
      <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 20, color: '#94A3B8', lineHeight: 1.5 }}>10 年产品设计 + 10 年线下教育，架构、原型、全栈开发一人完成。</Text>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', gap: 40, marginTop: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 26, color: '#22D3EE', fontWeight: 'bold' }}>150 万</Text>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 14, color: '#64748B' }}>已自投（元）</Text>
        </Box>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 26, color: '#22D3EE', fontWeight: 'bold' }}>2 项</Text>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 14, color: '#64748B' }}>核心技术专利</Text>
        </Box>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 26, color: '#22D3EE', fontWeight: 'bold' }}>109 万行</Text>
          <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 14, color: '#64748B' }}>开源可审计代码</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flex: 1, flexDirection: 'column', gap: 13 }}>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 96, height: 44, borderRadius: 14, backgroundImage: 'linear-gradient(135deg, #22D3EE 0%, #818CF8 100%)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#070B14', fontWeight: 'bold' }}>2025.5</Text></Box>
        <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#CBD5E1' }}>启动开发——传统工程 + AI vibecoding 流水线</Text>
      </Box>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 96, height: 44, borderRadius: 14, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.2)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#FFFFFF', fontWeight: 'bold' }}>2025.10</Text></Box>
        <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#CBD5E1' }}>微信小程序上线运营</Text>
      </Box>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 96, height: 44, borderRadius: 14, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.2)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#FFFFFF', fontWeight: 'bold' }}>2025.12</Text></Box>
        <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#CBD5E1' }}>安卓 App 上线各大应用商店</Text>
      </Box>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 96, height: 44, borderRadius: 14, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.2)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#FFFFFF', fontWeight: 'bold' }}>2026.3</Text></Box>
        <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#CBD5E1' }}>Web 平台 + 教育平台整合上线</Text>
      </Box>
      <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', width: 96, height: 44, borderRadius: 14, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.2)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#FFFFFF', fontWeight: 'bold' }}>2026.7</Text></Box>
        <Text style={{ fontFamily: 'Arial, "Microsoft YaHei", "PingFang SC", sans-serif', fontSize: 19, color: '#CBD5E1' }}>Chrome 插件、CLI 沙箱、代码库检索交付</Text>
      </Box>
    </Box>
  </Box>
