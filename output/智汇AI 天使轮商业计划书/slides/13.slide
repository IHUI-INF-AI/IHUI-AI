          <Box style={{ flex: 1, height: 62, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 20, color: '#E2E8F0', fontWeight: 'bold' }}>3.8x</Text></Box>
          <Box style={{ flex: 1, height: 62, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 20, color: '#E2E8F0', fontWeight: 'bold' }}>11x</Text></Box>
          <Box style={{ flex: 1, height: 62, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 20, color: '#E2E8F0', fontWeight: 'bold' }}>19x</Text></Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 6 }}>
          <Box style={{ width: 120, height: 62, justifyContent: 'center' }}><Text style={{ fontSize: 15, color: '#CBD5E1' }}>1 亿</Text></Box>
          <Box style={{ flex: 1, height: 62, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 20, color: '#E2E8F0', fontWeight: 'bold' }}>7.5x</Text></Box>
          <Box style={{ flex: 1, height: 62, borderRadius: 14, backgroundImage: 'linear-gradient(135deg, rgba(34,211,238,0.3) 0%, rgba(129,140,248,0.3) 100%)', border: '1px solid rgba(34,211,238,0.6)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 22, color: '#FFFFFF', fontWeight: 'bold' }}>22.5x</Text></Box>
          <Box style={{ flex: 1, height: 62, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 20, color: '#E2E8F0', fontWeight: 'bold' }}>38x</Text></Box>
