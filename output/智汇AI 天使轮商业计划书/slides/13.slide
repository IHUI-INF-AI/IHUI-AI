        </Box>
        <Box style={{ width: 468, height: 24, borderRadius: 14, background: 'rgba(255,255,255,0.10)' }}><Box style={{ width: 70, height: 24, borderRadius: 14, background: '#22D3EE' }} /></Box>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 6 }}>
