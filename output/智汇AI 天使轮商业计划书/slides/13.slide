          <Box style={{ flex: 1, height: 46, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#94A3B8', fontWeight: 'bold' }}>30x 中性</Text></Box>
          <Box style={{ flex: 1, height: 46, background: 'rgba(255,255,255,0.10)', border: '1px solid rgba(255,255,255,0.22)', boxShadow: '0 12px 36px rgba(0,0,0,0.55)', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 15, color: '#94A3B8', fontWeight: 'bold' }}>50x 行业锚</Text></Box>
