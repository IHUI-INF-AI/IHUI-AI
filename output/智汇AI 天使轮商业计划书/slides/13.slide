        </Box>
        <Box style={{ width: 468, height: 24, borderRadius: 14, background: 'rgba(255,255,255,0.10)' }}><Box style={{ width: 47, height: 24, borderRadius: 14, background: '#818CF8' }} /></Box>
      </Box>
      <Box style={{ flexDirection: 'row', justifyContent: 'space-between', borderTop: '2px solid rgba(34,211,238,0.5)', paddingTop: 14 }}>
        <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold' }}>年营收合计</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: 'transparent', backgroundImage: 'linear-gradient(135deg, #22D3EE 0%, #818CF8 100%)', backgroundClip: 'text' }}>≈ 1 亿</Text>
      </Box>
      <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5 }}>假设：80 万用户 × 10% 付费率 × 1,000 元/年；B 端 300 家。</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
      <Text style={{ fontSize: 22, color: '#FFFFFF', fontWeight: 'bold' }}>回报倍数矩阵（投 2,000 万 / 15%）</Text>
