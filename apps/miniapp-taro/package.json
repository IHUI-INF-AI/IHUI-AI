{
  "name": "@ihui/miniapp-taro",
  "version": "0.0.0",
  "private": true,
  "description": "IHUI-AI 小程序端 (Taro 4 + React + TypeScript + Tailwind)",
  "scripts": {
    "dev": "node scripts/dev-weapp.mjs",
    "dev:weapp": "node scripts/dev-weapp.mjs",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:weapp:clean": "rimraf dist-alipay && node scripts/dev-weapp.mjs",
    "dev:alipay:clean": "rimraf dist && taro build --type alipay --watch",
    "dev:swan": "taro build --type swan --watch",
    "dev:tt": "taro build --type tt --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "build:weapp:clean": "rimraf dist-alipay && taro build --type weapp",
    "build:alipay:clean": "rimraf dist && taro build --type alipay",
    "build:swan": "taro build --type swan",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "strip-wxss": "node scripts/strip-tailwind-backslash.mjs",
    "sync-tokens": "node scripts/sync-design-tokens.mjs",
    "sync-tokens:check": "node scripts/sync-design-tokens.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist dist-alipay .swc .turbo node_modules"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@ihui/api-client": "workspace:*",
    "@ihui/design-tokens": "workspace:*",
    "@ihui/i18n": "workspace:*",
    "@ihui/shared": "workspace:*",
    "@ihui/types": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-html": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@ihui/eslint-config": "workspace:*",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vite": "^4.5.5",
    "vitest": "^3.2.7",
    "weapp-tailwindcss": "5.2.9"
  }
}
