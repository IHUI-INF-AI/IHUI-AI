# [IHUI-AI-PROVENANCE]:⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠

NODE_ENV=development
PORT=8802
DATABASE_URL=postgresql://ihui:<your-dev-db-password>@localhost:8810/ihui
# 受控出口(dbScoped/dbReadScoped)专用非超级用户连接(O13)。
# 角色 + 逐表 GRANT 由迁移 20260921160000_scoped_app_role_owner_rls.sql 落;
# 留空 = 与 DATABASE_URL 同池,此时 scoped-* 能力会 fail-closed 到 503
# DATA_ISOLATION_UNAVAILABLE(超级用户绕过 RLS,闸门宁可拒绝也不假装隔离)。
# 口令不落仓:迁移建角色后在库上 `ALTER ROLE ihui_app PASSWORD '...'`。
DATABASE_APP_URL=
REDIS_URL=redis://localhost:8811
# 文件 CDN 域名(可选):上传返回 path 自动加前缀,生产可指向 file.aizhs.top(需 Nginx 反代 /uploads 到本服务)
FILE_CDN_BASE=
# 2026-07-24 安全审计:JWT_SECRET 强制必填,docker-compose 启动会校验非空(≥32 字符)
# 生成方式:openssl rand -hex 32(本地开发可用此占位符,生产必须替换为真实强密钥)
JWT_SECRET=<your-32-char-random-jwt-secret>

# OpenTelemetry 分布式追踪（R74 P2）
# 启用门控：配置 OTEL_EXPORTER_OTLP_ENDPOINT 即启用；OTEL_ENABLED=false 显式禁用
# 未配置时降级为 no-op，不阻塞启动
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8813
OTEL_SERVICE_NAME=@ihui/api
# 采样率：默认 10%（生产环境足够；traceidratio 采样器）
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ===== 邮件服务商 =====
# auto=按收件域名智能路由(国内→smtp,国外→resend);smtp/resend=强制指定
MAIL_PROVIDER=auto
# SMTP 兜底通道(SMTP_ENABLED=true 时启用)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aizhs.top
# Resend 通道(国外优先)
RESEND_API_KEY=
RESEND_FROM=
# 腾讯云通用凭据(TC3-HMAC-SHA256 签名):混元3D/混元对话/ai-service 视频生成直读
# 凭据获取:腾讯云控制台 → 访问管理(CAM) → API 密钥管理
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ============================================================================
# OAuth 网页扫码登录 (2026-07-21 增补)
# ----------------------------------------------------------------------------
# 未配置时相关平台的 is<Provider>Configured() 返回 false,API 返回 mock 响应
# 凭据获取详见各平台开发者后台:
#   - 微信开放平台:https://open.weixin.qq.com/ → 管理中心 → 网站应用
#   - 钉钉开发者后台:https://open-dev.dingtalk.com/ → 应用开发 → 企业内部开发
#   - 企业微信管理后台:https://work.weixin.qq.com/ → 我的企业 + 应用管理 → 自建应用
# ============================================================================

# 微信网站扫码登录(开放平台 - 网站应用)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 钉钉扫码登录(企业内部应用)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:8801/callback?platform=dingtalk

# 企业微信扫码登录(自建应用)
# WECOM_CORP_ID 来自 "我的企业 → 企业信息 → 企业 ID"
# WECOM_AGENT_ID / WECOM_SECRET 来自 "应用管理 → 自建应用 → 应用详情"
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=http://localhost:8801/callback?platform=enterpriseWechat

# 飞书扫码登录(自建应用)
# 凭据获取:https://open.feishu.cn → 开发者后台 → 应用详情 → 凭证与基础信息
# redirect_uri 在飞书后台 "安全设置 → 重定向 URL" 中配置,需与本处一致
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Coze OAuth(端点:apps/api/src/routes/coze-oauth.ts → /api/coze/oauth/*)
# 凭据获取:https://www.coze.cn → 开放平台 → 创建应用 → 生成密钥对
# JWT 主方案三键必填;CLIENT_ID/SECRET 供 /cozeZhsApi/agents/test/auth-config 显示配置状态
# COZE_PRIVATE_KEY 为 PEM 文本(建议双引号包裹并以 \n 转义换行)
COZE_OAUTH_APP_ID=
COZE_PUBLIC_KEY_ID=
COZE_PRIVATE_KEY=
COZE_OAUTH_CLIENT_ID=
COZE_OAUTH_CLIENT_SECRET=

# ============================================================================
# 4 个新社交登录 (OIDC + Discord + LinuxDO + Telegram,2026-07-31 增补)
# ----------------------------------------------------------------------------
# 补齐 New API 已有但 IHUI-AI 缺失的 4 种登录方式
# 未配置时对应 is<Provider>Configured() 返回 false,前端按钮点击后返回 400 错误
# 后端路由:apps/api/src/routes/auth-extended.ts 的 /auth/oauth/<provider>/* 端点
# Provider 实现:packages/auth/src/providers/{oidc,discord,telegram}.ts
# ============================================================================

# OIDC 通用企业 SSO(通过 .well-known/openid-configuration 自动发现 endpoints)
# issuer 示例:https://sso.example.com(无尾斜杠,需支持 OIDC Discovery)
# 凭据获取:企业 IdP 管理后台(如 Keycloak / Authentik / Okta / Azure AD)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8801/callback?platform=oidc

# Discord OAuth2
# 凭据获取:https://discord.com/developers/applications → 新建应用 → OAuth2
# redirect_uri 在 Discord 后台 "OAuth2 → Redirects" 中配置,需与本处一致
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8801/callback?platform=discord

# Telegram Bot 登录(非标准 OAuth2,走 Bot deeplink 模式)
# 流程:前端 POST /auth/oauth/telegram/start → 后端返回 deeplink → 用户在 Telegram 点击
#       Bot 收到 /start <authToken> → 写入用户信息 → 前端轮询 /auth/oauth/telegram/verify
# 凭据获取:https://t.me/BotFather → /newbot → 获取 Bot Token + Username
# ⚠️ Bot webhook 集成由主 agent 后续完成(接收 /start 命令回写用户信息)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ============================================================================
# GitHub API Token (2026-07-22 增补,AI 世界热度同步用)
# ----------------------------------------------------------------------------
# 用途:apps/api/src/jobs/ai-world-sync.ts 抓取 GitHub 仓库 stars/forks 元数据
# 未配置:GitHub API 限额 60 次/小时(共享 IP,易被限流)
# 已配置:限额提升到 5000 次/小时(稳定生产可用)
# 获取方式:https://github.com/settings/tokens → Fine-grained tokens
#   - Token type: Fine-grained
#   - Repository access: Public Repositories (read-only)
#   - Permissions: Contents: Read
#   - 有效期建议:90 天(到期前 7 天控制台提醒)
# ============================================================================
GITHUB_TOKEN=

# ============================================================================
# ElasticSearch 全文检索 (2026-07-21 增补,迁移自 edu service search-service)
# ----------------------------------------------------------------------------
# 未配置时 SearchEsService 自动降级到 PostgreSQL 全文检索(不影响功能)
# 启用步骤:
#   1. 部署 ElasticSearch 7.x+ (本地或远程)
#   2. 配置 ELASTICSEARCH_URL 指向 ES 服务地址
#   3. 可选: pnpm --filter @ihui/api add @elastic/elasticsearch
#      (未安装时 SearchEsService 用 dynamic import + try/catch 降级)
#   4. 调用 POST /api/search/reindex 触发全量索引(articles/news/resources/asks)
#   5. 调用 GET /api/search/status 查看索引状态
# ============================================================================
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_PREFIX=ihui

# ============================================================================
# Cloudflare Turnstile 人机验证 (P0-30, 2026-08-01 增补)
# ----------------------------------------------------------------------------
# 未配置时 captcha-service 的 turnstile 类型降级为 math 验证码
# 凭据获取:https://dash.cloudflare.com → Turnstile → 新建站点 → Secret Key
# 测试用 secret key(始终通过):1x0000000000000000000000000000000AA
# 与 apps/web/.env.example 的 NEXT_PUBLIC_TURNSTILE_SITE_KEY 配套使用
# ============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠

# SSO deep-link scheme 白名单(逗号分隔;mobile-rn/desktop 用 ihui://,miniapp-taro 用 ihui-miniapp://)
SSO_ALLOWED_DEEP_LINK_SCHEMES=ihui,ihui-miniapp

# ============================================================================
# Agnes AI 文生图 (2026-09-20 增补,/api/ai/agnes/image 代理端点)
# ----------------------------------------------------------------------------
# Key 获取:https://platform.agnes-ai.com/settings/apiKeys
# 模型:agnes-image-2.5-flash(最新,默认)/ agnes-image-2.1-flash(2026-10-10 实测仅存这 2 个,前端可切换)
# 与 apps/ai-service/.env 的 AGNES_API_KEY 保持一致(mcp_server 生图工具同用)
# 2026-10-10:境外 apihub.agnes-ai.com 不可达,base 改国内域名(A/B 实测新key 200/401)
# ============================================================================
AGNES_API_KEY=
AGNES_API_BASE=https://api.agnes-ai.cn/v1

# ============================================================================
# 内部服务鉴权通道(2026-10-06 立,internal-service-ticket)
# ----------------------------------------------------------------------------
# AI_CALLBACK_SECRET = 老通道那把**常驻、无 TTL、可无限重放**的共享密钥。
# 票档(ai-service 侧 mint_internal_service_ticket / internal_service_headers)用一次性短期票
# 取代它:验票侧封顶 TTL、jti 单次使用(Redis SET…NX 登记)、aud/type/scope 三重隔离、跨用途拒收。
# 留空 = 老通道不可用(未配置时一律 401,fail-closed)。
# ============================================================================
AI_CALLBACK_SECRET=

# 通道档位:
#   dual   (默认)两档并存 —— 兼容窗口,老门仍认
#   ticket 只认票,老门彻底关掉(ai-service 侧改完发票后再切这一档)
#   legacy 只认老门(应急回退用;保的是"能进",不是"安全")
# 未知值落回 dual:档位名拼错不该静默把门关掉。
INTERNAL_SERVICE_AUTH_MODE=dual

# 票的 TTL 上限(秒)。**由验票侧封顶**:发票方误配大值时"短期"这个前提必须还成立。
# 内部服务调用是同步 HTTP,秒级足够;再长就不再是"一次性票"而是缓存。
INTERNAL_SERVICE_TICKET_MAX_TTL_SECONDS=300

# ============================================================================
# d1jiema 接码平台 API Token (2026-10-08 增补,管理员短信接码 /admin/sms-receive)
# ----------------------------------------------------------------------------
# 创建:https://www.d1jiema.com/appweb/signIn.html 登录 → 个人中心 → API对接中心 → 创建 API Token
# 留空 = 未配置,/api/admin/sms-receive/* 端点返回明确错误提示,不影响启动
# 文档:https://www.d1jiema.com/api.html(频率计费:每 1000 次请求扣 0.01~0.2 元)
# ============================================================================
D1JIEMA_TOKEN=

# ============================================================================
# 阿里云短信 —— 验证码发送出口 (2026-10-22 登记;此前这四个键只存在于本机 .env,
# 新环境照 .env.example 配不出来,而发码端点在缺凭据时是静默降级不是报错)
# ----------------------------------------------------------------------------
# 控制台:签名 https://dysms.console.aliyun.com/dysms/signmanage / 模板 .../template
# AK 创建:RAM 访问控制 → 用户 → 创建 AccessKey,并挂 AliyunDysmsFullAccess
# 机器级判据:node scripts/env-backfill-model-keys.mjs 同族做法,权威来源在网盘密钥库
#
# 缺 ALI_SMS_ACCESS_KEY_ID/SECRET 时:生产档发码判失败(回 502),开发档降级为日志。
# 账户欠费停机(SendSms 回 isv.OUT_OF_SERVICE)同样判失败 —— 不会记成"已发送"。
# ============================================================================
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
# 签名必须与控制台「已过审」的签名名字逐字一致,差一个字 isv.SMS_SIGNATURE_ILLEGAL
ALI_SMS_SIGN_NAME=
# 主模板:场景专用键未配时回落到它。模板变量占位符必须是 ${code}
ALI_SMS_TEMPLATE_CODE=
# 按场景分模板(sendCodeSchema.scene 闭集:register / login / reset / phone-binding)
ALI_SMS_TEMPLATE_CODE_LOGIN=
ALI_SMS_TEMPLATE_CODE_REGISTER=
ALI_SMS_TEMPLATE_CODE_RESET=
ALI_SMS_TEMPLATE_CODE_PHONE_BINDING=
# 通知类与催缴类各需独立结构化模板(与验证码的 {code} 占位符不共用,共用必被云侧拒发)
ALI_SMS_NOTIFY_TEMPLATE_CODE=
ALI_SMS_ARREAR_TEMPLATE_CODE=
# 不用阿里云时可改走自建短信代理(优先级低于阿里云)
SMS_API_BASE_URL=
SMS_VERIFY_ENDPOINT=

# ============================================================================
# 腾讯云短信 —— 第二通道 (2026-10-22 接入)
# ----------------------------------------------------------------------------
# 定位:不是替换阿里云,是并行留一条腿。腾讯云国内短信单价 0.040~0.047 元/条
# (阿里云 0.045 起),企业认证主体首次开通赠送 500 条 / 个人 100 条,3 个月有效。
#
# 控制台:应用与签名模板 https://console.cloud.tencent.com/smsv2
#   应用管理 → 创建应用 → 拿 SmsSdkAppId(注意 API 字段名是 SmsSdkAppId,不是 SdkAppId)
#   国内短信 → 签名管理 / 正文模板管理
# SecretId/SecretKey 权威来源 = 网盘密钥库「腾讯云SecretKey.csv」
#
# ⚠️ 现实前置:腾讯云国内短信要先过 实名资质报备(约 2 小时)+ 运营商签名报备
#    (**7~10 个工作日**)。签名类型只认 公司/App/商标/政府机构 —— 网站、公众号、
#    小程序已不支持,网上老教程失效。所以本通道在报审完成前必然处于未配置态,
#    代码会如实回 not_configured,不会记成"已发送"。
#
# 通道优先级由 SMS_PROVIDER 决定:
#   auto(缺省)= 阿里云 → 自建代理,与历史行为一字不差
#   tencent   = 腾讯云 → 阿里云 → 自建代理(腾讯云没配齐自动落回,不会停在等审批)
#   aliyun    = 阿里云 → 自建代理
#   proxy     = 只走自建代理
# ============================================================================
SMS_PROVIDER=auto
# 没配任何通道时,发码接口默认**响亮失败**(502),而不是把验证码打印到控制台后回 sent:true。
# 2026-10-22 实测改判:线上那台生产机的 NODE_ENV 是 development,旧写法靠 NODE_ENV 猜档位,
# 于是"三档通道全未配置"被读成"开发态可以假发" ⇒ 接口恒回 sent:true 而一条短信都没出。
# 现在要拿回显码必须显式开这一枚旗标(本地调试用),缺省一律 fail-closed。
SMS_DEV_ECHO=0
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
# 控制台「应用管理」创建应用后生成的数字 ID,国内号码发送时必须带 +86 前缀(代码已自动补)
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
# 签名 ID(控制台「签名管理」列表里的数字)。仅用于后台运营页查询签名审核状态;
# 留空 = 运营页显示"未登记签名 ID",不影响发送。
TENCENT_SMS_SIGN_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 主模板 ID;场景专用键未配时回落到它
TENCENT_SMS_TEMPLATE_CODE=
TENCENT_SMS_TEMPLATE_CODE_LOGIN=
TENCENT_SMS_TEMPLATE_CODE_REGISTER=
TENCENT_SMS_TEMPLATE_CODE_RESET=
TENCENT_SMS_TEMPLATE_CODE_PHONE_BINDING=
# 服务端回调鉴权(2026-10-26 立的三枚回调端点 /api/sms/callback/tencent{,/status,/reply})。
# 两枚都不配 ⇒ 端点恒定 503(代码 fail-closed,不是 bug):腾讯把 503 当可重试,配好后回执会补上来。
# 不配就放行等于任何人都能替全站用户退订、或把失败回执改成送达。
# 只配 token = 校验 `?key=` 或 `x-sms-callback-token` 头(定长比较);只配 IP 白名单 = 校验来源 IP;
# 两道都配则都要过。白名单要用腾讯短信回调的出口网段(控制台「回调配置」页公布),逗号分隔。
# 值属凭据面,权威来源 = 网盘密钥库,不落仓、不进聊天记录。
SMS_CALLBACK_TOKEN=
SMS_CALLBACK_IP_ALLOWLIST=
