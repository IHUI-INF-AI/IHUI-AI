{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智汇助手",
  "version": "0.1.0",
  "identifier": "com.ihui.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/prepare-dev.mjs && pnpm dev",
    "beforeBuildCommand": "pnpm release:prepare && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智汇助手",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/python/": "python/",
      "../src-ps/": "ps/",
      "../resources/browser/": "browser/"
    },
    "shortDescription": "智汇助手 · 多账号签到与管理",
    "longDescription": "整合多账号签到、登录态切换、设备隔离与账号分组的 Windows 桌面端工具（基于 MIT 开源项目 Trae-workbuddyAssistant 整合）。",
    "publisher": "IHUI AI (智汇AI)",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ]
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  },
  "plugins": {}
}
