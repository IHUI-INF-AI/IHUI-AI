{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IHUI AI 默认能力(main + admin 窗口共用,admin 为 lazy create)。2026-09-16 桌面端薄壳化:窗口加载 https://aizhs.top 线上前端,remote 授权使线上页面获得 IPC(托盘/更新器/深链等)。",
  "windows": ["main", "admin"],
  "remote": {
    "urls": ["https://aizhs.top/*", "https://www.aizhs.top/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "deep-link:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "autostart:default",
    "global-shortcut:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "notification:default",
    "os:default",
    "store:default",
    "updater:default",
    "log:default",
    {
      "identifier": "shell:allow-open",
      "description": "仅允许打开 http/https 外部 URL(SSO 等),禁止 file:/自定义协议",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-get-app-info",
    "allow-git-authorize-workspace",
    "allow-git-workspace-status",
    "allow-git-channel-info",
    "allow-open-in-chrome",
    "allow-get-admin-window-info",
    "allow-toggle-devtools",
    "allow-quit-app",
    "allow-restart-app",
    "allow-open-admin-window",
    "allow-start-resize",
    "allow-toggle-fullscreen",
    "allow-toggle-always-on-top",
    "allow-screenshot-screen",
    "allow-mouse-move",
    "allow-mouse-click",
    "allow-keyboard-type",
    "allow-mouse-scroll",
    "allow-keyboard-press",
    "allow-keyboard-hotkey",
    "allow-active-window",
    "allow-clipboard-get",
    "allow-clipboard-set",
    "allow-read-text-file",
    "allow-read-binary-file",
    "allow-write-text-file",
    "allow-list-dir",
    "allow-stat-file",
    "allow-save-window-state",
    "allow-restore-window-state",
    "allow-reset-window-state",
    "allow-clear-webview-cache",
    "allow-set-tray-status",
    "allow-get-tray-always-visible",
    "allow-set-tray-always-visible",
    "allow-get-desktop-prefs",
    "allow-set-desktop-prefs",
    "allow-resolve-close-choice",
    "allow-set-desktop-badge",
    "allow-take-pending-deep-links",
    "allow-checkin-detect-trae-dir",
    "allow-checkin-capture-jwts",
    "allow-checkin-reset-device-ids",
    "allow-checkin-get-public-ip",
    "allow-checkin-one-click-reset",
    "allow-checkin-audit-trae-residual",
    "allow-checkin-snapshot-backup",
    "allow-checkin-snapshot-restore",
    "allow-checkin-snapshot-list",
    "allow-checkin-snapshot-delete",
    "allow-qoder-reset-probe",
    "allow-qoder-reset-plan",
    "allow-qoder-reset-maintenance",
    "allow-qoder-reset-logout",
    "allow-qoder-reset-factory",
    "allow-qoder-quarantine-list",
    "allow-qoder-quarantine-restore",
    "allow-qoder-quarantine-delete",
    "allow-qoder-reset-history",
    "allow-workbuddy-reset-probe",
    "allow-workbuddy-reset-maintenance",
    "allow-workbuddy-reset-logout",
    "allow-workbuddy-reset-plan",
    "allow-workbuddy-quarantine-list",
    "allow-workbuddy-quarantine-restore",
    "allow-workbuddy-quarantine-delete",
    "allow-workbuddy-reset-history",
    "allow-workbuddy-reset-factory"
  ]
}
