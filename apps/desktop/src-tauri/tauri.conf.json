{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智汇AI",
  "version": "0.1.33",
  "identifier": "com.ihui.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ihui/web dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8801",
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "智汇AI",
        "url": "https://aizhs.top/agents",
        "width": 1800,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "maximized": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#242424",
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://aizhs.top/desktop-feed.json",
        "https://github.com/IHUI-INF-AI/IHUI-AI/releases/download/desktop-updater-feed/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1RDdFNjdFQTJCMURCMDgKUldRSTI3R2lmdWJYdFJuYXhoQ1pQekNOcUNKOUplWWQ1QVJPK25OakFrL2NmS0ZrREZDbThwbEUK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["ihui"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "智汇AI",
    "longDescription": "智汇AI 多端平台客户端,基于 Tauri 2 + WebView2",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsi",
        "compression": "none"
      }
    }
  }
}
