<?xml version="1.0" encoding="UTF-8"?>
<!-- 智汇AI (IHUI AI) — MSI (WiX) 安装器片段
     作用(启用 MSI 时):把 Tauri 生成的 .msi 默认安装目录固定到 D:\IHUI AI,
     替代默认的 %ProgramFiles%\智汇AI。
     实现:通过 <SetDirectory> 重设 Tauri 主模板(main.wxs)中 INSTALLDIR 的目标路径。
     Sequence 采用默认值 'both':在 InstallUISequence(预填安装向导目录)与
     InstallExecuteSequence(决定实际安装位置)中都会生效。

     ⚠️ 当前状态:bundle.targets 不含 msi,且 tauri.conf.json 未声明
     bundle.windows.wix.fragmentPaths —— 本片段**尚未被任何构建引用**,属预留配置。
     若将来启用 MSI,需先在 tauri.conf.json 的 bundle.windows.wix.fragmentPaths 中引用本文件,
     再对齐 NSIS 的"语言化目录"行为(MSI 侧目前固定英文名 D:\IHUI AI)。 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <SetDirectory Id="INSTALLDIR" Value="D:\IHUI AI" />
  </Fragment>
</Wix>
