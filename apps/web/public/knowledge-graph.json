    {
      "@id": "https://aizhs.top/#faq",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is IHUI AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IHUI AI (Chinese: 智汇 AI) is a one-stop full-stack AI operating system. It unifies Agent design, knowledge-base RAG, multi-model orchestration, cross-platform distribution, team collaboration, and credit-based billing into a single open platform."
          }
        },
        {
          "@type": "Question",
          "name": "Is IHUI AI open source?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, IHUI AI is licensed under Apache License 2.0, fully open source with no commercial restrictions. Code is available at https://github.com/ihui-ai"
          }
        },
        {
          "@type": "Question",
          "name": "Does IHUI AI support private deployment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, IHUI AI supports Docker Compose single-node deployment and Kubernetes cluster deployment, with full private deployment documentation."
          }
        },
        {
          "@type": "Question",
          "name": "Which AI models does IHUI AI support?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IHUI AI supports 30+ AI models including OpenAI GPT-4o, Claude 3.5, Google Gemini, Alibaba Qwen, DeepSeek, Zhipu GLM, Baidu ERNIE, Moonshot Kimi, Tencent Hunyuan, ByteDance Doubao, Meta LLaMA, Mistral, and local models via Ollama/LM Studio/vLLM."
          }
        },
        {
          "@type": "Question",
          "name": "Does IHUI AI support MCP protocol?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, IHUI AI natively supports Model Context Protocol (MCP) with 100+ pre-built MCP tools and custom MCP tool development capability."
          }
        },
        {
          "@type": "Question",
          "name": "What platforms does IHUI AI support?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IHUI AI provides 6 native clients: Web, Desktop (Windows/macOS/Linux), WeChat Mini-Program, Browser Extension (Chrome/Edge), React Native (iOS/Android), and CLI."
          }
        },
        {
          "@type": "Question",
          "name": "What is IHUI AI pricing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IHUI AI has 3 tiers: Community Edition (free, Apache 2.0, self-hosted), Pro Edition (¥49/user/month, cloud-hosted), Enterprise Edition (¥300,000/year, self-hosted with SLA)."
          }
        }
      ]
