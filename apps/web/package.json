{
  "name": "@ihui/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/deploy-lock.mjs acquire --mode dev",
    "postinstall": "node scripts/copy-monaco-to-public.mjs",
    "dev": "next dev --turbopack -p 8801",
    "dev:clean": "rimraf .next .dev.lock && node ../../scripts/deploy-lock.mjs acquire --mode dev && next dev --turbopack -p 8801",
    "dev:stable": "rimraf .next .dev.lock && node ../../scripts/deploy-lock.mjs acquire --mode dev && next dev -p 8801",
    "prebuild": "node ../../scripts/deploy-lock.mjs acquire --mode build --timeout 600000 --stale 600000",
    "build": "node --max-old-space-size=8192 node_modules/next/dist/bin/next build --webpack",
    "build:analyze": "pnpm exec next experimental-analyze",
    "start": "next start -p 8801",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "node scripts/clean-vite-temp.mjs && vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "clean": "rimraf .next .turbo node_modules",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:static": "node scripts/build-static.mjs",
    "test:clean": "node scripts/clean-vite-temp.mjs",
    "test:watch": "node scripts/clean-vite-temp.mjs && vitest"
  },
