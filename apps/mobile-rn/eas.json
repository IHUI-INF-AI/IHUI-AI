{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "WX_APP_APPID": "wx85fa429a9331b5c8",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.aizhs.top",
        "EXPO_PUBLIC_WS_BASE_URL": "https://api.aizhs.top",
        "EXPO_PUBLIC_WEB_URL": "https://aizhs.top",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "WX_APP_APPID": "wx85fa429a9331b5c8",
        "EXPO_PUBLIC_API_BASE_URL": "https://www.aizhs.top",
        "EXPO_PUBLIC_WS_BASE_URL": "https://api.aizhs.top",
        "EXPO_PUBLIC_WEB_URL": "https://aizhs.top",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
