# Expo prebuild 生成的原生目录(EAS Build 时重新生成)
/android
/ios

# Android 正式签名密钥(绝不入库)
/credentials
# EAS Build 需要上传 service account key 用于 Play 提交
!credentials/google-play-service-account.json
# EAS 本地签名需读取 release.keystore
!credentials/release.keystore
# credentials.json 含密码，不入库(由 CI base64 注入或本地生成)
/credentials.json
# Expo
/.expo
*.tsbuildinfo

# macOS
.DS_Store

# IDE
.idea
.vscode
