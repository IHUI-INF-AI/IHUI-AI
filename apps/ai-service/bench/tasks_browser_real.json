  {
    "id": "real-hackernews-home",
    "title": "真实站点:Hacker News 首页导航",
    "category": "real-site",
    "steps": [
      {
        "action": "navigate",
        "params": { "url": "https://news.ycombinator.com/", "timeout_ms": 30000 },
        "expect": { "type": "title_contains", "value": "Hacker News" }
      }
    ],
    "checks": [{ "type": "selector_exists", "params": { "selector": "#hnmain" } }]
  },
  {
    "id": "real-hn-login-form",
    "title": "真实站点:Hacker News 登录表单操作(填写+提交+错误回执断言)",
    "category": "real-site",
    "steps": [
      {
        "action": "navigate",
        "params": { "url": "https://news.ycombinator.com/login", "timeout_ms": 30000 }
      },
      {
        "action": "type",
        "target": { "selector": "input[name='acct']" },
        "params": { "text": "ihui-browser-bench-probe", "clear": true }
      },
      {
        "action": "type",
        "target": { "selector": "input[name='pw']" },
        "params": { "text": "bench-probe-no-such-account", "clear": true }
      },
      { "action": "click", "target": { "selector": "input[type='submit']" } }
    ],
    "checks": [{ "type": "url_contains", "params": { "text": "news.ycombinator.com" } }]
  },
  {
    "id": "real-bing-results",
    "title": "真实站点:必应搜索结果页导航",
    "category": "real-site",
    "steps": [
      {
        "action": "navigate",
        "params": { "url": "https://www.bing.com/search?q=IHUI+AI", "timeout_ms": 30000 }
      }
    ],
    "checks": [{ "type": "selector_exists", "params": { "selector": "#b_results" } }]
  },
  {
    "id": "real-github-login-form",
    "title": "真实站点:GitHub 登录表单操作(填写+提交+错误回执断言)",
    "category": "real-site",
    "steps": [
      {
        "action": "navigate",
        "params": { "url": "https://github.com/login", "timeout_ms": 30000 },
        "expect": { "type": "url_contains", "value": "login" }
      },
      {
        "action": "type",
        "target": { "selector": "#login_field" },
        "params": { "text": "ihui-browser-bench-probe", "clear": true }
      },
      {
        "action": "type",
        "target": { "selector": "#password" },
        "params": { "text": "bench-probe-no-such-account", "clear": true }
      },
      { "action": "click", "target": { "selector": "input[name='commit']" } }
    ],
    "checks": [
      { "type": "selector_text_contains", "params": { "selector": "body", "text": "Incorrect" } }
    ]
  },
  {
    "id": "real-mdn-docs",
