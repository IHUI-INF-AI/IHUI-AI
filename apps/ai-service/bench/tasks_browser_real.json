[
  {
    "id": "real-example-navigate",
    "title": "真实站点:example.com 导航与标题断言",
    "category": "real-site",
    "steps": [
      {
        "action": "navigate",
        "params": { "url": "https://example.com/", "timeout_ms": 25000 },
        "expect": { "type": "title_contains", "value": "Example Domain" }
      }
    ],
    "checks": [
      { "type": "url_contains", "params": { "text": "example.com" } },
      { "type": "selector_text_contains", "params": { "selector": "h1", "text": "Example Domain" } }
    ]
  },
  {
