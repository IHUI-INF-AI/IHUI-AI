NODE_ENV=development
PORT=8803
HOST=0.0.0.0
LOG_LEVEL=info
# CORS 允许源(逗号分隔,必填)
# 生产环境(NODE_ENV=production)空值将导致启动失败;任何环境禁止使用 "*"
# 本地开发默认:http://localhost:8801
CORS_ORIGIN=http://localhost:8801

DATABASE_URL=postgresql://ihui:<your-dev-db-password>@localhost:8810/ihui
REDIS_URL=redis://localhost:8811

# ============================================================================
# LLM_PROVIDERS — 字典化配置(2026-07-26 阶段 3 主体,唯一配置源)
# ============================================================================
# 阶段 3 主体已删除所有扁平字段(openai_api_key / anthropic_api_key / stepfun_api_key
# 等),所有 LLM provider 配置必须通过此 JSON 字符串提供。
#
# JSON 格式: {"<provider_name>": {"api_key": "...", "api_base": "...", "enabled": true, "models": [...], "default_model": "..."}, ...}
# - api_key:    字符串,空字符串允许(降级 stub 模式)
# - api_base:   字符串或 null,null 表示用 litellm 默认 URL
# - enabled:    布尔值(禁止 "true" 字符串),默认 true
# - models:     字符串数组,可选(模型列表)
# - default_model: 字符串或 null,可选(默认模型)
#
# 支持的 31 个 provider name(阶段 3 主体白名单):
#   openai / anthropic / gemini / groq / openrouter
#   agnes / stepfun(用户 plan 套餐)
#   cloudflare / nvidia / github / vercel / opencode
#   modal / inference_net / nlp_cloud / scaleway / alibaba_intl
#   cerebras / mistral / cohere / huggingface / zai
#   kilo / pollinations / llm7 / ovh / aihorde
#   reka / routeway / bazaarlink / ainative
#
# 迁移扁平字段到 JSON 格式:
#   node scripts/migrate-llm-providers.mjs --input apps/ai-service/.env --output apps/ai-service/.env.migrated --apply --backup --strip-flat
#   # 然后用 .env.migrated 替换原 .env
#
# 守门脚本校验(必须 exit 0):
#   node scripts/check-llm-provider-schema.mjs --env-file apps/ai-service/.env
#
# 示例(留空 = 不启用,所有 provider 降级 stub 模式):
# LLM_PROVIDERS={"openai":{"api_key":"sk-...","api_base":"https://api.openai.com/v1"},"agnes":{"api_key":"sk-...","api_base":"https://apihub.agnes-ai.com/v1"},"stepfun":{"api_key":"sk-...","api_base":"https://api.stepfun.com/step_plan/v1"}}
LLM_PROVIDERS=

# 模型名(前缀决定 provider,默认 StepFun)
LITELLM_MODEL=stepfun/step-3.7-flash

# 后端 API 地址(ai-service 回调 apps/api 用,本地开发端口 8802)
API_SERVICE_URL=http://localhost:8802

# AI 回调共享密钥(必填,与后端 AI_CALLBACK_SECRET 一致)
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 配置后回调 /api/ai/callback 时携带 X-Internal-Secret 头;为空则不发送
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
AI_CALLBACK_SECRET=<your-32-char-random-secret>

# ============================================================================
# mTLS 双向证书认证(2026-07-24 立,打通 api ↔ ai-service 链路)
# ============================================================================
# MTLS_ENABLED=true 时,ai-service 调用 apps/api 必须携带客户端证书 + 校验服务端证书
# MTLS_ENABLED=false(默认)→ 降级模式,httpx 正常无证书请求(仅开发环境)
# 生产环境必填,且证书文件必须存在(否则启动 fail-fast)
# 证书默认路径指向 apps/api/certs/mtls/(与服务端 mtls.ts 共享同一套证书)
# 生成方式:参考 apps/api/certs/mtls/README 或 scripts/gen-mtls-certs.sh
MTLS_ENABLED=false
MTLS_CLIENT_CERT_PATH=apps/api/certs/mtls/client.crt
MTLS_CLIENT_KEY_PATH=apps/api/certs/mtls/client.key
MTLS_CA_CERT_PATH=apps/api/certs/mtls/ca.crt

# 火山引擎实时语音(可选)
VOLC_APP_ID=
VOLC_ACCESS_KEY=
VOLC_APP_KEY=

# ============================================================================
# CSDN 自动发布凭证(可选,仅 content_engine skill 使用)
# ============================================================================
# 逆向自 editor.csdn.net 内部 API 的签名凭证;空值=未配置,签名会失败
# 用途:lib/csdn_publish.py 用 x-ca-key + HMAC-SHA256 签名调 CSDN 内部接口
# 留空时该 skill 不可用,不影响 ai-service 主流程
CSDN_APP_KEY=
CSDN_APP_SECRET=
# Cookie 获取方法:浏览器登录 CSDN → F12 → Network → 任意请求 → 复制 Cookie 头
CSDN_COOKIE=

# 凭据加密密钥(必填,与 apps/api 的 CREDENTIALS_ENCRYPTION_KEY 共享)
# 用于解密 ai_model_config 表中的 api_key_enc 字段;至少 32 字符
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
CREDENTIALS_ENCRYPTION_KEY=<your-32-char-random-encryption-key>

# OpenTelemetry 分布式追踪（R74 P2）
# 启用门控：配置 OTEL_EXPORTER_OTLP_ENDPOINT 即启用；OTEL_ENABLED=false 显式禁用
# 未配置时降级为 no-op，不阻塞启动
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8813
OTEL_SERVICE_NAME=@ihui/ai-service
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ============================================================================
# 本地 LLM 服务(LiteLLM 原生,2026-07-27 统一 secret 管理)
# ============================================================================
# _resolve_provider 中 ollama/lmstudio/llamacpp/azure/bedrock 前缀走这些字段
# 默认值与 LiteLLM 库内部约定一致;用户在 .env 覆盖即激活对应 provider
# 全部留空 = 不启用本地 LLM,降级 stub 模式或走 LLM_PROVIDERS 配置的 provider

# Ollama(本地,默认 http://localhost:11434,无需 api_key 即可用)
OLLAMA_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
# LM Studio(本地,默认 http://localhost:1234)
LMSTUDIO_API_KEY=
LMSTUDIO_API_BASE=http://localhost:1234
# llama.cpp(本地,默认 http://localhost:8080,无 api_key)
LLAMACPP_API_BASE=http://localhost:8080
# Azure OpenAI(LiteLLM 原生,需配合 AZURE_API_VERSION 等环境变量)
AZURE_API_KEY=
AZURE_API_BASE=
# AWS Bedrock(LiteLLM 原生,需配合 AWS_SECRET_ACCESS_KEY / AWS_REGION_NAME 等)
AWS_ACCESS_KEY_ID=

# ============================================================================
# MCP / Publish 工具配置(2026-07-27 统一 secret 管理)
# ============================================================================
# MCP_WORKSPACE_ROOTS:MCP read_file/write_file 工作区根目录白名单
#   分隔符 os.pathsep(Windows 是 ";" Unix 是 ":"),空=用当前工作目录
MCP_WORKSPACE_ROOTS=
# PUBLISH_UPLOAD_DIR:多平台发布上传根目录,空=默认 .uploads/publish(已在 .gitignore)
PUBLISH_UPLOAD_DIR=
# GITHUB_TOKEN:MCP review_pr 工具调 GitHub API
#   空=匿名调用受 rate limit(60/h);配置后 5000/h
#   生成方式:GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# ============================================================================
# LLM 出站代理(2026-07-30 立,商业化上线运营刚需)
# ============================================================================
# 国内服务器访问 OpenAI/Anthropic/OpenRouter 等境外 provider 时必须走代理
# 配置后自动写入 os.environ[HTTP_PROXY/HTTPS_PROXY],litellm/httpx 自动读取
# 格式:http://user:pass@host:port 或 http://host:port  空字符串=不使用代理
LLM_PROXY_URL=

# ============================================================================
# Token 压缩(2026-07-30 立,P2-A TokenCompactor 配套,对标并超越 OmniRoute 89%)
# ============================================================================
# 启用后 llm_gateway.complete/astream 在 trim_messages 后、litellm.acompletion 前
# 自动调用 RTK+Caveman 双算法压缩(策略=rtk_caveman,keep_recent=6)。
# 启用条件:① TOKEN_COMPACTION_ENABLED=true ② 非 stub 模式 ③ 不含 tools 参数
#   ④ 总 token 数 > TOKEN_COMPACTION_MIN_TOKENS
# 压缩失败降级用原 messages(不阻塞主流程),压缩率记录到 LLM_TOKEN_COMPACTION_RATIO metric
# 默认 false:对消息结构敏感的场景(如 function calling)保守不启用,需手动开启
TOKEN_COMPACTION_ENABLED=false
TOKEN_COMPACTION_MIN_TOKENS=2000

# ============================================================================
# Combo 多级 fallback 链(2026-07-30 立,P0-1 ComboRouter 配套,对标 OmniRoute Combo)
# ============================================================================
# JSON 字符串,格式:{"<combo_name>": {"strategy": "priority|cheapest|fusion",
#   "chain": ["model1", "model2", ...], "judge": "model"(fusion 可选),
#   "judge_mode": "merge|vote"(fusion 可选), "max_concurrency": int(fusion 可选)}, ...}
# 主 provider + FallbackRouter 单层 fallback 全部失败后,若 primary 在某 combo 链中,
# 自动触发 ComboRouter 按策略选择下一个 provider(429 自动 cooldown 指数退避)。
# 空=不启用 Combo fallback(主链路 + 单层 FallbackRouter 仍可用)
#
# 推荐 maximize-free 链(免费 provider 优先,符合"不想花一分钱"约束):
# COMBO_CHAINS={"maximize-free":{"strategy":"priority","chain":["stepfun/step-3.7-flash","agnes/agnes-2.5-flash","openrouter/qwen/qwen3-235b-a22b:free"]}}
COMBO_CHAINS=
