NODE_ENV=development
PORT=8803
HOST=0.0.0.0
LOG_LEVEL=info
# CORS 允许源(逗号分隔,必填)
# 生产环境(NODE_ENV=production)空值将导致启动失败;任何环境禁止使用 "*"
# 本地开发默认:http://localhost:8801
CORS_ORIGIN=http://localhost:8801

DATABASE_URL=postgresql://ihui:<your-dev-db-password>@localhost:8810/ihui
REDIS_URL=redis://localhost:8811

# LLM 密钥(用户 plan 套餐优先,免费 provider 备选)
# 任选一个 provider 配置即可激活真实调用,全部为空降级 stub 模式

# 用户 plan 套餐(复制此文件为 .env 后填入真实 key)
STEPFUN_API_KEY=<your-stepfun-api-key>  # 申请: https://api.stepfun.com/step_plan/v1
STEPFUN_API_BASE=https://api.stepfun.com/step_plan/v1
AGNES_API_KEY=<your-agnes-api-key>  # 申请: https://apihub.agnes-ai.com/v1
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# 免费 provider(备选,需自行注册 key)
GROQ_API_KEY=  # 免费 https://console.groq.com/keys
GEMINI_API_KEY=  # 免费 https://aistudio.google.com/apikey
OPENROUTER_API_KEY=  # 有 free tier https://openrouter.ai/keys

# 免费 / 试用 credits provider(2026-07-22 接入,参考 cheahjs/free-llm-api-resources)
# Cloudflare Workers AI(10,000 neurons/day 免费)
CLOUDFLARE_API_TOKEN=  # https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=  # https://dash.cloudflare.com/ 右侧 Account ID
# NVIDIA NIM(40 req/min 免费)
NVIDIA_API_KEY=  # https://build.nvidia.com/explore/discover
# GitHub Models(Copilot Free tier 可用)
GITHUB_TOKEN=  # https://github.com/settings/tokens
# Vercel AI Gateway($5/月免费额度)
VERCEL_AI_GATEWAY_KEY=  # https://vercel.com/docs/ai-gateway
# OpenCode Zen(完全免费)
# 示例 key(可能已失效,请自行注册): sk-GyX66j2M7ohdzry8z1MVGZxwbzn5SkbWVBYFCw8qiEnb5We64Kt0n5xpek6R3z6l
OPENCODE_ZEN_KEY=  # https://opencode.ai/docs/zen/
# Modal($5/月注册赠送)
MODAL_API_KEY=  # https://modal.com/settings/tokens
# Inference.net($1 注册送 + 回邮件调查 +$25)
INFERENCE_NET_API_KEY=  # https://inference.net
# NLP Cloud($15 注册送)
NLP_CLOUD_API_KEY=  # https://nlpcloud.com/home
# Scaleway(1M tokens 免费)
SCALEWAY_API_KEY=  # https://console.scaleway.com/generative-api/models
# Alibaba Cloud International Model Studio(1M tokens/模型免费)
ALIBABA_INTL_API_KEY=  # https://bailian.console.alibabacloud.com/

# 14 个免费 LLM provider 内化(2026-07-24,OpenAI 兼容,前缀路由)
# Cerebras(Qwen3 235B 免费)
CEREBRAS_API_KEY=  # https://cloud.cerebras.ai/
# Mistral(Large 3 / Codestral / Devstral)
MISTRAL_API_KEY=  # https://console.mistral.ai/api-keys/
# Cohere(Command R+ / Command-A)
COHERE_API_KEY=  # https://dashboard.cohere.com/api-keys
# HuggingFace Inference Router(DeepSeek/Kimi/Qwen3)
HUGGINGFACE_API_KEY=  # https://huggingface.co/settings/tokens
# Z.ai / 智谱 OpenAI 兼容端点(GLM-4.5 / GLM-4.7 Flash)
ZAI_API_KEY=  # https://z.ai/ 或 https://open.bigmodel.cn/
# Kilo Gateway(匿名 keyless,:free 路由,有 base 即激活)
KILO_API_BASE=https://api.kilo.ai/api/gateway/v1
# Pollinations(匿名 keyless,GPT-OSS 20B,有 base 即激活)
POLLINATIONS_API_BASE=https://text.pollinations.ai/openai/v1
# LLM7.io(匿名可用,配 key 提升 100 req/hr)
LLM7_API_KEY=  # 可选,https://llm7.io/
LLM7_API_BASE=https://api.llm7.io/v1
# OVH AI Endpoints(匿名 keyless,2 req/min,有 base 即激活)
OVH_API_BASE=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# AI Horde(社区,默认匿名 key 0000000000,注册 key 提升优先级)
AIHORDE_API_KEY=0000000000
AIHORDE_API_BASE=https://aihorde.net/v1
# Reka(每月免费 credit,无信用卡;reka-flash-3 / reka-edge-2603)
REKA_API_KEY=  # https://platform.reka.ai/
# Routeway(OpenAI 兼容聚合,:free 后缀模型 $0)
ROUTEWAY_API_KEY=  # https://routeway.ai/
# BazaarLink(OpenAI 兼容聚合,auto:free 路由零成本)
BAZAARLINK_API_KEY=  # https://bazaarlink.ai/
# AINative Studio(OpenAI 兼容聚合,每月 ~10M tokens 免费,无信用卡)
AINATIVE_API_KEY=  # https://api.ainative.studio/

# ============================================================================
# LLM_PROVIDERS — 字典化配置(2026-07-25 立,优先于扁平字段)
# ============================================================================
# 配置后,ai-service 读取 provider 配置时优先用此 JSON,扁平字段作为 fallback
# 新增 provider 只需改此 JSON,零代码改动(config.py get_provider_config 自动识别)
#
# JSON 格式:{"<provider_name>": {"api_key": "...", "api_base": "..."}, ...}
# provider_name 必须与 config.py 中扁平字段前缀一致(如 openai / anthropic / stepfun
# / agnes / groq / gemini / openrouter / cloudflare / nvidia / github / vercel /
# opencode / modal / inference_net / nlp_cloud / scaleway / alibaba_intl / cerebras
# / mistral / cohere / huggingface / zai / kilo / pollinations / llm7 / ovh / aihorde
# / reka / routeway / bazaarlink / ainative)
#
# 特殊别名(不遵循 {name}_api_key 命名约定,但 get_provider_config 已内置别名映射):
# - cloudflare → cloudflare_api_token(仍需 CLOUDFLARE_ACCOUNT_ID 构造 URL)
# - github → github_token
# - vercel → vercel_ai_gateway_key
# - opencode → opencode_zen_key
#
# api_base 留空 = 用 llm_gateway.py 中硬编码的默认 URL(仅当 provider 无 _api_base
# 扁平字段时);若 provider 有 _api_base 扁平字段(如 stepfun/agnes/llm7/aihorde/
# kilo/pollinations/ovh),留空 = 用扁平字段默认值
#
# 示例(留空 = 不启用,降级扁平字段):
# LLM_PROVIDERS={"openai":{"api_key":"sk-...","api_base":"https://api.openai.com/v1"},"cerebras":{"api_key":"...","api_base":"https://api.cerebras.ai/v1"}}
LLM_PROVIDERS=

# Provider 连通性测试结果(2026-07-16 本地 PowerShell 实测):
# - StepFun:   200 OK,连通正常(step-3.7-flash)
# - Agnes:     503 model_not_found — key 有效但 gpt-4o 在当前 plan(cachellm group)下不可用,
#               生产环境需确认 plan 支持的模型清单或更换模型名
# - Groq:      本地未配置 key,需注册后填入;LiteLLM 原生支持,生产 Docker 可通
# - Gemini:    本地未配置 key,需注册后填入;LiteLLM 原生支持,生产 Docker 可通
# - OpenRouter: 本地未配置 key,需注册后填入;LiteLLM 原生支持,生产 Docker 可通

# 付费(可选)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 模型名(前缀决定 provider,默认 StepFun)
LITELLM_MODEL=stepfun/step-3.7-flash

# 后端 API 地址(ai-service 回调 apps/api 用,本地开发端口 8802)
API_SERVICE_URL=http://localhost:8802

# AI 回调共享密钥(必填,与后端 AI_CALLBACK_SECRET 一致)
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 配置后回调 /api/ai/callback 时携带 X-Internal-Secret 头;为空则不发送
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
AI_CALLBACK_SECRET=<your-32-char-random-secret>

# ============================================================================
# mTLS 双向证书认证(2026-07-24 立,打通 api ↔ ai-service 链路)
# ============================================================================
# MTLS_ENABLED=true 时,ai-service 调用 apps/api 必须携带客户端证书 + 校验服务端证书
# MTLS_ENABLED=false(默认)→ 降级模式,httpx 正常无证书请求(仅开发环境)
# 生产环境必填,且证书文件必须存在(否则启动 fail-fast)
# 证书默认路径指向 apps/api/certs/mtls/(与服务端 mtls.ts 共享同一套证书)
# 生成方式:参考 apps/api/certs/mtls/README 或 scripts/gen-mtls-certs.sh
MTLS_ENABLED=false
MTLS_CLIENT_CERT_PATH=apps/api/certs/mtls/client.crt
MTLS_CLIENT_KEY_PATH=apps/api/certs/mtls/client.key
MTLS_CA_CERT_PATH=apps/api/certs/mtls/ca.crt

# 火山引擎实时语音(可选)
VOLC_APP_ID=
VOLC_ACCESS_KEY=
VOLC_APP_KEY=

# 凭据加密密钥(必填,与 apps/api 的 CREDENTIALS_ENCRYPTION_KEY 共享)
# 用于解密 ai_model_config 表中的 api_key_enc 字段;至少 32 字符
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
CREDENTIALS_ENCRYPTION_KEY=<your-32-char-random-encryption-key>

# OpenTelemetry 分布式追踪（R74 P2）
# 启用门控：配置 OTEL_EXPORTER_OTLP_ENDPOINT 即启用；OTEL_ENABLED=false 显式禁用
# 未配置时降级为 no-op，不阻塞启动
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8813
OTEL_SERVICE_NAME=@ihui/ai-service
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
