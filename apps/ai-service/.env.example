NODE_ENV=development
PORT=8803
HOST=0.0.0.0
LOG_LEVEL=info
# CORS 允许源(逗号分隔,必填)
# 生产环境(NODE_ENV=production)空值将导致启动失败;任何环境禁止使用 "*"
# 本地开发默认:http://localhost:8801
CORS_ORIGIN=http://localhost:8801

DATABASE_URL=postgresql://ihui:<your-dev-db-password>@localhost:8810/ihui
REDIS_URL=redis://localhost:8811

# ============================================================================
# LLM_PROVIDERS — 字典化配置(2026-07-26 阶段 3 主体,唯一配置源)
# ============================================================================
# 阶段 3 主体已删除所有扁平字段(openai_api_key / anthropic_api_key / stepfun_api_key
# 等),所有 LLM provider 配置必须通过此 JSON 字符串提供。
#
# JSON 格式: {"<provider_name>": {"api_key": "...", "api_base": "...", "enabled": true, "models": [...], "default_model": "..."}, ...}
# - api_key:    字符串,空字符串允许(降级 stub 模式)
# - api_base:   字符串或 null,null 表示用 litellm 默认 URL
# - enabled:    布尔值(禁止 "true" 字符串),默认 true
# - models:     字符串数组,可选(模型列表)
# - default_model: 字符串或 null,可选(默认模型)
#
# 支持的 32 个 provider name(阶段 3 主体白名单):
#   openai / anthropic / gemini / groq / openrouter
#   agnes / stepfun(用户 plan 套餐)
#   cloudflare / nvidia / github / vercel / opencode
#   modal / inference_net / nlp_cloud / scaleway / alibaba_intl
#   cerebras / mistral / cohere / huggingface / zai
#   kilo / pollinations / llm7 / ovh / aihorde
#   reka / routeway / bazaarlink / ainative
#   token6688(名创AI 聚合网关,单 key 全模态)
#
# 迁移扁平字段到 JSON 格式:
#   node scripts/migrate-llm-providers.mjs --input apps/ai-service/.env --output apps/ai-service/.env.migrated --apply --backup --strip-flat
#   # 然后用 .env.migrated 替换原 .env
#
# 守门脚本校验(必须 exit 0):
#   node scripts/check-llm-provider-schema.mjs --env-file apps/ai-service/.env
#
# 示例(留空 = 不启用,所有 provider 降级 stub 模式):
# LLM_PROVIDERS={"openai":{"api_key":"sk-...","api_base":"https://api.openai.com/v1"},"agnes":{"api_key":"sk-...","api_base":"https://apihub.agnes-ai.com/v1"},"stepfun":{"api_key":"sk-...","api_base":"https://api.stepfun.com/step_plan/v1"},"cloudflare":{"api_key":"<your-cf-api-token>","api_base":"https://api.cloudflare.com/client/v4/accounts/<your-account-id>/ai/v1"},"nvidia":{"api_key":"nvapi-...","api_base":"https://integrate.api.nvidia.com/v1"}}
# 注意:cloudflare 的 api_base 必须包含 account_id,格式:
#   https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# 配置后即可调用 @cf/* 前缀模型(如 @cf/zai-org/glm-4.7-flash、@cf/meta/llama-3.3-70b-instruct-fp8-fast)
# 获取 token:https://dash.cloudflare.com → My Profile → API Tokens → Create Token → Workers AI
#
# NVIDIA NIM(真免费,1M tokens/月 + 40 RPM,OpenAI 兼容,无需信用卡):
#   api_base 固定 https://integrate.api.nvidia.com/v1
#   api_key 格式 nvapi-xxx
# 配置后即可调用 nvidia/* 前缀模型(如 nvidia/deepseek-ai/deepseek-r1、nvidia/meta/llama-3.3-70b-instruct)
# 获取 key:https://build.nvidia.com → 注册 NVIDIA Developer Program → 任意模型页 Get API Key
#
# AWS Bedrock(非永久免费,新账号送 $200 credits / 6 个月,需绑信用卡):
#   不走 LLM_PROVIDERS,走 LiteLLM 原生 AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + AWS_REGION_NAME
# 配置后即可调用 bedrock/* 前缀模型(如 bedrock/amazon-nova-micro、bedrock/anthropic.claude-3-5-sonnet-20241022-v2)
# 获取 key:AWS Console → IAM → Users → Access Key
#
# ── Token6688 名创AI 聚合网关(单 key 全模态,2026-09-08 按官方 guide v2026-07-11 校准)──
# 一个 sk- key 覆盖全部模态,拿到 key 只需在下面 LLM_PROVIDERS JSON 加一条:
#   "token6688":{"api_key":"sk-..."}
#   (api_base 可省,默认 https://k.token6688.com;也可独立配 TOKEN6688_API_KEY 环境变量)
# 能力与调用方式(平台模型 ID 见免鉴权目录 GET /v1/skills/models,无需 key 即可查询):
#   对话    t6688/<chat模型>    /v1/chat/completions,43 模型(gpt-5.4/claude-opus-5/
#                               gemini-3.8-flash/glm-5.3/deepseek-v4-flash/kimi-k3 等),
#                               OpenAI 兼容,支持 stream 与 reasoning_content
#   图片    image_generation 工具 provider=token6688:/v1/images/generations 同步(40-50s,
#                               200 必查 body.error);TOKEN6688_IMAGE_ASYNC=1 切真异步
#                               model-runtime/invoke+轮询(推荐,抗反代超时)
#                               (2026-09-08 全模态自动切换:该工具已按 IMAGE_PROVIDER 链
#                               token6688→stepfun→agnes→kling→jimeng 自动故障转移,
#                               对话内说"画一张…"即自动路由,所有用户可用)
#   视频    video_generation 工具:编排器首选 token6688(VIDEO_PROVIDER 可覆盖),
#                               /v1/videos/generations 扁平形状 → GET /v1/tasks/{id} 轮询
#                               output_url(视频中位 4-40 分钟,p90 55-75 分钟);
#                               文生/图生(mode 自动切换)/首尾帧均支持
#   TTS     voice_tts engine=token6688:/v1/audio/speech OpenAI 官方同构
#                               (tts-1/tts-1-hd,voice∈alloy/echo/fable/onyx/nova/shimmer)
#   音乐    music_generation 工具:/v1/audio/generations(Suno 扁平形状,model=music,
#                               mode=song/instrumental,可选 lyrics/style/title/vocal_gender)
#                               → GET /v1/tasks/{id} 轮询 output_url(耗时约 1-5 分钟,
#                               工具限时等待 MUSIC_TOOL_WAIT_S 默认 150s,超时返 task_id 取件)
#   文件    upload_file:/v1/files(multipart ≤50MB,返 24h 有效公网 URL)
#   余额    get_balance:/v1/skills/balance(返回 "$xx.xx" 字符串,已自动转数值;
#                               model_availability 健康检查同款解析,USD)
# 可选微调 env(均有默认值,零配置可用):TOKEN6688_BASE_URL / TOKEN6688_VIDEO_MODEL
#   (默认 seedance-2-5)/ TOKEN6688_VIDEO_ENDPOINT / TOKEN6688_VIDEO_TIMEOUT(默认 3600s)/
#   TOKEN6688_IMAGE_MODEL(默认 gpt-image-2)/ TOKEN6688_IMAGE_ASYNC /
#   TOKEN6688_TTS_MODEL(默认 tts-1-hd)/ TOKEN6688_VIDEO_PAYLOAD(JSON 参数合并)/
#   MUSIC_TOOL_WAIT_S(音乐工具限时等待,默认 150s)/ VIDEO_TOOL_WAIT_S(默认 90s)
# 图片厂商优先级(可选,2026-09-08 全模态自动切换):IMAGE_PROVIDER="token6688,stepfun,agnes,kling,jimeng"
#   逗号分隔,顺序即优先级;缺省即此顺序,仅凭据已配置的厂商参与,首选失败自动换下一家
# 官方 webhook 回调(可选,2026-09-08 guide 校准;不配则纯轮询,配了提前落终态省轮询):
#   TOKEN6688_CALLBACK_URL   公网可达的回调地址(如 https://你的域名/api/video/token6688-callback),
#                            配置后视频任务提交自动带 callback_url,终态平台主动 POST 任务快照
#                            (X-TokenGo-Event: task.completed/failed;best-effort 重试 5s/30s/120s)
#   TOKEN6688_CALLBACK_SECRET 回调验签密钥(强烈建议):平台按
#                            X-TokenGo-Signature: sha256=HMAC_SHA256(secret, body) 携带签名,
#                            本端点常量时间比对,不符 401;不配则跳过验签(仅匹配在途 task_id)
# 模型目录同步:model_sync 对 token6688 免 key 可拉(目录端点免鉴权),配置 key 后
#   全部 112 模型(chat 43/video 39/image 21/audio 9)自动入库
# 拿到 key 后一条命令全模态验收(直接驱动 Provider 适配层,与线上调用链同构):
#   .venv/Scripts/python.exe scripts/e2e_token6688.py          # 全矩阵(付费项需确认)
#   .venv/Scripts/python.exe scripts/e2e_token6688.py --cheap  # 仅零成本项(目录/余额/对话/TTS/声纹)
#   .venv/Scripts/python.exe scripts/e2e_token6688.py --status <task_id>  # 查视频/音乐任务取件
# 零成本接线自检(无需 key,假 key 探测端点存在性):python scripts/smoke_token6688_endpoints.py
# 获取 key:https://k.token6688.com → 管理密钥 → 创建密钥(sk- 开头)
LLM_PROVIDERS=

# --- token6688 全模态微调(2026-09-09 补齐实际声明;全部有默认值,仅需时覆盖) ---
# 单 key 激活:二选一即可
#   ① 在上面 LLM_PROVIDERS JSON 加 "token6688":{"api_key":"sk-..."}
#   ② 或独立配置 TOKEN6688_API_KEY=sk-...
TOKEN6688_API_KEY=
# 网关地址(默认 https://k.token6688.com;适配层自动拼 /v1)
TOKEN6688_BASE_URL=https://k.token6688.com
# 调度策略:balanced/cost_first/reliability_first/latency_first(默认 balanced)
TOKEN6688_SCHEDULE_STRATEGY=balanced
# 图片:默认模型 gpt-image-2;TOKEN6688_IMAGE_ASYNC=1 切真异步(model-runtime/invoke+轮询)
TOKEN6688_IMAGE_MODEL=gpt-image-2
TOKEN6688_IMAGE_ASYNC=
# 视频:默认模型 seedance-2-5;payload 为 JSON 参数合并(如 {"mode":"first-frame"});
#   轮询路径默认 /v1/tasks/{task_id};超时上限 3600s(官方 p90 55~75 分钟)
TOKEN6688_VIDEO_MODEL=seedance-2-5
TOKEN6688_VIDEO_ENDPOINT=
TOKEN6688_VIDEO_PAYLOAD=
TOKEN6688_VIDEO_POLL_PATH=/v1/tasks/{task_id}
TOKEN6688_VIDEO_TIMEOUT=3600
# TTS:默认模型 tts-1-hd;payload 为 JSON 参数合并(如 {"speed":1.0});异步 TTS 同模型
TOKEN6688_TTS_MODEL=tts-1-hd
TOKEN6688_TTS_PAYLOAD=
# 音乐:默认 model=music(Suno 官方扁平形状固定值);如平台新增模型可覆盖
TOKEN6688_MUSIC_MODEL=music
# STT / Embeddings:平台确认 501 未开通(本地注释如实标注,保留透传实现,默认不路由)
TOKEN6688_STT_MODEL=
TOKEN6688_EMBEDDING_MODEL=
# 官方 webhook 回调(可选,不配则纯轮询):URL 公网可达,配后视频/音乐/异步 TTS 任务提交
#   自动带 callback_url,终态平台主动 POST 快照;SECRET 用于 X-TokenGo-Signature 验签
TOKEN6688_CALLBACK_URL=
TOKEN6688_CALLBACK_SECRET=
# 工具限时等待(秒):音乐默认 150s,视频默认 90s,超时返 task_id 取件
MUSIC_TOOL_WAIT_S=150
VIDEO_TOOL_WAIT_S=90
# 图片厂商自动切换链(2026-09-08):逗号分隔顺序即优先级,仅凭据已配置者参与,首选失败自动换下一家
IMAGE_PROVIDER=token6688,stepfun,agnes,kling,jimeng

# 模型名(前缀决定 provider,默认 StepFun)
LITELLM_MODEL=stepfun/step-3.7-flash

# 资讯板块每日自动刷新(2026-08-12 立,每天 8:00 UTC+8 自动生成+发布新闻)
# 设为 true 后 ai-service 启动时挂载 asyncio 调度循环,每天 8:00 自动调 LLM 生成
# 新闻并发布。默认 false,避免不消耗 LLM tokens。
# .env: NEWS_CRON_ENABLED=true
# 生产环境建议设为 true,零维护、零人工干预。
NEWS_CRON_ENABLED=false

# ============================================================================
# 模型自动同步(ModelSyncService,2026-07-31 立)
# ============================================================================
# 同步间隔(秒),默认 6 小时(21600)。admin 也可通过 PUT /api/llm/models/sync/config 运行时调整
MODEL_SYNC_INTERVAL_S=21600
# 并发拉取数(同时拉取的 provider 数量),默认 5。过高可能触发 provider 限流
MODEL_SYNC_CONCURRENCY=5

# 后端 API 地址(ai-service 回调 apps/api 用,本地开发端口 8802)
API_SERVICE_URL=http://localhost:8802

# AI 回调共享密钥(必填,与后端 AI_CALLBACK_SECRET 一致)
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 配置后回调 /api/ai/callback 时携带 X-Internal-Secret 头;为空则不发送
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
AI_CALLBACK_SECRET=<your-32-char-random-secret>

# ============================================================================
# mTLS 双向证书认证(2026-07-24 立,打通 api ↔ ai-service 链路)
# ============================================================================
# MTLS_ENABLED=true 时,ai-service 调用 apps/api 必须携带客户端证书 + 校验服务端证书
# MTLS_ENABLED=false(默认)→ 降级模式,httpx 正常无证书请求(仅开发环境)
# 生产环境必填,且证书文件必须存在(否则启动 fail-fast)
# 证书默认路径指向 apps/api/certs/mtls/(与服务端 mtls.ts 共享同一套证书)
# 生成方式:参考 apps/api/certs/mtls/README 或 scripts/gen-mtls-certs.sh
MTLS_ENABLED=false
MTLS_CLIENT_CERT_PATH=apps/api/certs/mtls/client.crt
MTLS_CLIENT_KEY_PATH=apps/api/certs/mtls/client.key
MTLS_CA_CERT_PATH=apps/api/certs/mtls/ca.crt

# 火山引擎实时语音(可选)
VOLC_APP_ID=
VOLC_ACCESS_KEY=
VOLC_APP_KEY=

# ============================================================================
# CSDN 自动发布凭证(可选,仅 content_engine skill 使用)
# ============================================================================
# 逆向自 editor.csdn.net 内部 API 的签名凭证;空值=未配置,签名会失败
# 用途:lib/csdn_publish.py 用 x-ca-key + HMAC-SHA256 签名调 CSDN 内部接口
# 留空时该 skill 不可用,不影响 ai-service 主流程
CSDN_APP_KEY=
CSDN_APP_SECRET=
# Cookie 获取方法:浏览器登录 CSDN → F12 → Network → 任意请求 → 复制 Cookie 头
CSDN_COOKIE=

# 凭据加密密钥(必填,与 apps/api 的 CREDENTIALS_ENCRYPTION_KEY 共享)
# 用于解密 ai_model_config 表中的 api_key_enc 字段;至少 32 字符
# 2026-07-24 安全审计:强制必填,空值将导致 docker-compose 启动失败
# 生成方式:openssl rand -hex 32(至少 32 字符随机密钥)
CREDENTIALS_ENCRYPTION_KEY=<your-32-char-random-encryption-key>

# OpenTelemetry 分布式追踪（R74 P2）
# 启用门控：配置 OTEL_EXPORTER_OTLP_ENDPOINT 即启用；OTEL_ENABLED=false 显式禁用
# 未配置时降级为 no-op，不阻塞启动
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8813
OTEL_SERVICE_NAME=@ihui/ai-service
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ============================================================================
# 本地 LLM 服务(LiteLLM 原生,2026-07-27 统一 secret 管理)
# ============================================================================
# _resolve_provider 中 ollama/lmstudio/llamacpp/azure/bedrock 前缀走这些字段
# 默认值与 LiteLLM 库内部约定一致;用户在 .env 覆盖即激活对应 provider
# 全部留空 = 不启用本地 LLM,降级 stub 模式或走 LLM_PROVIDERS 配置的 provider

# Ollama(本地,默认 http://localhost:11434,无需 api_key 即可用)
OLLAMA_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
# LM Studio(本地,默认 http://localhost:1234)
LMSTUDIO_API_KEY=
LMSTUDIO_API_BASE=http://localhost:1234
# llama.cpp(本地,默认 http://localhost:8803,无 api_key)
LLAMACPP_API_BASE=http://localhost:8803
# Azure OpenAI(LiteLLM 原生,需配合 AZURE_API_VERSION 等环境变量)
AZURE_API_KEY=
AZURE_API_BASE=
# AWS Bedrock(LiteLLM 原生,需配合 AWS_SECRET_ACCESS_KEY / AWS_REGION_NAME 等)
AWS_ACCESS_KEY_ID=

# ============================================================================
# MCP / Publish 工具配置(2026-07-27 统一 secret 管理)
# ============================================================================
# MCP_WORKSPACE_ROOTS:MCP read_file/write_file 工作区根目录白名单
#   分隔符 os.pathsep(Windows 是 ";" Unix 是 ":"),空=用当前工作目录
MCP_WORKSPACE_ROOTS=
# PUBLISH_UPLOAD_DIR:多平台发布上传根目录,空=默认 .uploads/publish(已在 .gitignore)
PUBLISH_UPLOAD_DIR=
# GITHUB_TOKEN:MCP review_pr 工具调 GitHub API
#   空=匿名调用受 rate limit(60/h);配置后 5000/h
#   生成方式:GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# ============================================================================
# LLM 出站代理(2026-07-30 立,商业化上线运营刚需)
# ============================================================================
# 国内服务器访问 OpenAI/Anthropic/OpenRouter 等境外 provider 时必须走代理
# 配置后自动写入 os.environ[HTTP_PROXY/HTTPS_PROXY],litellm/httpx 自动读取
# 格式:http://user:pass@host:port 或 http://host:port  空字符串=不使用代理
LLM_PROXY_URL=

# ============================================================================
# P3-3 OpenRouter 403 代理 + failover(2026-07-30 立)
# ============================================================================
# OpenRouter 对国内 IP / 非浏览器 UA 常返回 403 Forbidden(WAF 拦截),
# 配置专用代理 URL 后,llm_gateway 在 openrouter/ 前缀调用期间临时设置
# HTTPS_PROXY env var(LiteLLM 底层 httpx 自动读取),调用结束恢复原值。
# 空字符串=不使用 OpenRouter 专用代理(走全局 LLM_PROXY_URL 或直连)
OPENROUTER_PROXY_URL=
# OpenRouter 403 时自动 failover 到 agnes/ 中转(同模型换 provider)
# true(默认):openrouter/<model> 返回 403 时,自动重试 agnes/<model>
# false:不 failover,直接返回 403 错误(用户自行处理)
OPENROUTER_FAILOVER_TO_AGNES=true

# ============================================================================
# Token 压缩(2026-07-30 立,P2-A TokenCompactor 配套,对标并超越 OmniRoute 89%)
# ============================================================================
# 启用后 llm_gateway.complete/astream 在 trim_messages 后、litellm.acompletion 前
# 自动调用 RTK+Caveman 双算法压缩(策略=rtk_caveman,keep_recent=6)。
# 启用条件:① TOKEN_COMPACTION_ENABLED=true ② 非 stub 模式 ③ 不含 tools 参数
#   ④ 总 token 数 > TOKEN_COMPACTION_MIN_TOKENS
# 压缩失败降级用原 messages(不阻塞主流程),压缩率记录到 LLM_TOKEN_COMPACTION_RATIO metric
# 默认 false:对消息结构敏感的场景(如 function calling)保守不启用,需手动开启
TOKEN_COMPACTION_ENABLED=false
TOKEN_COMPACTION_MIN_TOKENS=2000

# ============================================================================
# Combo 多级 fallback 链(2026-07-30 立,P0-1 ComboRouter 配套,对标 OmniRoute Combo)
# ============================================================================
# JSON 字符串,格式:{"<combo_name>": {"strategy": "priority|cheapest|fusion",
#   "chain": ["model1", "model2", ...], "judge": "model"(fusion 可选),
#   "judge_mode": "merge|vote"(fusion 可选), "max_concurrency": int(fusion 可选)}, ...}
# 主 provider + FallbackRouter 单层 fallback 全部失败后,若 primary 在某 combo 链中,
# 自动触发 ComboRouter 按策略选择下一个 provider(429 自动 cooldown 指数退避)。
# 空=不启用 Combo fallback(主链路 + 单层 FallbackRouter 仍可用)
#
# 推荐 maximize-free 链(免费 provider 优先,符合"不想花一分钱"约束):
# COMBO_CHAINS={"maximize-free":{"strategy":"priority","chain":["stepfun/step-3.7-flash","agnes/agnes-2.5-flash","openrouter/qwen/qwen3-235b-a22b:free"]}}
COMBO_CHAINS=

# ============================================================================
# Agent 执行器开关(2026-08-12 立)
# ============================================================================
# 默认 langgraph:agent 任务走原 LangGraph 工作流(plan → execute → summarize),
# 不设置即保持现状,生产环境无需改动。
# 设为 loop_v2:agent 任务走 AgentLoopV2(agent_loop_v2.py),启用后具备:
#   - LLM 指数退避重试 + 工具瞬时重试(抗瞬时故障)
#   - 错误六分类(精准定位失败原因)
#   - 元学习闭环(技能自进化)
#   - 事件总线实时可视化(任务进度可观测)
AGENT_EXECUTOR=langgraph

# ============================================================================
# Agent 自愈门控(2026-09-12 立,2-3 自愈引擎产品化第二批)
# ============================================================================
# AGENT_SELF_HEALING_ENABLED:自愈总开关,默认 false(关闭)。
#   关闭时 agent_loop_v2 不触发自愈,/api/v1/self-healing/* 返回明确
#   {code,message,data} 未开启提示(web 自愈驾驶舱降级展示,非报错)。
#   开启后:每轮工具结果经 _detect_failed_test_signal 检测 run_command pytest
#   失败信号(test.failed>0 或蛇形 exit_code 非零)即触发 heal——先 snapshot_file
#   拍 pre-heal 快照再 apply_patch_descriptor 落盘,未修复则逐文件 rollback_file
#   回滚;全程 fail-open(异常只 warning,不阻塞主循环),结果以 user 消息注入
#   供 LLM 感知续跑。
#   ⚠️ 开启后 agent 会自动改写工作区文件(有 snapshot/rollback 护栏),
#   生产环境开启前请确认可接受该行为。
AGENT_SELF_HEALING_ENABLED=false

# AGENT_SELF_HEAL_MAX_PER_RUN:单次 run 内 heal 触发次数上限(默认 1),防止修复死循环。
AGENT_SELF_HEAL_MAX_PER_RUN=1
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠
