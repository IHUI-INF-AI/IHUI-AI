{
  "name": "@ihui/cli",
  "version": "1.0.0",
  "description": "IHUI AI Coding Agent CLI — 对标 Claude Code / Codex",
  "private": false,
  "type": "module",
  "bin": {
    "ihui": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:compaction": "tsx scripts/compaction-eval.ts",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ihui/api-client": "workspace:*",
    "@ihui/context-compaction": "workspace:*",
    "@ihui/shared": "workspace:*",
    "@ihui/types": "workspace:*",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "gpt-tokenizer": "^3.4.0",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "playwright": "^1.48.2",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver-protocol": "^3.18.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@ihui/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "rimraf": "catalog:",
    "tsx": "^4.23.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "minimumVersion": "1.0.0"
  },
  "author": "李春川 (Li Chunchuan) <IHUI AI (智汇AI)>",
