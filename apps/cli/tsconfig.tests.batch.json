// ⚠️ 本文件只用于「**单批读数可复现**」,不是全仓配置:
//   · include 只列当前批次的文件;复跑:`pnpm --filter ihui-cli exec tsc -p tsconfig.tests.batch.json --noEmit`
//   · 显式钉 `noUncheckedIndexedAccess: true`,不继承工作树里别席可能改成 false 的 tsconfig.tests.json
//   · **禁止**拿它当全仓 typecheck:tests 用;全量口径是 `apps/cli/tsconfig.tests.json`(package.json 的 typecheck:tests)
//   · 每批随提交更新 include;历史批次版本用 `git show <该批 SHA>:apps/cli/tsconfig.tests.batch.json` 取回
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "incremental": false,
    "rootDir": ".",
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "tests/types/**/*.d.ts",
    "tests/argument-validation-replay.test.ts",
    "tests/argument-validation-shadow.test.ts",
    "tests/browser-page-snapshot.test.ts",
    "tests/cloud-run.test.ts",
    "tests/debug.test.ts",
    "tests/goal-verification-egress.test.ts",
    "tests/mcp-credentials.test.ts",
    "tests/mcp-oauth.test.ts",
    "tests/mermaid-inflight.test.ts",
    "tests/permission-lease.test.ts",
    "tests/plugin-install-atomicity.test.ts",
    "tests/prompt-boundary.test.ts",
    "tests/tool-result-budget-contract.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
