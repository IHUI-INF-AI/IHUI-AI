export const LOW_MEMORY_NODE_FLAGS: string[]

export interface LowMemorySpawnResult {
  status?: number | null
  error?: Error
}

export type LowMemorySpawn = (
  command: string,
  args: string[],
  options: { stdio: 'inherit'; env: NodeJS.ProcessEnv; windowsHide: true },
) => LowMemorySpawnResult

export function defaultEntry(): string

export function buildLowMemoryArgv(
  entry: string,
  argv: string[],
  execPath?: string,
): string[]

export function runLowMemory(options?: {
  entry?: string
  argv?: string[]
  spawn?: LowMemorySpawn
  stderr?: { write(chunk: string): unknown }
}): number
