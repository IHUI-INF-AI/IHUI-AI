{
  "name": "@ihui/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./auth/*": {
      "types": "./src/auth/*.ts",
      "import": "./src/auth/*.ts"
    },
    "./notifications/*": {
      "types": "./src/notifications/*.ts",
      "import": "./src/notifications/*.ts"
    },
    "./validation/*": {
      "types": "./src/validation/*.ts",
      "import": "./src/validation/*.ts"
    },
    "./workflows/*": {
      "types": "./src/workflows/*.ts",
      "import": "./src/workflows/*.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts"
    },
    "./skills/*": {
      "types": "./src/skills/*.ts",
      "import": "./src/skills/*.ts"
    },
    "./tasks/*": {
      "types": "./src/tasks/*.ts",
      "import": "./src/tasks/*.ts"
    },
    "./design/*": {
      "types": "./src/design/*.ts",
      "import": "./src/design/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "xstate": "^5.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ihui/eslint-config": "workspace:*",
    "eslint": "^9.16.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
