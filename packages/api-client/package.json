{
  "name": "@ihui/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./api-error": {
      "types": "./dist/api-error.d.ts",
      "import": "./dist/api-error.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./endpoints/*": {
      "types": "./dist/endpoints/*.d.ts",
      "import": "./dist/endpoints/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHUI-INF-AI/IHUI-AI.git",
    "directory": "packages/api-client"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "clean": "rimraf dist .turbo node_modules"
  },
  "dependencies": {
    "@ihui/types": "workspace:*"
  },
  "peerDependencies": {
    "@tarojs/taro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@tarojs/taro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ihui/eslint-config": "workspace:*",
    "@tarojs/taro": "4.2.1",
    "typescript": "catalog:",
    "rimraf": "catalog:",
    "vitest": "catalog:"
  },
  "author": "李春川 (Li Chunchuan) <IHUI AI (智汇AI)>",
  "homepage": "https://aizhs.top",
  "copyright": "© 2026 IHUI AI (智汇AI) · 李春川 · All rights reserved.",
