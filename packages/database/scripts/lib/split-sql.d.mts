export interface SplitSqlResult {
  /** 顶层语句（已 trim，仅注释的片段不产生幽灵语句） */
  statements: string[]
  /** 顶层分号数，调用方用 `semicolonCount === statements.length` 做严格自检 */
  semicolonCount: number
  /** dollar-quote / 单双引号 / 块注释是否全部闭合 */
  balanced: boolean
}

export function splitSqlStatements(input: string): SplitSqlResult

/** 去掉注释，保留字符串与 dollar-quote 正文 */
export function stripSqlComments(input: string): string
