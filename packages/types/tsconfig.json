{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/packages-types.tsbuildinfo",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TextEncoder / AbortSignal 是运行时跨端（Node、浏览器、RN）都存在的全局，
    // 但基础 tsconfig 只带 ES2023 lib；发布构建必须显式带 DOM 类型，否则 dist 产不出来。
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
