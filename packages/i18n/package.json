{
  "name": "@ihui/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IHUI-AI 4 端(web/extension/miniapp-taro/mobile-rn)i18n 翻译单一来源共享包",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./loader": {
      "types": "./src/loader.ts",
      "import": "./src/loader.ts"
    },
    "./messages/*": {
      "default": "./messages/*"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "@ihui/eslint-config": "workspace:*",
    "@ihui/tsconfig": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
