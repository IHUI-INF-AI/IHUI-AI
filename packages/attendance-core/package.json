{
  "name": "@ihui/attendance-core",
  "version": "0.0.0",
  "private": true,
  "description": "IHUI-AI 考勤判定内核(8端共享):迟到/早退/缺勤纯函数判定 + 缺勤补录纯算法,主体无关,教育/人事共用单一真相源",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./algorithm": {
      "types": "./dist/algorithm.d.ts",
      "import": "./dist/algorithm.js",
      "default": "./dist/algorithm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHUI-INF-AI/IHUI-AI.git",
    "directory": "packages/attendance-core"
  },
  "scripts": {
    "build": "node ../../scripts/lib/atomic-build.mjs -p tsconfig.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build",
    "clean": "rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "rimraf": "catalog:",
    "vitest": "catalog:"
  },
  "author": "李春川 (Li Chunchuan) <IHUI AI (智汇AI)>",
  "homepage": "https://aizhs.top"
}
