{
  "$note": "帧级 traceId 的判例表(票 D174 到端那一半)。两侧各有一份实现(@ihui/shared 的 normalizeSSEFrameTraceId / @ihui/api-client 的 readStreamTraceId),因为 api-client 不依赖 shared(加依赖就是未声明的幽灵依赖,§12e 那类\"本地绿、装完崩\")。这张表由两边的测试各自跑一遍:\n  packages/api-client/tests/stream-trace-id-parity.test.ts\n  packages/shared/src/sse/__tests__/sse-trace-id-parity.test.ts\n任何一侧改判读规则而没同步这张表,对应那侧的测试就红 —— 这是\"两处算同一件事\"唯一能成立的形状(共判据数据,不共文件)。",
  "cases": [
    {
      "name": "合法小写 32 hex",
      "line": "data: {\"type\":\"done\",\"traceId\":\"0af7651916cd43dd8448eb211c80319c\"}",
      "expect": "0af7651916cd43dd8448eb211c80319c"
    },
    {
      "name": "大写归一为小写(PG 等值区分大小写)",
      "line": "data: {\"traceId\":\"0AF7651916CD43DD8448EB211C80319C\"}",
      "expect": "0af7651916cd43dd8448eb211c80319c"
    },
    {
      "name": "全 0 是 W3C 非法值,不配当关联键",
      "line": "data: {\"traceId\":\"00000000000000000000000000000000\"}",
      "expect": null
    },
    {
      "name": "长度 31 不合法",
      "line": "data: {\"traceId\":\"0af7651916cd43dd8448eb211c80319\"}",
      "expect": null
    },
    {
      "name": "含非 hex 字符不合法",
      "line": "data: {\"traceId\":\"zzf7651916cd43dd8448eb211c80319c\"}",
      "expect": null
    },
    {
      "name": "非字符串不认",
      "line": "data: {\"traceId\":123}",
      "expect": null
    },
    {
      "name": "无该键",
      "line": "data: {\"type\":\"chunk\",\"content\":\"hi\"}",
      "expect": null
    },
    {
      "name": "[DONE] 哨兵",
      "line": "data: [DONE]",
      "expect": null,
      "lineOnly": true
    },
    {
      "name": "注释行",
      "line": ": keep-alive",
      "expect": null,
      "lineOnly": true
    },
    {
      "name": "event: 行本身不带载荷",
      "line": "event: done",
      "expect": null,
      "lineOnly": true
    },
    {
      "name": "坏 JSON 不猜",
      "line": "data: {\"traceId\":\"",
      "expect": null,
      "lineOnly": true
    },
    {
      "name": "小程序自写传输层的 <数字>:<载荷> 前缀,判不出即 null",
      "line": "data: 1:{\"traceId\":\"0af7651916cd43dd8448eb211c80319c\"}",
      "expect": null,
      "lineOnly": true
    },
    {
      "name": "无 data: 前缀的裸 JSON 也要认(服务端首帧形态)",
      "line": "{\"traceId\":\"0af7651916cd43dd8448eb211c80319c\",\"type\":\"done\"}",
      "expect": "0af7651916cd43dd8448eb211c80319c"
    },
    {
      "name": "前后空白不影响识别",
      "line": "data:   {\"traceId\":\" 0af7651916cd43dd8448eb211c80319c \"}  ",
      "expect": "0af7651916cd43dd8448eb211c80319c"
    }
  ]
}
