        "src/pkg-user/user/settings.tsx",
        "src/rn-compat/expo-blur.tsx",
        "src/rn-compat/i18n.ts",
        "src/rn-compat/icons-generated.tsx",
        "src/rn-compat/index.ts",
        "src/rn-compat/native-asset.ts",
        "src/rn-compat/native-audio.ts",
        "src/rn-compat/native-document.ts",
        "src/rn-compat/native-extras.ts",
        "src/rn-compat/native-secure.ts",
        "src/rn-compat/native-svg.tsx",
        "src/rn-compat/native-webview.tsx",
        "src/rn-compat/native-wechat.ts",
        "src/rn-compat/navigation.tsx",
        "src/rn-compat/platform.tsx",
        "src/rn-compat/storage.ts",
        "src/rn-compat/theme.tsx",
      ],
      "paths": {
        "@rn-shells/*": ["../mobile-rn/src/screens/*"],
        "@ihui/rn-app/*": ["../../packages/app/src/*"],
        "react-native$": ["src/rn-compat/index.ts"],
        "lucide-react-native$": ["src/rn-compat/icons-generated.tsx"],
        "react-native-safe-area-context$": ["src/rn-compat/platform.tsx"],
        "@react-navigation/native$": ["src/rn-compat/navigation.tsx"],
        "@react-navigation/native-stack$": ["src/rn-compat/navigation.tsx"],
        "@react-native-async-storage/async-storage$": ["src/rn-compat/storage.ts"],
        "@react-native-clipboard/clipboard$": ["src/rn-compat/platform.tsx"],
        "expo-image-picker$": ["src/rn-compat/platform.tsx"],
        "expo-blur$": ["src/rn-compat/expo-blur.tsx"],
        "expo-media-library$": ["src/rn-compat/platform.tsx"],
        "expo-linking$": ["src/rn-compat/native-extras.ts"],
        "expo-web-browser$": ["src/rn-compat/native-extras.ts"],
        "expo-device$": ["src/rn-compat/native-extras.ts"],
        "react-native-restart$": ["src/rn-compat/native-extras.ts"],
        "expo-file-system$": ["src/rn-compat/native-extras.ts"],
        "nativewind$": ["src/rn-compat/native-extras.ts"],
        "expo-audio$": ["src/rn-compat/native-audio.ts"],
        "expo-document-picker$": ["src/rn-compat/native-document.ts"],
        "expo-asset$": ["src/rn-compat/native-asset.ts"],
        "react-native-svg$": ["src/rn-compat/native-svg.tsx"],
        "react-native-webview$": ["src/rn-compat/native-webview.tsx"],
        "react-native-wechat-lib$": ["src/rn-compat/native-wechat.ts"],
        "expo-secure-store$": ["src/rn-compat/native-secure.ts"],
      },
// END:knip-taro-entries
      // 2026-11-01:`@ihui/ui-native` 在本端 src 里确实零条静态 import,但它不是未用依赖 ——
      // config/index.ts:580 的 `compile.include` 把 `packages/app/src` 整片编进小程序产物,
      // 而那些源码 import '@ihui/ui-native',模块解析要由**本端**的 package.json 承载
      // (f5db1221ae 补这条声明就是为了修真实构建失败 "Cannot find module '@ihui/ui-native'")。
      // knip 只沿静态 import 走,看不见 webpack 装载链 ⇒ 与 mobile-rn 那侧 lucide-react 同档。
      // 到期复核 2027-05-01:若 compile.include 改成端内自带出口(不再需要本端声明),删本条。
      // 2026-11-03(Knip 棘轮 devDependencies +2 归因):+ `miniprogram-ci` —— 声明在本 workspace
      // devDependencies(package.json),消费方是根脚本 scripts/upload-miniapp.mjs:83 的动态
      // `await import('miniprogram-ci')`;根 workspace 的 scripts/** 已在上面整体 ignore,
      // 本 workspace 的静态面因此看不到这条 import。它确属本端上传链的真依赖(脚本的报错文案
      // 也直接指引 `pnpm --filter @ihui/miniapp-taro add -D miniprogram-ci`),不是冗余。
      // 到期复核:若上传脚本改为在 apps/miniapp-taro 内执行(进入本 workspace 扫描面),删本条。
      "ignoreDependencies": ["@ihui/ui-native", "miniprogram-ci"],
      "project": ["**/*.{ts,tsx}"],
      // 2026-10-20:Taro 页面发现机制 = app.config.ts 的 pages 数组按**字符串路径**引用
      // ('about/web-portal/index',见 app.config.ts:165),knip 静态 import 面看不见该形态,
      // 把 WebView 功能门户(1acc27db55,89 条/13 组)整簇误报为未引用文件:
      // index.tsx/index.config.ts 两个页面入口 + 被页面 import 的 constants/web-portal.ts
      // (唯一 import 方就是页面自身,整簇因页面不可达而连带不可达)。
      // 到期复核:启用 @knip/taro 插件(能解析 pages 字符串)后应删本白名单。
      "ignore": [
        "src/pkg-about/about/web-portal/index.tsx",
        "src/pkg-about/about/web-portal/index.config.ts",
        "src/constants/web-portal.ts",
        "src/pkg-user/fans/index.tsx",
        "src/pkg-user/fans/index.config.ts",
        "src/pkg-user/checkin-assistant/index.tsx",
        "src/pkg-user/account-pool/index.tsx",
        "src/pkg-user/account-pool/add-form.tsx",
        "src/pkg-user/account-pool/pool-row.tsx",
        "src/pkg-ai/dev-space/index.config.ts",
        "src/components/ScreenStates.taro.tsx",
        "src/components/ScrollJumpButton.tsx",
        "src/pages/distribution/company/company-constants.ts",
        "src/pkg-about/about/aboutSections.ts",
        "src/components/Collapsible.tsx",
        "src/components/Sheet.tsx",
        "src/components/Tabs.tsx",
        // 2026-10-26(Knip 棘轮 files 超基线,归因席 s27-knip 逐条现读后登记,分两族):
        // 族① 14 枚页面 = Taro `app.config.ts` 的 pages/subPackages 按**字符串路径**装载,
        // knip 静态 import 面看不见(与上面 2026-10-20/10-25 两批同族)。逐条核过登记面:
        // 每页在 app.config.ts 内以 `<尾段>/index` 形态命中 1 次(如 'edu-shop/index'),
        // 且 pkg-user/edu-child/records-page.tsx 实测有 10 个引用方(六枚 edu-child 页等),
        // 它进 files 判定纯因引用它的页面本身不可达而连带。
        // 族② 六枚地基组件(Card/Button/Switch/Input/Badge/VipBadge,入库 f885df8472 goal 地基批)
        // 现读**零消费方**(全仓 import 语句命中 0,components/index.ts 也未再导出)——
        // 属"先落组件、消费页未接"半成品族,对齐 apps/mobile-rn 的 AutomationCard/MetricCard 先例,
        // 不是"被页面 import"那一族;到期复核若确认不接,应删除而非续挂白名单。
        // 到期复核:启用能解析 Taro pages 字符串的插件后删族①;族② 复核期 2027-01-31。
        "src/pkg-shop/edu-shop/index.tsx",
        "src/pkg-user/edu-mgmt-attendance/index.tsx",
        "src/pkg-user/edu-mgmt-finance/index.tsx",
        "src/pkg-user/edu-mgmt-grades/index.tsx",
        "src/pkg-user/edu-parent/index.tsx",
        "src/pkg-user/llm-settings/index.tsx",
        "src/pkg-user/user-public/index.tsx",
        "src/pkg-about/about/agreement/index.tsx",
        "src/pkg-user/edu-child/attendance/index.tsx",
        "src/pkg-user/edu-child/bills/index.tsx",
        "src/pkg-user/edu-child/grades/index.tsx",
        "src/pkg-user/edu-child/meals/index.tsx",
        "src/pkg-user/edu-child/schedule/index.tsx",
        "src/pkg-user/edu-child/study-plans/index.tsx",
        "src/pkg-user/edu-child/records-page.tsx",
        "src/components/Badge.tsx",
        "src/components/Button.tsx",
        "src/components/Card.tsx",
        "src/components/Input.tsx",
        "src/components/Switch.tsx",
        "src/components/VipBadge.tsx",
        "src/constants/web-portal.ts"
      ]
    },
    "packages/database": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "project": ["src/**/*.ts"]
    },
    "packages/context-compaction": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui-native": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/app": {
      "project": ["src/**/*.{ts,tsx}"],
      // lucide-react 与 lucide-react-native 双包并存:NavBar/PayButton 等同构组件在 web/RNW 侧
      // import lucide-react(真 SVG),native 侧用 -native;这些组件随 TabBar 液态玻璃接入(068af74ddf)、
      // 尚未挂到静态可达入口,knip 因而把真依赖误报为未用。
      // 到期复核:组件挂载到入口可达面后应删本白名单。
      "ignoreDependencies": ["lucide-react"]
    }
  }
}
