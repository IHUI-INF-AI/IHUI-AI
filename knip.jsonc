{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["app/**/page.tsx", "app/**/layout.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/extension": {
      "entry": ["src/i18n/index.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/mobile-rn": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/miniapp-taro": {
      "entry": ["src/app.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/database": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "project": ["src/**/*.ts"]
    },
    "packages/context-compaction": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui-native": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
