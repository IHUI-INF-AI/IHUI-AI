{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // 运维/守门脚本(scripts/**、deploy/scripts/**):由 nssm 服务、CI 或人工直接执行调用,
  // 不在产品运行时依赖图中,knip 会把它们误判为「未引用文件」→ 统一忽略以消除此类误报,
  // 并避免后续新增运维脚本再次打破棘轮。(这些脚本的 next 等运行时解析依赖随之免检。)
  // 2026-10-20 增 .github/scripts/**:同族第三处 —— CI 工作流 run 步骤直接 node 调用
  // (npm-bootstrap.yml:79 `node npm-bootstrap-runner.mjs`),knip 静态面看不见工作流调用,
  // 与 2026-09-25 的 ignoreBinaries 同型盲区;该文件由工作流承载体调用,非产品依赖图成员。
  "ignore": ["scripts/**", "deploy/scripts/**", ".github/scripts/**"],
  // 2026-09-25(B6 定性票):CI 工作流 run 步骤里以 root 上下文调用的真二进制 = 框架装载型,非未声明依赖。
  // 立因:knip 把 .github/workflows/e2e-browser-hub.yml 的 `pnpm exec playwright`(L157)与
  // `pnpm exec drizzle-kit`(L202)记进 root workspace 的 binaries,而这两个包声明在 apps/web /
  // packages/database,root workspace 结构上看不见 —— 同形态的 migration-tests.yml|drizzle-kit
  // 早已计入 09-15 基线(binaries 16 即含它),所以这不是新增死代码,是配置盲区新增第 2 次发作(+2 超基线)。
  // 只在本 root workspace 免检这两个名字;任一"端"真删了 playwright/drizzle-kit 声明,
  // dependencies/unlisted 判据仍会红,本行不会掩盖。
  "ignoreBinaries": ["playwright", "drizzle-kit"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["app/**/page.tsx", "app/**/layout.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"],
      // 2026-10-20:esbuild/postject 是 SEA 单文件构建链(build-sea.mjs / build-npm.mjs)的
      // 真依赖,但这两个构建脚本位于 apps/cli/scripts/,在本 workspace 的 project 模式
      // (src/**/*.ts)扫描面之外 ⇒ knip 看不见 import,误报未用。与 root ignore scripts/**
      // 同族:构建期工具由脚本承载体调用,非产品运行时依赖图成员。
      "ignoreDependencies": ["esbuild", "postject"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/extension": {
      "entry": ["src/i18n/index.tsx"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/mobile-rn": {
      "project": ["src/**/*.{ts,tsx}"],
      // 2026-10-20:功能切片半成品(先落组件、屏幕未接)的静态不可达豁免:
      // automation/AutomationCard.tsx(automations 屏幕卡片)与
      // dashboard/MetricCard.tsx(看板分区指标卡)均为只读展示组件,
      // 消费屏幕(automations / dashboard)尚在途,knip import 图不可达 ⇒ 误报未引用文件。
      // 到期复核:对应屏幕接入后删本白名单;若屏幕确认不做,组件应删除而非续挂。
      "ignore": [
        "src/components/automation/AutomationCard.tsx",
        "src/components/dashboard/MetricCard.tsx"
      ],
      // @lobehub/icons 由 brand-icon.web.tsx 以深路径 default 导入(react-native-web 平台扩展 .web.tsx),
      // knip 静态面不解析 .web.tsx 平台变体,会把这条真实依赖误报为未用;2026-10-17 厂商矢量图标接入(f72e53becd)。
      // 到期复核:启用 @knip/react-native 插件(platformExtensions)后应删本白名单。
      "ignoreDependencies": ["@lobehub/icons"]
    },
    "apps/miniapp-taro": {
      "entry": ["src/app.tsx"],
      "project": ["**/*.{ts,tsx}"],
      // 2026-10-20:Taro 页面发现机制 = app.config.ts 的 pages 数组按**字符串路径**引用
      // ('about/web-portal/index',见 app.config.ts:165),knip 静态 import 面看不见该形态,
      // 把 WebView 功能门户(1acc27db55,89 条/13 组)整簇误报为未引用文件:
      // index.tsx/index.config.ts 两个页面入口 + 被页面 import 的 constants/web-portal.ts
      // (唯一 import 方就是页面自身,整簇因页面不可达而连带不可达)。
      // 到期复核:启用 @knip/taro 插件(能解析 pages 字符串)后应删本白名单。
      // 2026-10-25(Knip 棘轮 files 超基线):同族第三批 —— 2026-10-23~24 跨端落地批新增的
      // 页面/页面配置(index.config.ts 由页面一同按字符串装载)与"仅被页面 import"的件,
      // 因页面不可达而整簇连带不可达。Sheet/Tabs/Collapsible 属"先落组件、屏幕未接"同族
      // (对齐 mobile-rn AutomationCard/MetricCard 先例),不是死代码。
      // 到期复核:启用能解析 Taro pages 字符串的插件后应删本白名单;若确认不做,应删除而非续挂。
      "ignore": [
        "src/pkg-about/about/web-portal/index.tsx",
        "src/pkg-about/about/web-portal/index.config.ts",
        "src/constants/web-portal.ts",
        "src/pkg-user/fans/index.tsx",
        "src/pkg-user/fans/index.config.ts",
        "src/pkg-user/checkin-assistant/index.tsx",
        "src/pkg-user/account-pool/index.tsx",
        "src/pkg-user/account-pool/add-form.tsx",
        "src/pkg-user/account-pool/pool-row.tsx",
        "src/pkg-ai/dev-space/index.config.ts",
        "src/components/ScreenStates.taro.tsx",
        "src/components/ScrollJumpButton.tsx",
        "src/pages/distribution/company/company-constants.ts",
        "src/pkg-about/about/aboutSections.ts",
        "src/components/Collapsible.tsx",
        "src/components/Sheet.tsx",
        "src/components/Tabs.tsx"
      ]
    },
    "packages/database": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "project": ["src/**/*.ts"]
    },
    "packages/context-compaction": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui-native": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/app": {
      "project": ["src/**/*.{ts,tsx}"],
      // lucide-react 与 lucide-react-native 双包并存:NavBar/PayButton 等同构组件在 web/RNW 侧
      // import lucide-react(真 SVG),native 侧用 -native;这些组件随 TabBar 液态玻璃接入(068af74ddf)、
      // 尚未挂到静态可达入口,knip 因而把真依赖误报为未用。
      // 到期复核:组件挂载到入口可达面后应删本白名单。
      "ignoreDependencies": ["lucide-react"],
      // 2026-10-25(Knip 棘轮 files 超基线):TabBar 与上面 NavBar/PayButton 同族 ——
      // 液态玻璃跨端条先落组件、入口尚未接,knip import 图不可达 ⇒ 误报未引用文件。
      // 到期复核:接入入口后删本白名单;若确认不做,应删除而非续挂。
      "ignore": ["src/components/TabBar.tsx"]
    }
  }
}
/* ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠ */
