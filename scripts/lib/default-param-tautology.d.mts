/**
 * `default-param-tautology.mjs` 的类型声明 —— 只覆盖"字符串进、结构出"这一组真实存在的导出。
 *
 * 为什么需要这份文件:判据"带默认值的形参被当存在性判据"只许有一份实现(§22c / 守门 118 同条),
 * 而 TS 侧的常驻测试要复用它就会撞 TS7016(无声明文件的 JS 模块隐式 any)—— 补声明是
 * "消除各测试自己再写一个扫描器"这条漂移路径的最小动作。同一做法见 `code-mask.d.mts`。
 */
export interface DefaultParamTautologyHit {
  /** 命中所在行(1 起,遮罩等长所以与被审原文行号一致) */
  line: number
  /** 被误当存在性判据的形参名 */
  name: string
  /** 该行去掉首尾空白后的文本,只用于让人一眼定位 */
  snippet: string
}

export interface MaskCodeOptions {
  /** 默认 true:连字符串一起遮。认"形参带没带默认值"时必须传 false(默认值就是字符串字面量)。 */
  maskStrings?: boolean
}

export declare function maskCode(src: string, opts?: MaskCodeOptions): string

export declare function findDefaultParamTautologies(src: string): DefaultParamTautologyHit[]
