{
  "$schema_version": 1,
  "_comment": "IHUI-AI dev 服务端口 + 命令注册表(与 docs/port-management.md §2 同步)。start-dev.ps1 读取此表按需启动 8 端。修改时同步更新 docs/port-management.md。",
  "services": {
    "web": {
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/web", "dev"],
      "cwd": "apps/web",
      "port": 8801,
      "health": "http://localhost:8801",
      "timeout_sec": 60
    },
    "api": {
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/api", "dev"],
      "cwd": "apps/api",
      "port": 8802,
      "health": "http://localhost:8802/api/health",
      "timeout_sec": 120
    },
    "ai-service": {
      "cmd": "uv",
      "args": ["run", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8803"],
      "cwd": "apps/ai-service",
      "port": 8803,
      "health": "http://localhost:8803/health",
      "timeout_sec": 240
    },
    "miniapp-taro": {
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/miniapp-taro", "dev:h5"],
      "cwd": "apps/miniapp-taro",
      "port": 8804,
      "health": "http://localhost:8804",
      "timeout_sec": 90
    },
    "mobile-rn": {
      "_note": "本表 8805 仅对应仓库 start 脚本(expo --port 8805);手机 dev client 实际指向 8081(RN 默认),scripts/dev-stack.mjs --device 显式以 8081 启 Metro 并 adb reverse 转发到手机。详见 docs/port-management.md §5。",
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/mobile-rn", "start"],
      "cwd": "apps/mobile-rn",
      "port": 8805,
      "health": "http://localhost:8805/status",
      "timeout_sec": 90
    },
    "desktop": {
      "_note": "tauri dev 不自占端口:beforeDevCommand 自起 web(8801),devUrl 指向 localhost:8801。port=8801 仅用于冲突检测+探活,禁止与 web 同组启动(next dev 会端口冲突)。首次 cargo 编译约 10 分钟,timeout 给 900s。需 cargo 在 PATH(见 start-dev.ps1 自动注入)。",
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/desktop", "dev"],
      "cwd": "apps/desktop",
      "port": 8801,
      "health": "http://localhost:8801",
      "timeout_sec": 900
    },
    "extension": {
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/extension", "dev"],
      "cwd": "apps/extension",
      "port": 8808,
      "health": null,
      "timeout_sec": 60
    },
    "prod-proxy": {
      "_note": "网页预览(mobile-rn Expo web :8806)连生产专用:CORS 注入反代,127.0.0.1:8807 → https://aizhs.top。由 scripts/dev-stack.mjs 作为可选服务托管(prod-proxy),node scripts/dev-prod-proxy.mjs。头注见脚本。",
      "cmd": "node",
      "args": ["scripts/dev-prod-proxy.mjs"],
      "cwd": ".",
      "port": 8807,
      "health": "http://localhost:8807/api/health",
      "timeout_sec": 30
    },
    "web-preview": {
      "_note": "浏览器打开手机 App(mobile-rn 同一套代码走 react-native-web),由 scripts/dev-stack.mjs 作为可选服务托管(web-preview)。EXPO_PUBLIC_API_BASE_URL 须覆盖为 http://localhost:8807(prod-proxy),否则继承本机用户级生产域名而被浏览器 CORS 拦死。",
      "cmd": "node",
      "args": ["node_modules/expo/bin/cli", "start", "--web", "--port", "8806"],
      "cwd": "apps/mobile-rn",
      "port": 8806,
      "health": "http://localhost:8806",
      "timeout_sec": 120
    },
    "cli": {
      "cmd": "pnpm",
      "args": ["--filter", "@ihui/cli", "dev"],
      "cwd": "apps/cli",
      "port": 8841,
      "health": "http://localhost:8841/health",
      "timeout_sec": 60
    }
  },
  "all": ["web", "api", "ai-service", "miniapp-taro", "mobile-rn", "desktop", "extension", "cli"],
  "default": ["web", "api", "ai-service"],
  "_default_note": "2026-08-07 根治:默认组必须含 ai-service。此前仅 web+api,导致前端 /api/llm/* 代理到 8803 连接失败 → '模型连接失败'反复出现。",
  "port_ranges": {
    "app": [8801, 8809],
    "infra": [8810, 8819],
    "helper": [8820, 8829],
    "saas": [8830, 8839],
    "extension": [8840, 8849]
  }
}
