{
  "version": "2.0",
  "mode": "allowlist-first",
  "description": "v2.0: allowlist-first mode - any dir/file NOT in allowlist AND NOT system is auto-deleted. Eliminates blind spot of v1.0 blacklist-only mode (e.g. guardian-test-allowed was kept because not in blacklist).",
  "allowlist": {
    "dirs": [
      "$RECYCLE.BIN",
      "System Volume Information",
      "IHUI-AI",
      "MuMuPlayer",
      "QoderCN",
      "Qoderwork",
      "Trae CN",
      "TRAE SOLO CN",
      "WeGameApps",
      "WeixinGameData",
      "Yingyongbao",
      "Zcode",
      "微信web开发者工具",
      "支付宝小程序开发工具"
    ],
    "dirPatterns": ["tools", "G:\\\\tools"],
    "files": [],
    "filePatterns": ["desktop.ini", "Thumbs.db", "*.lnk", "*.url"]
  },
  "blacklist": {
    "dirs": [
      "platforms",
      "iconengines",
      "imageformats",
      "styles",
      "bearer",
      "translations",
      "CA",
      "cert",
      "WXCertUtil",
      "rail_user_data",
      ".pnpm-store",
      "tmp",
      "ai_zhs",
      ".appdata",
      "c",
      "nonexistent-root",
      "guardian-test-allowed"
    ],
    "files": [
      "Qt5Core.dll",
      "Qt5Gui.dll",
      "Qt5Network.dll",
      "Qt5Svg.dll",
      "Qt5Widgets.dll",
      "D3Dcompiler_47.dll",
      "libEGL.dll",
      "libGLESv2.dll",
      "opengl32sw.dll",
      "libeay32.dll",
      "ssleay32.dll",
      "libgcc_s_dw2-1.dll",
      "libstdc++-6.dll",
      "libwinpthread-1.dll",
      "msvcp120.dll",
      "msvcr120.dll",
      "quazip.dll",
      "quazip.lib",
      "quazipd.dll",
      "quazipd.lib",
      "zdll.lib",
      "zlib.def",
      "zlib1.dll"
    ],
    "patterns": [
      "Qt5*.dll",
      "lib*.dll",
      "msvc*.dll",
      "_tmp_*",
      "tmp_*",
      "tmp-*.log",
      "tmp_head.*",
      "tmp_config_*.py",
      ".tmp-edit-*",
      "微信支付*证书工具*.exe"
    ]
  },
  "heuristic": {
    "description": "Auto-delete if matches these garbage signatures even if not in blacklist",
    "dirSignatures": [
      "guardian-test-*",
      "test-*",
      "debug-*",
      "tmp_*",
      "_tmp_*",
      "search_*",
      "ihui-*"
    ],
    "fileSignatures": [
      "search_*.ps1",
      "*_result.txt",
      "tmp_*.ps1",
      "ihui-*.ps1",
      "test_*.ps1",
      "debug_*.txt",
      "cleanup*.ps1",
      "fix_*.ps1",
      "migrate*.ps1",
      "scan_*.ps1",
      "*_output.txt",
      "*_list.txt",
      "commit_msg*.txt",
      "commit-msg*.txt"
    ]
  },
  "systemProtected": {
    "dirs": [
      "$RECYCLE.BIN",
      "System Volume Information",
      "Documents and Settings",
      "Program Files",
      "Program Files (x86)",
      "ProgramData",
      "Users",
      "Windows"
    ],
    "description": "These system dirs are never deleted even if somehow appears (defensive)"
  }
}
