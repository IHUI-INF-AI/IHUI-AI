<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/06/tasks">
  <RegistrationInfo>
    <Date>2026-10-27</Date>
    <Author>Administrator</Author>
    <Description>自动隐藏微信 taskbarpins 辅助窗口 (WxTrayIconMessageWindow)，防止黑窗弹出。零侵入、可逆、随登录自启。</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>Administrator</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfLoggedOn>true</RunOnlyIfLoggedOn>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\Administrator\.workbuddy-ai\binaries\python\versions\3.13.12\pythonw.exe</Command>
      <Arguments>"D:\IHUI-AI\scripts\wechat-traywatch\traywatch.py"</Arguments>
    </Exec>
  </Actions>
</Task>
