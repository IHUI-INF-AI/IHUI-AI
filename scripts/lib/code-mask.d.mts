/**
 * `code-mask.mjs` 的类型声明 —— **只覆盖"字符串进、字符串出"的那一组**,其余导出
 * (`scanSpans` / `scanLiterals` / `maskedSpans` / `blankByMask` / `regexCanStart`)返回的是
 * 内部 span 结构,没有真实类型可写,宁可让 TS 侧看不见,也不写一份会骗人的形状。
 *
 * 为什么需要这份文件:本仓多条判据(守门 131 / 135 与镜像测试)规定"剥注释/遮字符串的实现
 * 只许有一份",而 TS 侧的测试要复用同一份实现就会撞上 TS7016(无声明文件的 JS 模块隐式 any)。
 * 补声明是消除"各测试自己再写一个注释剥离器"这条漂移路径的最小动作。
 */
export declare function maskComments(src: string): string
export declare function maskCommentsAndStrings(src: string): string
export declare function maskCommentsStringsAndRegex(src: string): string
export declare function blankStrings(text: string): string
