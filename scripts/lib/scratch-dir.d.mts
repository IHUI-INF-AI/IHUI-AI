// scratch-dir.mjs 的类型声明。与该 .mjs 实现逐成员对应,只描述真实签名,不放大成 any。
// 存在理由:apps/cli 的 tsconfig.tests.json 把 tests 纳入程序,而 tests 直接按相对路径 import
// 本目录下的 .mjs 夹具支持层;无声明时 TS7016(隐式 any),等于把夹具落点约定整块失去检查。

export const SCRATCH_DIR_NAME: 'ihui-scratch'

export const NEST_SCAN_DEFAULTS: { maxDepth: number; entryBudget: number }

export interface NestedScratchHit {
  path: string
  depth: number
}

export interface NestedScratchScan {
  hits: NestedScratchHit[]
  scannedEntries: number
  truncated: boolean
  unreadable: string[]
  skippedReparse: number
}

export interface ScanForNestedScratchRootOptions {
  maxDepth?: number
  entryBudget?: number
}

export interface ChooseScratchRootOptions {
  moduleDir?: string
  platform?: NodeJS.Platform
  env?: NodeJS.ProcessEnv
}

export type GitFaceEscapeResult =
  | { state: 'measured'; escapes: boolean; top: string | null }
  | { state: 'undetermined'; why: string }

export interface EvaluateDeleteTargetInput {
  target: string
  scratchRoot?: string
  isReparseTarget?: boolean
  nested?: NestedScratchScan | null
}

export interface RmScratchOptions {
  skipNestedScan?: boolean
  nestedScan?: ScanForNestedScratchRootOptions
  bestEffort?: boolean
}

export function chooseScratchRoot(opts?: ChooseScratchRootOptions): string
export function scratchRoot(): string
export function countScratchSegments(p: string): number
export function scanForNestedScratchRoot(dir: string, opts?: ScanForNestedScratchRootOptions): NestedScratchScan
export function evaluateDeleteTarget(input: EvaluateDeleteTargetInput): string | null
export function isAllowedScratchRoot(root: string): boolean
export function gitFaceEscapesToRepo(
  dir: string,
  opts?: { repoRoot?: string; spawn?: typeof import('node:child_process').spawnSync },
): GitFaceEscapeResult
export function mkScratch(prefix: string): string
export function rmScratch(dir: string, opts?: RmScratchOptions): void
