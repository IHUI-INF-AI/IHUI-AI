{
  "domain": "plan",
  "unitScreen": "Plan",
  "newFiles": [
    "packages/app/src/features/plan/plan-styles.ts",
    "packages/app/src/features/plan/plan-store-core.ts",
    "packages/app/src/features/plan/plan-version-core.ts",
    "packages/app/src/features/plan/PlanListScreen.tsx",
    "packages/app/src/features/plan/PlanFormScreen.tsx",
    "packages/app/src/features/plan/PlanDetailScreen.tsx",
    "apps/mobile-rn/src/screens/PlanScreen.tsx",
    "apps/mobile-rn/src/screens/PlanDetailScreen.tsx",
    "apps/mobile-rn/src/screens/PlanNewScreen.tsx"
  ],
  "newFilesNote": "9 个文件全部新建,零既有文件改动(共享文件禁改清单全部未触碰;web plan 域纯 localStorage 无后端,packages/api-client 与 apps/api 不动)。store 单例 rnPlanStore 与 AsyncStorage 适配器 rnPlanStorage 由 apps/mobile-rn/src/screens/PlanScreen.tsx 模块级导出,PlanDetailScreen/PlanNewScreen 薄壳 import 自 './PlanScreen'(三壳共享一份内存态,与 web zustand 单例同语义);集成方落 RootNavigator 时注意 PlanScreen.tsx 同时是路由组件与单例宿主。持久化键 'ihui-plans' 与 'ihui-plan-versions:<planId>' 及 JSON 形态与 web 端(zustand persist / plan-version-history.ts)完全同形,数据可互读。",
  "indexExports": [
    "export { PlanListScreen } from './features/plan/PlanListScreen'",
    "export type { PlanListScreenProps, PlanListRow, PlanFilterValue } from './features/plan/PlanListScreen'",
    "export { PlanFormScreen } from './features/plan/PlanFormScreen'",
    "export type { PlanFormScreenProps, PlanFormValues, PlanStepDraft } from './features/plan/PlanFormScreen'",
    "export { PlanDetailScreen } from './features/plan/PlanDetailScreen'",
    "export type { PlanDetailScreenProps } from './features/plan/PlanDetailScreen'",
    "export { createPlanLocalStore, generateId, computePlanStats } from './features/plan/plan-store-core'",
    "export type { PlanStorage, PlanLocalStore, PlanLocalStoreOptions } from './features/plan/plan-store-core'",
    "export { snapshotPlan, signatureOf, shouldRecordVersion, appendVersion, diffPlanVersions, planVersionStorageKey, isValidVersionSnapshot, PLAN_VERSION_STORAGE_PREFIX, PLAN_VERSION_MAX_KEPT } from './features/plan/plan-version-core'",
    "export type { PlanVersionSnapshot, PlanVersionStepSnapshot, PlanStepChange, PlanStepChangeKind, PlanStepFieldKey, PlanVersionDiffResult, PlanVersionDiffSummary } from './features/plan/plan-version-core'"
  ],
  "navigator": {
    "import": [
      "import { PlanScreen } from '../screens/PlanScreen'",
      "import { PlanDetailScreen } from '../screens/PlanDetailScreen'",
      "import { PlanNewScreen } from '../screens/PlanNewScreen'"
    ],
    "param": [
      "  Plan: undefined",
      "  PlanDetail: { id: string }",
      "  PlanNew: undefined"
    ],
    "screen": [
      "<RootStack.Screen name=\"Plan\" component={PlanScreen} />",
      "<RootStack.Screen name=\"PlanDetail\" component={PlanDetailScreen} />",
      "<RootStack.Screen name=\"PlanNew\" component={PlanNewScreen} />"
    ]
  },
