+      if (ok) saveMut.mutate({ id: row.id, proxyUrl: null })
+    })
+  }
+
+  return (
+    <div className="space-y-4 px-4 py-4">
+      <BackButton />
+      <div className="flex items-end justify-between">
+        <div>
