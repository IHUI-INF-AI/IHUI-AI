{
  "domain": "agents-edit + agents-my + subagents-detail",
  "wave": "wave3-q9",
  "unitScreen": "agents/edit/[id] + agents/my + subagents/detail",
  "newFiles": [
    "packages/api-client/src/endpoints/agents-edit.ts",
    "packages/app/src/features/agent-edit/AgentEditScreen.tsx",
    "apps/mobile-rn/src/screens/AgentEditScreen.tsx",
    "packages/api-client/src/endpoints/agents-my.ts",
    "packages/app/src/features/my-agents/MyAgentsScreen.tsx",
    "apps/mobile-rn/src/screens/MyAgentsScreen.tsx",
    "packages/api-client/src/endpoints/subagents-detail.ts",
    "packages/app/src/features/subagent-detail/SubagentDetailScreen.tsx",
    "apps/mobile-rn/src/screens/SubagentDetailScreen.tsx"
  ],
  "indexExports": [
    "export { AgentEditScreen } from './features/agent-edit/AgentEditScreen'",
    "export type { AgentEditFormState, AgentEditCategoryOption, AgentEditScreenProps } from './features/agent-edit/AgentEditScreen'",
    "export { MyAgentsScreen } from './features/my-agents/MyAgentsScreen'",
    "export type { MyAgentRowView, MyAgentsScreenProps } from './features/my-agents/MyAgentsScreen'",
    "export { SubagentDetailScreen } from './features/subagent-detail/SubagentDetailScreen'",
    "export type { SubagentDetailHeaderView, SubagentQuotaBarView, SubagentMessageView, SubagentDetailScreenProps } from './features/subagent-detail/SubagentDetailScreen'"
  ],
  "apiClientIndexExports": [
    "export * from './endpoints/agents-edit.js'",
    "export * from './endpoints/agents-my.js'",
    "export * from './endpoints/subagents-detail.js'"
  ],
  "apiClientIndexNote": "需在 packages/api-client/src/index.ts 追加上述 re-export，否则三枚薄壳 import 报「无此导出」。既有 endpoints/agent.ts(GET /api/agents、GET /api/agents/:id) 与 endpoints/subagents.ts(active/cancel/resume) 是不同数据面，已复用未重写。",
  "navigator": [
    {
      "import": "import { AgentEditScreen } from '../screens/AgentEditScreen'",
      "param": "  AgentEdit: { id: string }",
      "screen": "<RootStack.Screen name=\"AgentEdit\" component={AgentEditScreen} />"
    },
    {
      "import": "import { MyAgentsScreen } from '../screens/MyAgentsScreen'",
      "param": "  MyAgents: undefined",
      "screen": "<RootStack.Screen name=\"MyAgents\" component={MyAgentsScreen} />"
    },
    {
      "import": "import { SubagentDetailScreen } from '../screens/SubagentDetailScreen'",
      "param": "  SubagentDetail: { id: string }",
      "screen": "<RootStack.Screen name=\"SubagentDetail\" component={SubagentDetailScreen} />"
    }
  ],
