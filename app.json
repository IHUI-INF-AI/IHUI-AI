{
  "name": "IHUI-AI",
  "description": "Eight-platform full-stack AI operating system — 176 models unified via MCP + LangGraph orchestration. Apache 2.0 licensed.",
  "repository": "https://github.com/IHUI-INF-AI/IHUI-AI",
  "logo": "https://raw.githubusercontent.com/IHUI-INF-AI/IHUI-AI/main/apps/web/public/images/logo.png",
  "keywords": [
    "ai",
    "llm",
    "mcp",
    "langgraph",
    "agent",
    "rag",
    "nextjs",
    "fastify",
    "fastapi",
    "monorepo"
  ],
  "website": "https://aizhs.top",
  "env": {
    "NODE_ENV": "production",
    "NPM_CONFIG_PRODUCTION": "false",
    "JWT_SECRET": { "generator": "secret" },
    "CREDENTIALS_ENCRYPTION_KEY": { "generator": "secret" },
    "AI_CALLBACK_SECRET": { "generator": "secret" }
  },
  "formation": {
    "web": { "quantity": 1, "size": "free" }
  },
  "addons": ["heroku-postgresql", "heroku-redis"],
  "buildpacks": [{ "url": "heroku/nodejs" }],
  "scripts": {
    "postdeploy": "pnpm --filter @ihui/api db:migrate"
  }
}
