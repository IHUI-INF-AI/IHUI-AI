    {
      "title": "转码延迟 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(business_hls_transcode_seconds_sum{instance=~\"$instance\"}[5m])) / sum(rate(business_hls_transcode_seconds_count{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "{{video_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
