{
  "annotations": {
    "list": []
  },
  "description": "IHUI-AI 缓存监控 (Redis + 应用层缓存)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "返回 AI 总览",
      "type": "link",
      "url": "/d/ihui-ai-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "tags": ["ihui-ai"]
    }
  ],
  "panels": [
    {
      "title": "缓存命中率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(redis_keyspace_hits_total{instance=~\"$instance\"}) / (sum(redis_keyspace_hits_total{instance=~\"$instance\"}) + sum(redis_keyspace_misses_total{instance=~\"$instance\"}))",
          "legendFormat": "命中率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 1
    },
    {
      "title": "内存使用",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(redis_memory_used_bytes{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "内存"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "description": "原来手算 /1024/1024 又把 unit 写成 \"MB\"(Grafana 无此档位,只会原样显示数字);改成给原始字节 + bytes 档位由 Grafana 缩放。",
      "id": 2
    },
    {
      "title": "连接数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(redis_connected_clients{instance=~\"$instance\"})",
          "legendFormat": "连接",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 3
    },
    {
      "title": "Key 数量",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(redis_db_keys{instance=~\"$instance\"})",
          "legendFormat": "Keys",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 4
    },
    {
      "title": "命令速率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(redis_commands_processed_total{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "redis_instantaneous_ops_per_sec 这个指标名不存在(redis_exporter 给的是 redis_commands_processed_total 累计计数)。",
      "id": 5
    },
    {
      "title": "慢命令速率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(redis_commands_slowlog_total{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "redis_slowlog_length 是\"当前慢日志队列长度\"的瞬时量,对它求 rate 语义不对;改用按命令分布的 redis_commands_slowlog_total。",
      "id": 6
    },
    {
      "title": "内存使用趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(redis_memory_used_bytes{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "title": "Key 数量分布 (按实例/DB)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (instance, db) (redis_db_keys{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}-{{db}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "id": 8
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ihui-ai", "domain:cache", "cache", "redis"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(redis_db_keys, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "IHUI-AI 缓存监控",
  "uid": "ihui-ai-cache",
  "version": 1,
  "weekStart": ""
}
