{
  "annotations": {
    "list": []
  },
  "description": "原盘查的 bullmq_* 六个指标全仓无发射点、本机无采集器(台账 scripts/data/grafana-external-metrics.json 已如实记\"队列采集线上未接线\")⇒ 14 条表达式恒 No data。2026-10-17 改指 api 真在发的 business_job_executions_total{job_name,status} 与 business_job_duration_seconds_bucket{job_name,le},这两族本机有 27 个作业名、success/failed/unknown 三态齐备。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "返回 AI 总览",
      "type": "link",
      "url": "/d/ihui-ai-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "tags": ["ihui-ai"]
    }
  ],
  "panels": [
    {
      "title": "任务执行速率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(business_job_executions_total{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "description": "队列深度需要 BullMQ 采集器,本机没有;作业侧真在发的是执行计数(27 个作业名 × success/failed/unknown),按状态给速率。",
      "id": 1
    },
    {
      "title": "在跑作业数 (15m 内有执行)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(count by (job_name) (increase(business_job_executions_total{instance=~\"$instance\"}[15m])))",
          "refId": "A",
          "legendFormat": "作业数"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 2
    },
    {
      "title": "失败任务数 (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(business_job_executions_total{instance=~\"$instance\", status=\"failed\"}[1h]))",
          "refId": "A",
          "legendFormat": "失败"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 3
    },
    {
      "title": "状态未知任务数 (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(business_job_executions_total{instance=~\"$instance\", status=\"unknown\"}[1h]))",
          "refId": "A",
          "legendFormat": "状态未知"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "description": "没有 DLQ 指标;status=\"unknown\" 是\"跑完但没回报结果\"那一族,功能上最接近死信的关注点。",
      "id": 4
    },
    {
      "title": "执行速率 Top 10 (按作业)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "topk(10, sum by (job_name) (rate(business_job_executions_total{instance=~\"$instance\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "title": "处理速度 (jobs/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(business_job_executions_total{instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "总处理速率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "title": "失败率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(rate(business_job_executions_total{instance=~\"$instance\", status=\"failed\"}[5m])) / sum(rate(business_job_executions_total{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "失败率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "分母不 clamp:窗口内没有任何执行时比值取不出来 ⇒ No data。clamp 会把\"没跑作业\"报成\"失败率 0%\",那是两个不同的事实。",
      "id": 7
    },
    {
      "title": "状态未知任务分布 (按作业)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "topk(10, sum by (job_name) (increase(business_job_executions_total{instance=~\"$instance\", status=\"unknown\"}[1h])))",
          "refId": "A",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "BullMQ 侧重试计数本机无采集器;这里给真正能追责的\"作业跑完但状态未回报\"分布。",
      "id": 8
    },
    {
      "title": "延迟分布 (P50/P95/P99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(business_job_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "refId": "A",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(business_job_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "refId": "B",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(business_job_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "refId": "C",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "business_job_duration_seconds_bucket 本机有 278 条序列、le 档位齐备,这三档是真算得出来的。",
      "id": 9
    },
    {
      "title": "作业执行台账 (按作业/状态)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum by (job_name, status) (increase(business_job_executions_total{instance=~\"$instance\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{job_name}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 10
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ihui-ai", "domain:queue", "bullmq"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(business_job_executions_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "IHUI-AI 任务队列监控",
  "uid": "ihui-ai-bullmq",
  "version": 1,
  "weekStart": ""
}
