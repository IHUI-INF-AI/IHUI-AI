{
  "annotations": {
    "list": []
  },
  "description": "监控链路自健康。原 prometheus_scrape_success / grafana_response_time 两个名字全仓无发射点、本机无序列(靠 grafana_/prometheus_ 前缀台账混过静态幽灵门),2026-10-17 改指 up 与 grafana_http_request_duration_seconds_*。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "返回 AI 总览",
      "type": "link",
      "url": "/d/ihui-ai-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "tags": ["ihui-ai"]
    }
  ],
  "panels": [
    {
      "title": "Prometheus 抓取成功率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (sum(up{instance=~\"$instance\"}) / count(up{instance=~\"$instance\"}))",
          "refId": "A",
          "legendFormat": "抓取成功率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 1,
      "description": "抓取成功率的正解是 up(每个目标一条,值 1/0);prometheus_scrape_success 这个指标名不存在。"
    },
    {
      "title": "Grafana 响应时间 (ms)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(grafana_http_request_duration_seconds_sum{instance=~\"$instance\"}[5m])) / sum(rate(grafana_http_request_duration_seconds_count{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "平均响应"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 2
    },
    {
      "title": "Alertmanager 活跃告警数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(alertmanager_alerts{instance=~\"$instance\", state=\"active\"})",
          "refId": "A",
          "legendFormat": "活跃告警"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "id": 3
    },
    {
      "title": "抓取成功率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "100 * avg by (job) (up{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "title": "Grafana 响应时间趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "1000 * sum by (handler) (rate(grafana_http_request_duration_seconds_sum{instance=~\"$instance\"}[5m])) / sum by (handler) (rate(grafana_http_request_duration_seconds_count{instance=~\"$instance\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "id": 5,
      "description": "Grafana 侧可用的分组标签是 handler/method/status_code,没有 endpoint;按 handler 分组。"
    },
    {
      "title": "告警数趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (state) (alertmanager_alerts{instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 6,
      "description": "alertmanager_alerts 上没有 severity 标签(只有 state),原来的 by (severity) 永远聚不出序列。"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ihui-ai", "domain:monitor_health", "monitoring", "health"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(up, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "IHUI-AI 监控系统健康",
  "uid": "ihui-ai-monitor-health",
  "version": 1,
  "weekStart": ""
}
