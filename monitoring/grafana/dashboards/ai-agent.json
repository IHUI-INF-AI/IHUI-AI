        {
          "expr": "sum(rate(llm_fusion_success_total{job=\"ai-service\"}[5m])) / clamp_min(sum(rate(llm_fusion_success_total{job=\"ai-service\"}[5m]) + rate(llm_fusion_failure_total{job=\"ai-service\"}[5m])),0.0001)",
