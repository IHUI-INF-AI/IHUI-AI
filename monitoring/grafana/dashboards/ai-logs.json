      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ai-service\"} |~ \"(?i)fallback\" [15m]))",
          "legendFormat": "降级",
          "refId": "A"
        }
      ],
      "title": "模型降级(fallback,15m 滚动计数)",
