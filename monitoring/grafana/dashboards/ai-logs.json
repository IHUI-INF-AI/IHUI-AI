  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "panels": [],
      "title": "日志吞吐与错误趋势(数据源:Loki / promtail 采集)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 201,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate({job=~\"api|ai-service\"}[$__interval]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "日志速率(按服务)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text" }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 202,
      "description": "AI 错误是突发型(实测 6h 内 4827 行但近 5 分钟 0 行),所以这里用 15 分钟滚动**计数**而不是 rate —— 按每秒速率画低流量机只会看到一条贴地的零线。",
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ai-service\"} |~ \"(?i)error|exception|traceback\" [15m]))",
          "legendFormat": "错误/异常",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"ai-service\"} |~ \"(?i)failed|failure\" [15m]))",
          "legendFormat": "失败",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({job=\"ai-service\"} |~ \"(?i)warning|warn\" [15m]))",
          "legendFormat": "告警",
          "refId": "C"
        }
      ],
      "title": "AI 服务错误/失败/告警(15m 滚动计数)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 203,
