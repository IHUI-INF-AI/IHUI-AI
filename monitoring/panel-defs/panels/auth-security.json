{
  "annotations": {
    "list": []
  },
  "description": "IHUI-AI 认证安全监控 (登录 / JWT / 异常 / 2FA / token 撤销)。给值班:登录/JWT/撤销族本机有真实流量,正常应能看到曲线;'异常登录数'与'2FA 使用率'读到全零 = 计数器活着且确实没发生(健康,不是坏了)。'失败登录 Top10 IP' 的 source_ip 是开放集标签,只有真实失败登录才会把某个 IP 顶上榜,当前榜单全零 = 没有失败登录发生,是事实。判读口径:全零 ≠ 空板 —— 前者是采集正常的零事件,后者才需要查接线;严禁用 clamp 或假标签凑读数。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "返回 AI 总览",
      "type": "link",
      "url": "/d/ihui-ai-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "tags": ["ihui-ai"]
    }
  ],
  "panels": [
    {
      "title": "登录成功率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(ihui_auth_login_success_total{instance=~\"$instance\"}[5m])) / sum(increase(ihui_auth_login_attempt_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "登录成功",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "JWT 签发数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(ihui_auth_jwt_issued_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "JWT/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "异常登录数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(ihui_auth_login_anomaly_total{instance=~\"$instance\"}[1h]))",
          "legendFormat": "异常登录",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "Token 撤销数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(ihui_auth_token_revoked_total{instance=~\"$instance\"}[1h]))",
          "legendFormat": "撤销",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "失败登录 Top10 IP",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "topk(10, sum by (source_ip) (increase(ihui_auth_login_failed_total{instance=~\"$instance\"}[1h])))",
          "legendFormat": "{{source_ip}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "title": "登录成功率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(ihui_auth_login_success_total{instance=~\"$instance\"}[5m])) / sum by (instance) (rate(ihui_auth_login_attempt_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "title": "JWT 签发趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(ihui_auth_jwt_issued_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "异常登录趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(ihui_auth_login_anomaly_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "2FA 使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(ihui_auth_2fa_used_total{instance=~\"$instance\"}[5m])) / sum by (instance) (rate(ihui_auth_login_success_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} 2FA 使用率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ihui-ai", "domain:security", "auth"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(ihui_auth_login_attempt_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "IHUI-AI 认证安全监控",
  "uid": "ihui-ai-auth-security",
  "version": 1,
  "weekStart": ""
}
