# Alertmanager 主配置 — IHUI-AI(告警出口唯一:webhook → alert-bridge → 品牌邮件)
#
# 基础设施告警"到人"只有一条路(AGENTS.md §5e,守门 81 的"品牌邮件单通道"在 AM 侧的落点):
#   Prometheus → Alertmanager → 本文件唯一 receiver(default-webhook)
#     → http://127.0.0.1:9096/alert(alert-bridge,身份去重 + 协议转码)
#     → apps/api/scripts/notify-deploy-failure.ts → 品牌版式邮件(email-templates.ts)→ 运维邮箱
#
# Alertmanager 的原生邮件通道与 IM 群机器人中转 receiver 已全部从模板移除,并且**不可再加回**:
#   scripts/render-alertmanager-config.mjs 的 assertBridgeOnlySurface 对最终产物做结构自校验 ——
#   出现原生邮件配置、IM 旁路特征(钉钉/飞书/企业微信三家的接收器名、host、路径签名,英文 slug
#   与域名形态都算)、route 最终不落 9096 那个 webhook、或产物里重新出现占位符,任一命中即 exit 1。
#   `pnpm alerts:check`(只渲染校验不落盘)与镜像测试
#   scripts/tests/render-alertmanager-config.test.mjs 都会抓到,不依赖"没人去跑渲染器"这种巧合。
#   原生邮件通道发的是无版式纯文本,挂上去等于新开一条绕过品牌层的运维邮件流(用户最初的投诉);
#   IM 中转腿属于已摘除的第三方推送面,不再恢复。
#
# 本文件仍是"渲染前源"(运行实例加载的是渲染落点),但它已不含任何占位符 ——
# 占位符机制当初唯一的服务对象是 SMTP 凭据注入(Alertmanager 不展开 ${VAR},本机 0.34.0 实测),
# 注入对象删除后"渲染"收敛为"结构校验 + 落盘"。若有人再写 ${X},渲染器判红而不是替你注入。
# 渲染产物 monitoring/alertmanager/alertmanager.rendered.yml 不入库:它不含凭据,但生成物入库
# 就是第二份真相(模板改了产物忘重刷的漂移不可见)。渲染器拒绝把它写进任何被 git 跟踪的路径。

global:
  resolve_timeout: 5m

# 静默窗口:夜间维护窗口(每日 00:00-02:00)暂停非 critical 告警推送,避免夜间噪音。
# critical 路由不挂该静默,保障 P0/P1 半夜仍能报警(自保链不断)。
# 需调整维护时间在此修改即可;若需"维护周日全天",再额外追加一个含 weekdays 的区间项。
mute_time_intervals:
  - name: nightly-maintenance
    time_intervals:
      - times:
          - start_time: '00:00'
            end_time: '02:00'
        weekdays: ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']

route:
  receiver: 'default-webhook'
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # critical:直落 bridge,不挂任何静默窗口(半夜的 P0 不许被吞)。
    - matchers: ['severity="critical"']
      receiver: 'default-webhook'
    # warning:直落 bridge(夜间维护窗口静默,维护结束后按 group_interval 聚合补发)。
    - matchers: ['severity="warning"']
      receiver: 'default-webhook'
      mute_time_intervals:
        - nightly-maintenance
    # info:同上,只多一道夜间静默。
    - matchers: ['severity="info"']
      receiver: 'default-webhook'
      mute_time_intervals:
        - nightly-maintenance

receivers:
  # 唯一 receiver。收件人/去重/版式都不在本文件 —— 那是 bridge 与品牌邮件层的职责。
  - name: 'default-webhook'
    webhook_configs:
      - url: 'http://127.0.0.1:9096/alert'
        send_resolved: true
        max_alerts: 0

inhibit_rules:
  # critical 告警抑制同一 alertname + service 的 warning 告警,避免告警风暴
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ['alertname', 'service']

  # ===== 级联抑制(告警名对齐 alerts.yml 的 PostgresDown/RedisDown/ApiDown/AiServiceDown 等)=====
  # 明细见 noise-rules.yml(本文件的 inhibit_rules 段为合并后的可用稿,已同步)
  # 根因覆盖则抑制衍生告警,避免"一个故障多条告警":
  # API 宕机 → 其错误率/响应时间随之失效 → 抑制
  - source_matchers: ['alertname="ApiDown"', 'severity="critical"']
    target_matchers: ['alertname="ApiHighErrorRate"']
    equal: ['instance']
  - source_matchers: ['alertname="ApiDown"', 'severity="critical"']
    target_matchers: ['alertname="ApiSlowResponse"']
    equal: ['instance']
  # AI 服务宕机 → LLM provider 健康告警属衍生 → 抑制
  - source_matchers: ['alertname="AiServiceDown"', 'severity="critical"']
    target_matchers: ['alertname="LlmProviderUnhealthy"']
    equal: ['instance']
  # 说明:PostgresDown/RedisDown/WindowsDiskSpaceLow 当前 alerts.yml 无衍生告警可抑制,
  # 后续新增 PG/Redis 明细指标告警时,再在 noise-rules.yml 按真实 alertname 追加级联。
