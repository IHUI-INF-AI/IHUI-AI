# 数据库迁移专用 Dockerfile(一次性容器)
# 启动时执行 drizzle-kit migrate,完成后退出
#
# 2026-09-10 修复两处:
#  ① node:20-alpine + pnpm@9.15.0 与根 package.json engines(node>=22.13 / pnpm>=11)冲突,
#     `pnpm install` 必挂 ERR_PNPM_UNSUPPORTED_ENGINE → 对齐 CI 口径。
#  ② 原 COPY packages/config/package.json,但 packages/ 下无 config 包 → COPY 必挂。
#     database 包唯一 workspace 依赖是 devDep @ihui/eslint-config(tsconfig 直接继承
#     根 tsconfig.base.json,不需 @ihui/tsconfig),故改为复制 eslint-config。
FROM node:22-alpine AS base
RUN apk add --no-cache tini && npm install -g pnpm@11.18.0
WORKDIR /app

# 仅复制 database 包所需文件(最小化镜像)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
# 根 package.json 的 postinstall 要跑这两个脚本;镜像只 COPY 清单文件,漏了它 pnpm install 必挂
COPY scripts/fix-expo-metro-junction.mjs scripts/
COPY scripts/lib/patch-lint-staged-stdio.mjs scripts/lib/
COPY tsconfig.base.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/eslint-config/package.json ./packages/eslint-config/
RUN pnpm install --frozen-lockfile

# 复制 database 包源码 + 迁移文件
COPY packages/database/src ./packages/database/src
COPY packages/database/tsconfig.json ./packages/database/
COPY packages/database/drizzle ./packages/database/drizzle
COPY packages/database/drizzle.config.ts ./packages/database/

# 切换到 database 包目录,构建后执行迁移
WORKDIR /app/packages/database
RUN pnpm run build

# 2026-11-01 安全强化:迁移是一次性容器,但跑起来仍带着 DATABASE_URL 这枚生产凭据。
# 以 root 运行的意义只有一件事:容器内任意代码执行(依赖被投毒、迁移脚本本身出 bug)
# 直接拿到容器 root —— 而 `db:migrate` 全程只需要**读**镜像里的 sql/ 与 config
# (两处 compose 现读都不给它挂 volume:docker-compose.yml 的 migrate 段、
# deploy/relay-standalone/docker-compose.yml 的 migrate 段,都只有 environment + networks)。
# 用户是**本层自建**而不是借用 base 里的 `node`:与 Dockerfile.api:53 同一形状 ——
# 借用上游镜像的既有账号 = 把"这个 uid 存在"当成事实来依赖,而那是 base  tag 的实现细节。
RUN addgroup --system --gid 1001 migratejs && adduser --system --uid 1001 --gid 1001 migratejs
USER migratejs

# 使用 tini 处理信号,确保迁移完成后容器正确退出
ENTRYPOINT ["/sbin/tini", "--"]
# drizzle-kit migrate 读取 drizzle.config.ts + DATABASE_URL 环境变量
CMD ["pnpm", "run", "db:migrate"]
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠
