# 供应链安全:当前用 tag pinning(node:22-alpine),生产部署前应改为 digest pinning:
#   docker pull node:22-alpine
#   docker inspect --format='{{index .RepoDigests 0}}' node:22-alpine
#   替换下面 FROM 行为:FROM node:22-alpine@sha256:<digest>
#
# 2026-09-10 修复:原为 node:20-alpine + pnpm@9.15.0,与根 package.json
#   engines.node >=22.13.0 / engines.pnpm >=11.0.0 冲突 → docker build 在
#   `pnpm install` 阶段必挂 ERR_PNPM_UNSUPPORTED_ENGINE。现对齐 CI 口径。
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@11.18.0

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/web/package.json ./apps/web/
# 复制 @ihui/web 的 workspace 传递闭包(原清单引用了不存在的 packages/config、packages/ui、
# packages/ui-primitives,且遗漏 app/i18n/ui-react/tsconfig → docker build 必挂,2026-09-10 修正)。
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/auth/package.json ./packages/auth/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/i18n/package.json ./packages/i18n/
COPY packages/shared/package.json ./packages/shared/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/types/package.json ./packages/types/
COPY packages/ui-react/package.json ./packages/ui-react/
# apps/web 的 postinstall(node scripts/copy-monaco-to-public.mjs)在 deps 阶段即执行,
# 只装 package.json 缺该脚本必挂 Cannot find module(2026-09-10)
COPY apps/web/scripts ./apps/web/scripts/
# --no-frozen-lockfile: 允许安装 package.json 中新增的 @lobehub/icons 依赖
RUN pnpm install --no-frozen-lockfile

FROM base AS builder
WORKDIR /app
# 复制 deps 阶段整个 /app(含所有 workspace 包的 node_modules + package.json)
# .dockerignore 已排除本地 node_modules,后续 COPY . . 不会覆盖
COPY --from=deps /app/ ./
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# 构建期固化 rewrites 代理地址为 Docker 内网地址(next.config.ts rewrites 在 build 时求值)
ENV API_URL=http://api:8802
ENV AI_SERVICE_URL=http://ai-service:8803
# next build 需要大内存(默认 ~2GB 会 OOM);4096 仍会 OOM,恢复到 8192(2026-07-20)
ENV NODE_OPTIONS=--max-old-space-size=16384
# 清理可能残留的 .tsbuildinfo(2026-07-20 修复:避免 tsc 增量编译跳过文件,
# 导致 @ihui/api-client/dist/endpoints 等产物缺失,引发 next build 模块解析失败)
RUN find packages apps -name "*.tsbuildinfo" -type f -delete 2>/dev/null || true
# --filter @ihui/web... :先 build @ihui/web 的所有 workspace 依赖(@ihui/ui-react / @ihui/design-tokens / @ihui/api-client 等),再 build web
RUN pnpm --filter @ihui/web... run build

# A 套壳架构(2026-07-24):output:'export' 静态导出,nginx 提供静态文件 + API 反向代理
# 替代原 standalone + node server.js 方案,因为 output:'export' 不生成 server.js
# 供应链安全:当前用 tag pinning(nginx:1.27-alpine),生产部署前应改为 digest pinning:
#   docker pull nginx:1.27-alpine
#   docker inspect --format='{{index .RepoDigests 0}}' nginx:1.27-alpine
#   替换下面 FROM 行为:FROM nginx:1.27-alpine@sha256:<digest>
FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html
# 复制静态导出产物(out/ 已包含 public/ 内容,Next.js export 时自动合并)
COPY --from=builder /app/apps/web/out/ ./
# nginx 配置:静态文件 + API/AI-service 反向代理(替代 next rewrites,output:export 不支持 rewrites)
COPY deploy/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 8801
CMD ["nginx", "-g", "daemon off;"]
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠
