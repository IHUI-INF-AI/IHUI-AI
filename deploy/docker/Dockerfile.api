# [IHUI-AI-PROVENANCE]:⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠

# 供应链安全:当前用 tag pinning(node:22-alpine),生产部署前应改为 digest pinning:
#   docker pull node:22-alpine
#   docker inspect --format='{{index .RepoDigests 0}}' node:22-alpine
#   替换下面 FROM 行为:FROM node:22-alpine@sha256:<digest>
#
# 2026-09-10 修复:原为 node:20-alpine + pnpm@9.15.0,与根 package.json
#   engines.node >=22.13.0 / engines.pnpm >=11.0.0 冲突 → docker build 在
#   `pnpm install` 阶段必挂 ERR_PNPM_UNSUPPORTED_ENGINE(Node v20.20.2 / pnpm 9.15.0)。
#   现对齐 CI 口径(ci-monorepo.yml: NODE_VERSION=22 / PNPM_VERSION=11.18.0)。
FROM node:22-alpine AS base
RUN npm install -g pnpm@11.18.0

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/api/package.json ./apps/api/
# 仅复制 @ihui/api 的 workspace 传递闭包(pnpm frozen-lockfile 容忍"缺失项目",
# 只需在场项目的 specifier 与锁文件一致)。原清单引用了不存在的 packages/config,
# 且遗漏 api-client/context-compaction/design-tokens/shared → docker build 必挂(2026-09-10 修正)。
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/auth/package.json ./packages/auth/
COPY packages/context-compaction/package.json ./packages/context-compaction/
COPY packages/database/package.json ./packages/database/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/types/package.json ./packages/types/
# node-pty(apps/api 依赖)需 node-gyp 原生编译:alpine 缺 python3/make/g++ 必挂 gyp ERR(2026-09-10)
RUN apk add --no-cache python3 make g++
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
# 复制 deps 阶段整个 /app(含所有 workspace 包的 node_modules + package.json)
# .dockerignore 已排除本地 node_modules,后续 COPY . . 不会覆盖
COPY --from=deps /app/ ./
COPY . .
# 用 ... 递归构建 @ihui/api 及其 workspace 依赖(@ihui/database/@ihui/auth/@ihui/types 等)
RUN pnpm --filter @ihui/api... run build

# 供应链安全:同 base 阶段,生产部署前应改为 digest pinning(见顶部注释)
# runner 与 deps 同为 node:22:node-pty 原生模块按 Node ABI 编译,20/22 混用必崩;
# 且 engines.node>=22.13.0 对齐(2026-09-10)
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 apijs
# 创建 uploads 目录(@fastify/static 注册时验证 root 存在)
RUN mkdir -p /app/uploads && chown apijs:nodejs /app/uploads
# 复制 api 应用代码
COPY --from=builder --chown=apijs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=apijs:nodejs /app/apps/api/package.json ./apps/api/package.json
# 复制根 node_modules(api 的直接依赖)和 api 的 node_modules
COPY --from=builder --chown=apijs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=apijs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
# 复制 workspace 依赖包(@ihui/database/@ihui/auth/@ihui/types)
# Node.js 解析 workspace 包时需要 packages/<name>/package.json + dist + node_modules
COPY --from=builder --chown=apijs:nodejs /app/packages ./packages
# 复制 docs/ 目录(feature-center.ts 运行时直读工程文档,2026-07-22 立)
COPY --from=builder --chown=apijs:nodejs /app/docs ./docs
USER apijs
EXPOSE 8802
CMD ["node", "apps/api/dist/index.js"]
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠
