# =============================================================================
# IHUI-AI 生产环境配置 — 部署包模板
# =============================================================================
# 用法:
#   1. cp .env.production.template .env.production
#   2. 跑 gen-secrets.ps1 / gen-secrets.sh 自动生成所有 <AUTOGEN-*> 占位符
#      或者手动用注释里的命令逐个生成
#   3. 从开发机 .env 拷贝真实 LLM key / 支付证书 / OAuth 凭证
#   4. (可选)从 Cloudflare 后台 rotate tunnel token,填到 TUNNEL_TOKEN
#   5. docker compose up -d
#
# 安全规则:
#   - .env.production 已被 .gitignore 忽略,禁止 commit
#   - 真实密钥只允许出现在 .env.production,不允许写入 .env.production.example
#   - 部署完成后立即改 admin 密码 + rotate Cloudflare Tunnel token
# =============================================================================

# ==================== 基础(必填) ====================
DOMAIN=aizhs.top
APP_TITLE=智汇AI社区
NODE_ENV=production
# 前端端口(docker-compose web 服务映射到宿主,Cloudflare Tunnel ingress 指向此端口)
WEB_PORT=8801
# API/AI Service 容器内端口(不变,见 docs/port-management.md §2.5)
# 仅 web 端口映射到宿主 8801,api/ai-service 通过 docker network 内部解析

# ==================== 数据库(必填,密码必须强随机 ≥ 16 字符) ====================
DB_USER=ihui
# 生成命令:node -e "console.log(require('crypto').randomBytes(24).toString('base64').slice(0,24))"
DB_PASSWORD=<AUTOGEN-DB-PASSWORD>
DB_NAME=ihui
# 完整连接 URL(docker-compose 自动拼接,不需要手动填,留空即可)
# DATABASE_URL=postgres://ihui:<DB_PASSWORD>@db:5432/ihui

# ==================== Redis(必填,密码必须强随机 ≥ 16 字符) ====================
# 生成命令:node -e "console.log(require('crypto').randomBytes(24).toString('base64').slice(0,24))"
REDIS_PASSWORD=<AUTOGEN-REDIS-PASSWORD>

# ==================== 认证加密(必填,必须 ≥ 32 字符) ====================
# JWT 密钥(用于签发用户登录 token)
# 生成命令:node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<AUTOGEN-JWT-SECRET>
JWT_EXPIRES_IN=7d

# 凭证加密密钥(用于加密第三方 OAuth 凭证等敏感数据,AES-256-GCM)
# 生成命令:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=<AUTOGEN-CREDENTIALS-KEY>

# AI 回调共享密钥(ai-service 回调 /api/ai/callback 需带 X-Internal-Secret 头)
# 生成命令:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CALLBACK_SECRET=<AUTOGEN-AI-CALLBACK-SECRET>

# 服务间 JWT 认证(ai-service ↔ api 之间)
# 生成命令:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_MESH_JWT_SECRET=<AUTOGEN-SERVICE-MESH-JWT>

# 审计日志 HMAC 链(防篡改)
# 生成命令:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_LOG_HMAC_SECRET=<AUTOGEN-AUDIT-HMAC>

# Swagger UI 访问 API Key(如开启 Swagger 必填)
# 生成命令:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWAGGER_API_KEY=<AUTOGEN-SWAGGER-KEY>
SWAGGER_ENABLED=false

# ==================== CORS / Cookie 域(分域 SSO 架构) ====================
CORS_ORIGIN=https://aizhs.top
COOKIE_DOMAIN=.aizhs.top

# ==================== Cloudflare Tunnel(内网穿透,必填) ====================
# 真实 token 在 deploy/prod-bundle/cloudflared/TUNNEL_TOKEN.local.txt(本地保留,不进 git)
# 部署时把 token 粘贴到下面字段
# 部署完成后建议立即 rotate:https://one.dash.cloudflare.com → Networks → Tunnels → ihui-local → Rotate token
TUNNEL_TOKEN=<PASTE-YOUR-TUNNEL-TOKEN-HERE>
# Tunnel ID(从 token 解码出来,用于 cloudflared config.yml 备选模式)
# 解码命令:echo $TUNNEL_TOKEN | cut -d. -f2 | base64 -d 2>/dev/null | jq -r .t
TUNNEL_ID=e675929a-f6f0-4893-927e-4c823f9724e0
# Cloudflare Account ID(从 token 解码)
CF_ACCOUNT_ID=48dcd50724b5fed21e8dd6dcdc63ab01

