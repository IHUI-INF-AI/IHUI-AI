# relay-standalone 单机档环境变量(O70)
# 用法:复制为 .env 并逐项填写;必填项留空时 compose 直接拒绝启动(不会带默认弱值跑起来)。

# ── 数据库 ────────────────────────────────────────────────────────────────────
DB_USER=ihui
DB_NAME=ihui
# ≥16 字符
DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── 应用密钥(三项都必须 ≥32 字符随机串)─────────────────────────────────────
# 生成示例:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
AI_CALLBACK_SECRET=

# ── 入口门(唯一对外凭据)────────────────────────────────────────────────────
# 至少 32 字符;访问面板:http://<host>:7864/?key=<RELAY_STANDALONE_KEY>
RELAY_STANDALONE_KEY=
RELAY_STANDALONE_PORT=7864
# 面板对外地址(CORS 用);默认 http://localhost:7864
RELAY_STANDALONE_ORIGIN=http://localhost:7864

# ── 可选 ─────────────────────────────────────────────────────────────────────
# 单机档默认不含 ai-service(签到 / 任务自动化需要它);接入时填其内网地址
AI_SERVICE_URL=http://ai-service:8803
# ⁠​‌​​‌​​‌‍‍​‌​​‌​​​‍‍​‌​‌​‌​‌‍‍​‌​​‌​​‌‍‍​​‌​‌‌​‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌​​‌‌‌‌​‌​‍‍‌‌​‌‌​​​‌​​​‌‌‌‍‍​‌​​​​​‌‍‍​‌​​‌​​‌‍‍‌​‌‌​‌‌‌‍‍‌‌​​‌‌‌​‌​​‌‌‌​‍‍‌‌​​‌‌​​​‌​​‌​‌‍‍‌​‌‌‌​‌‌‌​‌‌‌​‌‍‍‌​‌‌​‌‌‌‍‍​‌​​‌‌​​‍‍​‌​​​​‌‌‍‍‌​‌‌​‌‌‌‍‍​‌‌​​​​‌‍‍​‌‌​‌​​‌‍‍​‌‌‌‌​‌​‍‍​‌‌​‌​​​‍‍​‌‌‌​​‌‌‍‍​​‌​‌‌‌​‍‍​‌‌‌​‌​​‍‍​‌‌​‌‌‌‌‍‍​‌‌‌​​​​‍‍‌​‌‌​‌‌‌‍‍​‌​‌​​​​‍‍​‌​‌​​‌​‍‍​‌​​‌‌‌‌‍‍​‌​‌​‌‌​‍‍​‌​​​‌​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​​‌‍‍​‌​​‌‌‌​‍‍​‌​​​​‌‌‍‍​‌​​​‌​‌‍‍​​‌​‌‌​‌‍‍​​‌‌​​‌​‍‍​​‌‌​​​​‍‍​​‌‌​​‌​‍‍​​‌‌​‌‌​⁠
