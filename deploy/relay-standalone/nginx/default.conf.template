# relay-standalone 入口门(O70)
#
# 唯一对外监听 7864(对标对面 7864/panel 的形态)。门 = RELAY_STANDALONE_KEY:
#   - 请求头 X-Relay-Key: <key>
#   - Cookie relay_key=<key>(浏览器首次带 ?key=<key> 访问时由下面 Set-Cookie 种下)
#   - 查询串 ?key=<key>(种 cookie 用)
# 三者任一命中即放行;否则 401。db/redis/api/web 都不发布端口,绕过门没有第二条路。
#
# 门挂在四条 location 上,一条都不能漏:
#   /            面板(web:8801)
#   /api/        站内 API(api:8802)
#   /v1          OpenAI 兼容对外出口(api:8802)—— 客户 base_url 打的就是这一条
#   /v1beta      Gemini 协议入站(api:8802)
# 另 /healthz 是门自身探活口(不含业务面)。
#
# 本文件由 nginx 官方镜像的 entrypoint 做 envsubst(只替换已定义环境变量形态),
# ${RELAY_STANDALONE_KEY} 会被替换成实际 key;$http_* / $cookie_* / $arg_* 保持原样。

map $http_x_relay_key $relay_ok_header {
  default 0;
  "${RELAY_STANDALONE_KEY}" 1;
}

map $cookie_relay_key $relay_ok_cookie {
  default 0;
  "${RELAY_STANDALONE_KEY}" 1;
}

map $arg_key $relay_ok_query {
  default 0;
  "${RELAY_STANDALONE_KEY}" 1;
}

map "$relay_ok_header$relay_ok_cookie$relay_ok_query" $relay_allowed {
  default 0;
  "~1" 1;
}

server {
  listen 7864;
  server_name _;
  client_max_body_size 16m;

  # 容器与人工探活口:不放行任何业务面
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain always;
    return 200 "ok\n";
  }

  # 面板(Next.js)
  location / {
    if ($arg_key) {
      add_header Set-Cookie "relay_key=$arg_key; Path=/; HttpOnly; SameSite=Lax" always;
    }
    if ($relay_allowed = 0) {
      add_header Content-Type application/json always;
      return 401 '{"code":401,"message":"relay key required"}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "";
    proxy_pass http://web:8801;
  }

  # API(含账号池 /v1 转发与 SSE 流式)
  location /api/ {
    if ($arg_key) {
      add_header Set-Cookie "relay_key=$arg_key; Path=/; HttpOnly; SameSite=Lax" always;
    }
    if ($relay_allowed = 0) {
      add_header Content-Type application/json always;
      return 401 '{"code":401,"message":"relay key required"}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # SSE / 长回答:不缓冲、不提前断开
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://api:8802;
  }

  # 对外公开 API —— OpenAI 兼容出口(api 侧 prefix '/v':
  # apps/api/src/routes/index.ts 的 v1PublicRoutes / v1AiCoreRoutes / v1MultimodalRoutes /
  # v1KnowledgeToolsRoutes / v1RerankModerationsRoutes / v1ResponsesRoutes / v1Assistants /
  # v1Batches / v1ProtocolCompletenessRoutes,以及 '/v1/anthropic' 一族)
  # 鉴权门与 SSE 参数与上面 /api/ 同纪律:未命中 key ⇒ 401,不缓冲、不提前断开。
  # 前缀匹配下 '/v1beta' 是更长前缀,会被下面那条 location 接走,不与此处争。
  location /v1 {
    if ($arg_key) {
      add_header Set-Cookie "relay_key=$arg_key; Path=/; HttpOnly; SameSite=Lax" always;
    }
    if ($relay_allowed = 0) {
      add_header Content-Type application/json always;
      return 401 '{"code":401,"message":"relay key required"}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # SSE / 长回答:不缓冲、不提前断开
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://api:8802;
  }

  # 对外公开 API —— Gemini 协议入站(api 侧 prefix '/v1beta':
  # generateContent / streamGenerateContent / ListModels)
  location /v1beta {
    if ($arg_key) {
      add_header Set-Cookie "relay_key=$arg_key; Path=/; HttpOnly; SameSite=Lax" always;
    }
    if ($relay_allowed = 0) {
      add_header Content-Type application/json always;
      return 401 '{"code":401,"message":"relay key required"}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # streamGenerateContent 是流式:与 /api/、/v1 同参数
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://api:8802;
  }
}
