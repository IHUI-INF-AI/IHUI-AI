{
  "name": "ihui-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-expo-metro-junction.mjs",
    "dev": "turbo run dev",
    "dev:safe": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:safe:fast": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Fast",
    "dev:safe:status": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Status",
    "dev:safe:stop": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Stop",
    "dev:safe:clean": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Clean -Force",
    "dev:safe:clean:fast": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Clean -Force; pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Fast",
    "dev:safe:all": "pwsh -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -All",
    "warm:routes": "node scripts/warm-dev-routes.mjs",
    "capabilities:export": "pnpm --filter @ihui/api exec tsx scripts/export-capabilities.ts",
    "capabilities:check": "pnpm --filter @ihui/api exec tsx scripts/export-capabilities.ts --check",
    "warm:routes:all": "node scripts/warm-dev-routes.mjs --all",
    "build": "turbo run build",
    "build:desktop:saas": "node scripts/desktop-build-saas.mjs",
    "dev:desktop:saas": "node scripts/desktop-dev-saas.mjs",
    "lint": "turbo run lint",
    "lint:strict": "turbo run lint -- --max-warnings 0",
    "test": "turbo run test",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "node scripts/typecheck-full.mjs",
    "typecheck:full": "node scripts/typecheck-full.mjs",
    "check:staged-typecheck": "node scripts/check-staged-typecheck.mjs",
    "check:provenance": "node scripts/provenance-ledger.mjs",
    "check:exemption-expiry": "node scripts/check-exemption-expiry.mjs --all",
    "check:task-claims": "node scripts/check-task-claims.mjs --check-gate",
    "check:baseline-freshness": "node scripts/check-baseline-freshness.mjs --preflight",
    "check:tool-contract": "node scripts/check-tool-contract-declared.mjs",
    "module:context": "node scripts/module-context.mjs",
    "check:routing-identity": "node scripts/check-tool-arg-routing-identity.mjs",
    "check:tool-arg-validation": "node scripts/check-tool-arg-validation-wired.mjs",
    "check:egress-facts": "node scripts/check-egress-facts.mjs",
    "check:compaction-denominator": "node scripts/check-compaction-denominator.mjs",
    "check:artifact-budget": "node scripts/check-artifact-budget.mjs --target miniapp",
    "check:test-collection": "node scripts/check-test-collection-runs.mjs --strict",
    "check:capabilities": "node scripts/check-capability-catalog.mjs",
    "check:capabilities:staged": "node scripts/check-capability-catalog.mjs --staged",
    "check:pkg-installable": "node scripts/check-pkg-installable.mjs",
    "check:capabilities:self-test": "node scripts/check-capability-catalog.mjs --self-test",
    "check:agent-access": "node scripts/e2e-agent-access.mjs",
    "check:agent-access:live": "node scripts/e2e-agent-access.mjs --live",
    "check:api-key-leak": "node scripts/check-api-key-leak.mjs",
    "check:api-credential-prefix": "node scripts/check-api-credential-prefix.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:api-routes": "node scripts/check-api-routes.mjs",
    "check:api-routes:strict": "node scripts/check-api-routes.mjs --strict",
    "check:api-routes:warn": "node scripts/check-api-routes.mjs --warn-only",
    "check:safe-parse": "node scripts/check-safe-parse.mjs",
    "check:button-wrap:browser": "node scripts/check-button-text-wrap.mjs",
    "check:llm-provider-schema": "node scripts/check-llm-provider-schema.mjs",
    "migrate:llm-providers": "node scripts/migrate-llm-providers.mjs",
    "check:stale-dist": "node scripts/check-stale-dist.mjs",
    "check:dedupe": "node scripts/check-dedupe.mjs",
    "check:db-schema-drift": "node scripts/check-db-schema-drift.mjs",
    "db:drift": "apps\\ai-service\\.venv\\Scripts\\python.exe scripts/db/db_sync.py drift",
    "db:parity": "apps\\ai-service\\.venv\\Scripts\\python.exe scripts/db/db_sync.py parity --fail",
    "db:sync": "apps\\ai-service\\.venv\\Scripts\\python.exe scripts/db/db_sync.py sync --apply",
    "db:mirror": "apps\\ai-service\\.venv\\Scripts\\python.exe scripts/db/db_sync.py mirror --yes",
    "check:migration-from-zero": "node scripts/check-migration-from-zero.mjs",
    "check:sanitizer-bypass": "node scripts/check-sanitizer-bypass.mjs",
    "check:home-junctions": "node scripts/check-home-junctions.mjs",
    "check:nav-dead-links": "node scripts/check-nav-dead-links.mjs",
    "check:popover-trigger-data-state": "node scripts/check-popover-trigger-data-state.mjs",
    "check:rn-parity": "node scripts/check-mobile-rn-style-parity.mjs",
    "check:cross-end-tokens": "node scripts/check-cross-end-tokens.mjs",
    "check:adapter-parity": "node scripts/check-adapter-style-parity.mjs",
    "check:auth-refresh-singleton": "node scripts/check-auth-refresh-singleton.mjs",
    "check:killer-parity-ends": "node scripts/check-killer-parity-ends.mjs",
    "check:conflict-markers": "node scripts/check-no-conflict-markers.mjs",
    "check:all": "pnpm check:conflict-markers && pnpm check:api-key-leak && pnpm check:i18n-keys && pnpm check:stale-dist && pnpm check:db-schema-drift && pnpm check:sanitizer-bypass && pnpm check:api-routes:warn && pnpm check:safe-parse && pnpm check:nav-dead-links && pnpm check:popover-trigger-data-state && pnpm check:miniapp-parity && pnpm check:rn-parity && pnpm check:cross-end-tokens && pnpm check:adapter-parity && pnpm check:killer-parity-ends && node scripts/scan-dead-i18n-keys.mjs --target all --exit 1 && pnpm check:auth-refresh-singleton && node scripts/check-agent-event-parity.mjs && pnpm check:desktop-event-wiring && pnpm check:dep-links:strict && pnpm check:merge-loss && node scripts/check-prod-bundle-shadow.mjs && pnpm check:sdk-publish && pnpm check:artifact-budget",
    "check:dep-links": "node scripts/check-workspace-dep-links.mjs",
    "check:dep-links:strict": "node scripts/check-workspace-dep-links.mjs --strict",
    "check:merge-loss": "node scripts/check-merge-addition-loss.mjs",
    "check:desktop-cache-plaintext": "node scripts/check-desktop-cache-plaintext.mjs",
    "alerts:render": "node scripts/render-alertmanager-config.mjs",
    "alerts:check": "node scripts/render-alertmanager-config.mjs --check",
    "test:alertmanager-config": "node --test scripts/tests/render-alertmanager-config.test.mjs",
    "check:agent-event-parity": "node scripts/check-agent-event-parity.mjs",
    "check:desktop-event-wiring": "node scripts/check-desktop-event-wiring.mjs",
    "knip": "knip",
    "openapi-check": "node scripts/openapi-check.mjs",
    "openapi:export": "pnpm --filter @ihui/api exec tsx scripts/export-openapi.ts",
    "openapi:check-drift": "pnpm openapi:export --out .ihui-agent/tmp/openapi.fresh.json && node scripts/openapi-check.mjs --fresh .ihui-agent/tmp/openapi.fresh.json",
    "miniapp:preview": "node scripts/miniapp-preview.mjs",
    "push:safe": "powershell -ExecutionPolicy Bypass -File scripts/git-push-retry.ps1",
    "cert:fetch": "node scripts/fetch-wechat-platform-cert.mjs",
    "cert:check": "node scripts/cert-expiry-check.mjs",
    "cert:watchdog": "node scripts/cert-renew-watchdog.mjs",
    "cert:status": "node scripts/cert-expiry-check.mjs --json",
    "clean": "turbo run clean && rimraf node_modules",
    "clean:garbage": "node scripts/clean-garbage.mjs",
    "clean:garbage:dry": "node scripts/clean-garbage.mjs --dry-run",
    "clean:garbage:git": "node scripts/clean-garbage.mjs --git",
    "archive": "node scripts/archive-completed-tasks.mjs",
    "hygiene:parent": "node scripts/check-parent-pollution.mjs",
    "hygiene:parent:clean": "node scripts/check-parent-pollution.mjs --auto-clean",
    "hygiene:workspace": "node scripts/check-workspace-hygiene.mjs",
    "tag:sync": "node scripts/sync-lost-commit-tags.mjs --check",
    "tag:sync:check": "node scripts/sync-lost-commit-tags.mjs --check",
    "tag:sync:fetch": "node scripts/sync-lost-commit-tags.mjs --fetch",
    "tag:sync:push": "node scripts/sync-lost-commit-tags.mjs --auto-push",
    "nativewind:status": "node scripts/check-nativewind-status.mjs",
    "check:button-wrap": "node scripts/check-shrinkable-text-button.mjs",
    "footer:guard": "node scripts/check-site-footer.mjs",
    "seo:indexnow": "node scripts/notify-indexnow.mjs",
    "social-preview": "node scripts/generate-social-preview.mjs",
    "guardian:docs": "node scripts/generate-guardian-docs.mjs",
    "sync:downloads": "node scripts/sync-downloads.mjs",
    "sync:downloads:check": "node scripts/sync-downloads.mjs --check",
    "sync:downloads:dry-run": "node scripts/sync-downloads.mjs --dry-run",
    "resolve:desktop-download": "node scripts/resolve-desktop-download.mjs",
    "resolve:desktop-download:check": "node scripts/resolve-desktop-download.mjs --check",
    "resolve:desktop-download:dry-run": "node scripts/resolve-desktop-download.mjs --dry-run",
    "watermark": "node scripts/watermark.mjs inject",
    "watermark:check": "node scripts/watermark.mjs verify",
    "migration:check": "node scripts/check-migration-bookkeeping.mjs",
    "migration:check:db": "node scripts/check-migration-bookkeeping.mjs --db",
    "check:miniapp-parity": "node scripts/check-miniapp-taro-style-parity.mjs",
    "check:sdk-publish": "node --test packages/sdk/tests/publish-ready.test.mjs"
  },
  "author": "李春川 (Li Chunchuan) <IHUI AI (智汇AI)>",
  "contributors": [
    "李春川 (Li Chunchuan)"
  ],
  "homepage": "https://aizhs.top",
  "repository": {
    "type": "git",
    "url": "https://aizhs.top"
  },
  "copyright": "© 2026 IHUI AI (智汇AI) · 李春川 · All rights reserved.",
  "x-ihui-provenance": "IHUI-AI·智汇AI·李春川·LC·aizhs.top·PROVENANCE-2026",
  "overrides": {
    "swiper": "12.1.2",
    "lodash-es": "4.17.24",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "undici": "7.29.0",
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1",
    "html-minifier": "4.0.1",
    "http-cache-semantics": "4.1.1",
    "serialize-javascript": "7.1.0",
    "adm-zip": "0.6.0",
    "glob": "13.0.6",
    "@tiptap/core": "3.30.5",
    "@xmldom/xmldom": "0.9.12",
    "svgo": "3.3.5",
    "nodemailer": "9.1.0",
    "js-yaml@^3.0.0": "3.15.2"
  },
  "dependencies": {},
  "devDependencies": {
    "@ihui/eslint-config": "workspace:^",
    "@next/eslint-plugin-next": "^16.0.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^26.0.0",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "opencc-js": "^1.4.1",
    "prettier": "^3.9.6",
    "rimraf": "catalog:",
    "sharp": "0.35.3",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --ignore-pattern '**/migration-final-review/**' --ignore-pattern '**/migration-audit/**' --ignore-pattern '**/migration-audit-report/**' --ignore-pattern '**/public/**' --ignore-pattern '**/e2e/**' --ignore-pattern '**/next-env.d.ts'"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}": "prettier --write"
  }
}
