#!/bin/sh
# ─── GIT_DIR 去污(2026-10-01,5 道守门链内崩实证根治)─────────────
# IDE(Trae)git 扩展向会话注入 GIT_DIR=D:/IHUI-AI-git-repo(worktree 之外的
# gitdir 指针)。守门子进程以 scratch 物化目录为 cwd 跑 git init/add、或对
# gitdir 跑 work-tree 型命令(rev-parse --show-toplevel)时全部报
# "fatal: this operation must be run in a work tree"([152]/[164]/[167]/[168]/[172]
# 链内全灭、单跑全绿的根因)。unset 后 git 从 cwd(worktree 根)经 ./.git
# 指针文件发现同一仓库,语义不变。
#
# ─── GIT_INDEX_FILE 不再无条件清空(2026-11-03 立,根因见下)────────────
# `git commit --only/--amend -- <路径>` 期间,git 会把「只含本次路径的临时索引」
# (<gitdir>/next-index-<pid>.lock,绝对路径)经 GIT_INDEX_FILE 交给钩子,同时父 git
# 持着 .git/index.lock。旧写法把它一起 unset ⇒ lint-staged 落到**共享真实索引**上:
#   git add / git restore --worktree 都要写索引 ⇒ 撞父 git 的 index.lock ⇒ exit 128,
#   并发会话互相堵死;还可能 restore --worktree 掉别人未暂存的改动。
# 判据(与 scripts/lib/hook-git-env.js 同源):指针非空**且文件确实存在** ⇒ 保留;
#   空/陈旧(文件不存在)⇒ 清掉 —— 否则所有 git 命令把它读成空索引,全仓文件都像已暂存。
if [ -z "$GIT_INDEX_FILE" ] || [ ! -f "$GIT_INDEX_FILE" ]; then
  unset GIT_INDEX_FILE
fi

# ─── sh 层机器可读留痕(2026-11-04 立)─────────────────────────────────────
# 本层任何 exit 1 都发生在 node 启动**之前** ⇒ 没有 vbs 轮次标记、没有 pre-commit-rounds.jsonl
# 轮次,失败只剩 git 侧 stderr(实测:别单 `git commit --only -- <7 路径>` 钩子阶段 exit 1,
# pre-commit.log 无 `==== <Now> :: <script> ====`,rounds 无本轮,无 COMMIT_EDITMSG/index.lock)。
# 因此本层所有拒绝路径都必须**先落一行机器可读记录**再 exit。
# ⚠ 该文件必须 ASCII-only:它被 wscript 侧读取,非 ASCII 会在 wscript 编译期报 Syntax error。
#    故这里用 tr 只保留可打印 ASCII(含 TAB),中文/全角字符一律丢弃。
IHUI_MARKER_DIR=.ihui-agent/state/hook-logs
hook_marker() {
  mkdir -p "$IHUI_MARKER_DIR" 2>/dev/null || return 0
  _m_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  printf '{"hook":"pre-commit","stage":"sh","event":"%s","ts":"%s","expected":"%s","got":"%s"}\n' \
    "$1" "$_m_ts" "$2" "$3" \
    | tr -cd '\11\12\15\40-\176' >>"$IHUI_MARKER_DIR/hook-markers.jsonl" 2>/dev/null || true
}

# ─── 私有索引上下文 fail-closed(2026-11-04 立)─────────────────────────────
# 2026-11-03 的修法只保住了"非空且文件存在"的指针,但它对**调用方声明过私有索引**的场景
# 仍然是静默降级:指针空/缺失时照旧 unset ⇒ 整条钩子链(含 lint-staged 与派生腿)落到共享
# 索引。实测后果:门 173 在 278.9s 后 exit 1,只因别的会话在共享索引暂存了 12 个文件。
# 因此 isolated-git 现在额外传 IHUI_EXPECTED_PRIVATE_INDEX(它那份索引的绝对路径):
# 声明在场 ⇒ GIT_INDEX_FILE 必须一字不差且文件可用,否则当场拒绝,绝不退回共享索引。
# 没有声明(普通 `git commit` / `git commit --only`)⇒ 上面的原判据一字不改。
if [ -n "$IHUI_EXPECTED_PRIVATE_INDEX" ]; then
  _idx_norm=$(printf '%s' "$GIT_INDEX_FILE" | tr '\\' '/')
  case "$_idx_norm" in
    */next-index-*.lock)
      # 命中 git 自己为 `--only/--amend -- <路径>` 建的临时索引 ⇒ 这是**共享索引提交**,
      # 不是私有索引提交。此时还挂着 IHUI_EXPECTED_PRIVATE_INDEX,只可能是多会话共享环境变量
      # 造成的泄漏(实测:别单正常 `git commit --only -- <7 路径>` 被这条守卫在 node 启动前
      # 挡掉,且没有任何钩子内痕迹)。留痕后按"无声明"走原判据放行 —— 被挡的语义不属于本守卫。
      hook_marker env-leak-git-temp-index "$IHUI_EXPECTED_PRIVATE_INDEX" "$GIT_INDEX_FILE"
      unset IHUI_EXPECTED_PRIVATE_INDEX
      ;;
  esac
fi
if [ -n "$IHUI_EXPECTED_PRIVATE_INDEX" ]; then
  # 只把分隔符归一(Windows 下 \ 与 / 是同一路径),不做大小写/相对路径放宽。
  want=$(printf '%s' "$IHUI_EXPECTED_PRIVATE_INDEX" | tr '\\' '/')
  got=$(printf '%s' "$GIT_INDEX_FILE" | tr '\\' '/')
  if [ -z "$got" ] || [ "$got" != "$want" ] || [ ! -f "$GIT_INDEX_FILE" ]; then
    # 先留痕再 exit:本层拒绝不经过 node,不落这一行就等于"fail-closed 但无证据"。
    hook_marker index-context-lost "$IHUI_EXPECTED_PRIVATE_INDEX" "${GIT_INDEX_FILE:-}"
    printf '%s\n' "❌ 索引上下文丢失:调用方声明了私有索引($IHUI_EXPECTED_PRIVATE_INDEX),钩子实际拿到的是 '${GIT_INDEX_FILE:-<空>}'。" \
      "   提交已阻止 —— 绝不静默落回共享索引。" >&2
    exit 1
  fi
fi
unset GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH
# ─── Pre-commit 守门薄壳(2026-09-22 弹窗根治) ─────────────────
# 原本逻辑:本文件直接是 node 脚本(#!/usr/bin/env node),由 git 直接启动。
# 病理:git hook 继承触发者的 console 上下文;当 commit 在无 console 的上下文
# (IDE 隐藏持久 shell / GUI git 面板 / safe-commit 等脚本 windowsHide 的
# spawn / WMI watchdog 链)触发时,该 node 进程被 Windows 分配一个**可见**
# 控制台窗口,且因守门项众多存活数分钟 —— 是整条 hook 链最长驻的弹窗源。
# 根治:node 逻辑整体挪至 scripts/lib/pre-commit-hook.js,本薄壳经
#   wscript //nologo scripts/hook-run-hidden.vbs(GUI 子系统 + SW_HIDE)执行,
#   输出转 .ihui-agent/state/hook-logs/pre-commit.log,退出码原样传播。
# 成功回显日志末 5 行摘要;失败回显末 40 行定位原因。
wscript //nologo scripts/hook-run-hidden.vbs pre-commit scripts/lib/pre-commit-hook.js "$@" || {
  printf '%s\n' "❌ Pre-commit 守门失败,提交已阻止 —— 日志末 40 行:" >&2
  tail -40 .ihui-agent/state/hook-logs/pre-commit.log >&2 || true
  printf '%s\n' "   (完整日志: .ihui-agent/state/hook-logs/pre-commit.log)" >&2
  exit 1
}
tail -5 .ihui-agent/state/hook-logs/pre-commit.log >&2 || true
