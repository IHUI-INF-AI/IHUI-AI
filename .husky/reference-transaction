#!/bin/sh
# ════════════════════════════════════════════════════════════════
# stash-guard(reference-transaction hook):全面禁止创建 git stash
# (2026-09-18 立,AGENTS.md §12d "改动进 stash 不生效"事故终极根治)
#
# 原理:git 无 pre-stash hook,但 refs/stash 的写入走引用事务;
#       本 hook 在 prepared 阶段 exit 1,即可让 git stash push 等
#       创建操作在 git 层面直接失败(--no-verify 也无法绕过)。
#
# 只拦"新建",不拦"清理"(drop/pop/clear):
#   - 删除最后一条(new = 0000)→ 放行
#   - drop/pop 收尾时 refs/stash 移动到既有旧条目(new 值已在
#     refs/stash reflog 中)→ 放行
#   - 人工放行:IHUI_ALLOW_STASH=1(仅限存量清理,须先按 §12d
#     零损失流程 tag 备份,并在会话报告声明放行原因)
#
# 实现约束:只用 sh 内建 + git 命令,不依赖 grep/sed 等
# coreutils(Windows 下 hook 进程 PATH 不保证含 Git usr/bin)。
# ════════════════════════════════════════════════════════════════
# ── commit-witness(引用事务见证,2026-09-30 立)──────────────────
# 挂这里而不是 post-commit 的理由只有一条:`--no-verify` 跳过的是**校验型**钩子
# (pre-commit / commit-msg),引用事务钩子**照跑** —— 上面 stash-guard 正是靠这条才拦得住
# `git stash push`。于是"这台机上发生过一次分支 ref 变更"成了一条与跳门无关的正证,
# 统计器 `plan-bypass-ledger-report.mjs` 据此能把"三样正证都没有"的那一堆拆成两格:
#   本机有见证 ⇒ **可疑**(要么跑了门但文件回显不逐字等值,要么根本没跑)
#   本机无见证 ⇒ 别机/更早产生,本器**无从判断**
# 它**不能单独证明跳门**(并发会话同窗口 staged 别的东西时,回显会不成等值 ⇒ 正常提交也可能
# 无匹配轮),所以两侧措辞都只说"可疑/无从",不写指控 —— 指控得由人读那一枚的钩子日志。
# 依赖纪律:只用 sh 内建 + git(本文件原有的 stash-guard 已用 `git reflog show`,同一条约束)。
# 时间戳刻意不落:`date` 属 coreutils,不在保证范围内,而统计器是按 sha 连接的,不需要时刻。
# 写失败绝不影响提交(state=committed 时 git 本就不看退出码,仍显式吞掉)。
if [ "$1" = "committed" ]; then
  W_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
  [ -n "$W_ROOT" ] || exit 0
  W_DIR="$W_ROOT/.ihui-agent/state"
  # 目录不存在就必须先造:新克隆 / 别的机器 / CI 上没有 .ihui-agent/state,而 `>>` 在缺目录时**只报错不创建**,
  # 错误被 2>/dev/null 吞掉 ⇒ 见证一条都不落而提交照常成功 —— 统计器于是把每一枚都读成"本机无见证",
  # 尺子朝最坏的方向说谎(把"没记"报成"没发生")。实测:临时仓首跑就是这个形态。
  [ -d "$W_DIR" ] || mkdir -p "$W_DIR" 2>/dev/null || exit 0
  W_FILE="$W_DIR/commit-witness.log"
  W_ZERO=0000000000000000000000000000000000000000
  while read -r w_old w_new w_ref; do
    case "$w_ref" in
      refs/heads/*) ;;
      *) continue ;;
    esac
    [ "$w_new" = "$W_ZERO" ] && continue
    printf '%s\t%s\n' "$w_new" "$w_ref" >> "$W_FILE" 2>/dev/null || true
  done
  exit 0
fi

[ "$1" = "prepared" ] || exit 0

# ── 递归闸门(第一道,最快)──────────────────────────────────────
# 棘轮自身/其内部的派生调用若再触发引用事务,直接放行;node 侧还有第二道同名 env 守卫。
[ "${IHUI_REF_TXN_MAIN_RATCHET:-0}" = "1" ] && exit 0

ZERO=0000000000000000000000000000000000000000
R_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$R_ROOT" ] || exit 0
# 脚本按**钩子自身所在仓**定位：core.hooksPath 可以指到共享的 .husky，而判定的仓由 --root 传入。
# 生产里两者是同一个仓；测试/共享钩子场景里这条让 "钩子在哪、脚本就在哪" 成立。
R_HOOK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd)
[ -n "$R_HOOK_ROOT" ] || R_HOOK_ROOT=$R_ROOT
RATCHET_REF=${IHUI_REF_TXN_RATCHET_REF:-refs/heads/main}
RATCHET_NODE=
command -v node >/dev/null 2>&1 && RATCHET_NODE=$(command -v node)

# node 缺失时也要留痕:main 棘轮无法执行,必须写成 hook-error 让 liveness 检查点名,
# 但**绝不因此阻断 main**(fail-open 与 node 侧异常策略一致)。
record_hook_error() {
  r_common=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  [ -n "$r_common" ] || return 0
  case "$r_common" in
    /*) ;;
    *:/*) ;;
    *) r_common="$R_ROOT/$r_common" ;;
  esac
  r_dir="$r_common/ihui-ref-ratchet"
  mkdir -p "$r_dir" 2>/dev/null || return 0
  printf '{"ts":null,"kind":"%s","message":"%s","input":{"old":"%s","new":"%s","ref":"%s","via":"reference-transaction.sh"}}\n' \
    "$1" "$2" "$3" "$4" "$5" >> "$r_dir/hook-error.log" 2>/dev/null || true
}

# 单趟读 stdin —— reference-transaction 的 stdin 只能消费一次,不允许再开第二个 while。
while read -r t_old t_new t_ref; do
  case "$t_ref" in
    refs/stash)
      [ "$t_new" = "$ZERO" ] && continue
      [ "${IHUI_ALLOW_STASH:-0}" = "1" ] && continue
      # new 指向 stash reflog 中既有条目 = drop/pop 的收尾,放行
      known=0
      for entry in $(git reflog show refs/stash --format='%H' 2>/dev/null); do
        [ "$entry" = "$t_new" ] && { known=1; break; }
      done
      [ "$known" = "1" ] && continue
      {
        printf '\n'
        printf '✋ stash-guard:已拦截 git stash —— 本项目禁止把改动放进 stash(AGENTS.md §12d)\n'
        printf '   推了就是要生效:改动必须直接 commit(safe-commit.mjs)或用 worktree 隔离(§12d)\n'
        printf '   清理存量 stash 属例外:IHUI_ALLOW_STASH=1 git stash drop|clear(先 tag 零损失备份)\n'
      } >&2
      exit 1
      ;;
    "$RATCHET_REF")
      # main 引用棘轮:判 new OID 的对象面(不是 --staged!prepared 阶段 HEAD 仍旧树)。
      # 判据在 node 里;这里只管"跑没跑"与退出码,不解释结果。
      if [ -z "$RATCHET_NODE" ]; then
        record_hook_error "node-missing" "node 不在 PATH,main 棘轮未执行" "$t_old" "$t_new" "$t_ref"
        continue
      fi
      IHUI_REF_TXN_MAIN_RATCHET=0 "$RATCHET_NODE" "$R_HOOK_ROOT/scripts/ref-ratchet-main.mjs" \
        --root "$R_ROOT" --old "$t_old" --new "$t_new" --ref "$t_ref" </dev/null
      rc=$?
      [ "$rc" -eq 0 ] || exit "$rc"
      ;;
  esac
done
exit 0
