#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# 缓冲 git 传入的推送 ref 列表(stdin),再回喂给 git-lfs —— lfs 会消费 stdin,
# 必须先缓冲,否则后续无法据此计算「本次推送的改动文件范围」(2026-09-03 push-scope 修复)
PUSH_REFS="$(cat)"
if [ -z "$PUSH_REFS" ]; then
  git lfs pre-push "$@" </dev/null
else
  printf '%s\n' "$PUSH_REFS" | git lfs pre-push "$@"
fi

# ─── 全量 typecheck 强制门 ────────────────────────────────────────────
# 背景:第 11-12 轮发现 subagent 报告"全绿"靠 .tsbuildinfo 缓存假象
#      pre-push 强制清缓存 + 串行全量 typecheck 修复该问题
# 跳过的方法:HUSKY_SKIP_TYPECHECK=1(紧急 push 时使用,但建议修复后正常 push)
# 注意:用 printf >&2 替代 echo,避免 Windows git hooks stdout 关闭导致 Bad file descriptor
#
# 2026-08-31 改版:pnpm typecheck:full → guardian-runner --push-gate 编排
#   - T1 = scripts/check-typecheck.mjs 包装(清缓存全量 tsc/mypy 行为不变)
#   - staged-scope 降级:暂存区非空且全部报错文件不在暂存区(并行会话工作区噪音)→ 降级警告放行,
#     报错文件在暂存区 → 维持阻塞(宁误拦不放过,解析不到报错文件=tsc 未真正运行按失败)
#   - 多会话并行开发时不再被其他会话未完成文件误伤(AGENTS.md §12d 配套)
#
# 工作区检测(2026-07-19 优化):
#   原行为:无脑跑全量 typecheck,工作区有未提交改动时阻塞无关 push,且无明确指引
#   新行为:检测工作区是否干净,不干净时打印明确指引(3 个选项),再跑 typecheck
#   不用 git stash 隔离方案:stash pop 在工作区被 lint-staged/IDE 等工具修改后会冲突,
#   需手动恢复(实测踩坑),风险高于收益。保留全量 typecheck 闸门,加智能提示更稳妥。
if [ "${HUSKY_SKIP_TYPECHECK:-0}" = "1" ]; then
  printf '%s\n' "⚠️  HUSKY_SKIP_TYPECHECK=1 — 已跳过全量 typecheck 验证(不推荐)" >&2
else
  printf '\n%s\n' "🔍 全量 typecheck 验证(清 .tsbuildinfo 缓存后)..." >&2
  cd "$(git rev-parse --show-toplevel)" || { printf '%s\n' "❌ 无法定位仓库根目录" >&2; exit 1; }

  # 检测工作区是否有未提交改动(tracked)
  if ! git diff --quiet HEAD --; then
    printf '%s\n' "" >&2
    printf '%s\n' "⚠️  工作区有未提交改动,typecheck 将包含这些改动(可能阻塞 push)" >&2
    printf '%s\n' "    若 push 被阻塞,可选:" >&2
    printf '%s\n' "      1. 先 commit/stash 工作区改动,再 push" >&2
    printf '%s\n' "      2. 用 HUSKY_SKIP_TYPECHECK=1 git push 跳过 typecheck(不推荐)" >&2
    printf '%s\n' "      3. 修复 typecheck 错误后正常 push" >&2
    printf '%s\n' "" >&2
  fi

  # ─── 计算本次推送的改动文件范围(2026-09-03 push-scope 修复) ──────────
  # 背景:降级判据原只用暂存区推断「我的改动范围」。但 `git push <sha>:<ref>` 这类
  #       refspec 推送不产生暂存区,若此刻他人也没 staged 文件,降级直接失效 →
  #       他人并行会话的半编辑态报错会硬拦本次 push(实测连撞 miniapp-taro TS1005、
  #       web TS2345,单独复验均为 0 错误,属窗口期假报错)。
  # 修复:优先用 git 传入的 remote_sha..local_sha 计算真实改动文件,导出 PUSH_SCOPE_FILES;
  #       暂存区仅作兜底(判定逻辑见 scripts/check-typecheck.mjs)。
  PUSH_SCOPE_FILES=""
  if [ -n "$PUSH_REFS" ]; then
    PUSH_SCOPE_FILES="$(
      printf '%s\n' "$PUSH_REFS" | while IFS=' ' read -r _lref lsha _rref rsha; do
        [ -z "$lsha" ] && continue
        # 删除分支(local 全 0)→ 无改动文件
        case "$lsha" in 0000000000000000000000000000000000000000) continue ;; esac
        case "$rsha" in
          0000000000000000000000000000000000000000)
            # 新分支:仅取该 commit 自身改动
            git show --name-only --format= "$lsha" 2>/dev/null
            ;;
          *)
            git diff --name-only "$rsha" "$lsha" 2>/dev/null
            ;;
        esac
      # 注:不做反斜杠归一化 —— check-typecheck.mjs 内 getScopeFiles() 已统一
      #     replaceAll('\\','/')(shell 侧 sed 转义在 sh/hook 双重解析下极易写错,已踩坑)
      done | grep -v '^$' | sort -u
    )"
  fi
  # 安全阀:改动文件过多时清空 → 退回暂存区兜底。
  # 原因:env 有长度上限,截断会让「实际在推送范围内的报错文件」漏出列表,导致本该
  #       阻塞的错误被误判为他人噪音而放行 —— 宁可不降级,不可放过真实错误。
  if [ -n "$PUSH_SCOPE_FILES" ]; then
    _scope_count="$(printf '%s\n' "$PUSH_SCOPE_FILES" | grep -c .)"
    if [ "$_scope_count" -gt 300 ]; then
      PUSH_SCOPE_FILES=""
      printf '%s\n' "ℹ️  推送改动文件 ${_scope_count} 个 > 300,放弃 push-scope 判据(退回暂存区兜底)" >&2
    fi
  fi
  export PUSH_SCOPE_FILES

  node scripts/guardian-runner.mjs --push-gate || { printf '%s\n' "❌ push 门校验失败,推送已阻止" >&2; exit 1; }
  printf '%s\n' "✅ push 门校验通过(push-scope/staged-scope 降级已启用)" >&2
fi

# ─── i18n 死 key 审计警告(2026-07-26 集成,非阻塞) ─────────────────────
# 扫描 zh-CN.json 中已声明但代码无 t()/useTranslations() 引用的死 key,
# 仅打印末尾 3 行摘要,exit 1 由 || true 吞掉,不阻塞 push(对应 CI 阻塞).
# 跳过方法:HUSKY_SKIP_I18N_AUDIT=1(不推荐,CI 仍会阻塞).
node scripts/scan-dead-i18n-keys.mjs --dry-run 2>&1 | tail -3 || true
