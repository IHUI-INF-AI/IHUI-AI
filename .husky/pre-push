#!/bin/sh
# ─── GIT_DIR 去污(2026-10-01,同 .husky/pre-commit 同款病理根治)───
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# 缓冲 git 传入的推送 ref 列表(stdin),再回喂给 git-lfs —— lfs 会消费 stdin,
# 必须先缓冲,否则后续无法据此计算「本次推送的改动文件范围」(2026-09-03 push-scope 修复)
PUSH_REFS="$(cat)"
if [ -z "$PUSH_REFS" ]; then
  git lfs pre-push "$@" </dev/null
else
  printf '%s\n' "$PUSH_REFS" | git lfs pre-push "$@"
fi

# ─── tag-only 推送不跑代码质量门(2026-09-24 立,lost-commit 备份被拦死多天)─────
# 判据:git 传入的每一行,其**存在的那一侧**都在 refs/tags/ 下(新建/推进 tag 看 local_ref,删除 tag
# 时 local 侧是 `(nil)`,看 remote 侧)⇒ 本次推送**不新增也不推进任何分支**,
#       被推的代码内容一个字节都没变(全在远端已有的 HEAD 及祖先里),推的只是 §22 要求的
#       "丢失 commit 备份引用"。而本门跑的是**工作区**全量 tsc —— 别人一条未提交的半编辑
#       就能把它钉红:实测 2026-09-24 另一会话把 packages/ui-react/src/components/Upload.tsx
#       的 `export interface UploadLabels` 删掉未提交 ⇒ src/index.ts 报 TS2614 ⇒ 第 13 块
#       tag 推送被拦,206 枚 lost-commit tag 因此没有远端备份(正是 §22 立备份要防的状态)。
# 只在**纯 tag 推送**上豁免:混合推送(同时推分支)照跑全部门;PUSH_REFS 为空(无 ref 可推、
# 或 git 未传清单)按原行为跑门 —— 宁多跑一次,绝不把"拿不到清单"当成"只推了 tag"。
#
# 2026-11-04 解耦:本块原先住在下面 `HUSKY_SKIP_TYPECHECK` 的 else 分支里 ⇒ export 该变量
# 即可整段跳过,把"任意 tag 直通放行"的释放面重新打开。现将判据整体上移到 env 判断**之前**:
# 无论有没有 HUSKY_SKIP_TYPECHECK,tag 判据都执行;纯 tag 推送在此 exit(0 放行 / 1 拦下),
# 根本走不到 typecheck 分支;非纯 tag 推送(分支、混合、PUSH_REFS 为空)不进入本块,
# 继续按原顺序落到下面 typecheck 门 ⇒ 分支/混合推送行为一字未变。
# >>> tag-ancestor-gate (begin; scripts/tests/pre-push-tag-ancestor-gate.test.mjs 逐字抽取)
_ref_n="$(printf '%s\n' "$PUSH_REFS" | awk 'NF>=3' | wc -l | tr -d '[:space:]')"
# 判据必须同时认两种形制:①新建/推进 tag ⇒ local_ref 也在 refs/tags/ 下;②**删除 tag** ⇒ git 传的是
# `(nil) <全0> refs/tags/<名> <旧sha>`,tag 名只住在**远端侧 $3**。原写法只看 $1 ⇒ 删除类推送一条都
# 不计入,豁免结构上够不着:实测 2026-10-30 纯删 8093 枚冗余 tag,每批仍照跑全量门,3~4 分钟/批、
# 外推 5 小时。删除 tag 与被拦的"新建 tag"是同一件事的两个方向(都不推任何分支、不携带新对象),
# 没有理由只豁免一个。混合推送(同时有 refs/heads/ 那行)照跑全部门 —— $3 落在 heads/ 即不计数。
_tag_n="$(printf '%s\n' "$PUSH_REFS" | awk 'NF>=3 && $3 ~ /^refs\/tags\// && ($1 ~ /^refs\/tags\// || $1 == "(nil)")' | wc -l | tr -d '[:space:]')"
if [ "$_ref_n" -gt 0 ] && [ "$_ref_n" -eq "$_tag_n" ]; then
  # ─── tag 推送祖先判据(2026-11-04 立,关掉「任意 tag 直通放行」的释放面)──────────
  # 病灶(只读审计实测):原分支对纯 tag 推送无条件 exit 0,而 release-desktop.yml / release-cli.yml
  #   由 desktop-v* / cli-v* tag 触发,构建/签名/发布/更新 latest.json 全在 CI 发生 ⇒
  #   `git tag desktop-v9.9.9 <某笔 --no-verify 提交> && git push origin refs/tags/desktop-v9.9.9`
  #   可带着未过任何本地门的提交走完整条发版链(tag 指向非祖先提交时,推送本身还会把那批对象送上远端)。
  # 新判据(逐条 ref 判定,任一条拦下即 exit 1;不再有"无条件放行"):
  #   ① 解引用:`git rev-parse --verify "refs/tags/<名>^{commit}"` —— annotated tag 在 ref 行里的
  #      sha 是 tag 对象自身,不解引用直接比祖先关系会恒判否,故必须先取 commit 侧(lightweight
  #      tag 的 `^{commit}` 解引用为其自身);解不出 commit ⇒ 拦(指向非提交对象不构成发版来源)。
  #   ② 祖先判据:`git merge-base --is-ancestor <commit> origin/main`(退出 0 = 在该链上,
  #      含相等;非 0 一律按拦下处理,fail-closed);origin/main 解析不到 ⇒ 判据不可证成 ⇒ 拦。
  #   ③ 发布 tag(desktop-v* / cli-v*):除 ① ② 外追加工作树必须干净 —— `git status --porcelain`
  #      非空即拦,避免用 tag 把未提交草稿一起推走。
  # 唯一豁免 = §22 备份命名空间 `lost-commit/*`、`backup/*`、`backup-*`:实测本机 22137 枚
  #   lost-commit + 200 枚 backup,sample(40/20 枚)里各有 23/11 枚**不是** origin/main 的祖先
  #   —— 它们按定义就是"丢了但被备份"的提交,严格祖先判据会把唯一不能破的既有流程拦死;
  #   该命名空间不匹配任何 release 工作流的 tag 触发式,不含发版面。
  # 删除 tag(local sha 全 0)不推送任何对象 ⇒ 直接放行(零释放面,与既有删除豁免同向)。
  _tg_bad=0
  _tg_checked=0
  _tg_main="$(git rev-parse --verify --quiet origin/main 2>/dev/null)"
  if [ -z "$_tg_main" ]; then
    printf '%s\n' "⚠️ tag 推送祖先判据:origin/main 解析不到 ⇒ 非备份 tag 一律拦(fail-closed)" >&2
  fi
  while IFS=' ' read -r _tg_lref _tg_lsha _tg_rref _tg_rsha; do
    [ -z "$_tg_rref" ] && continue
    case "$_tg_rref" in refs/tags/*) : ;; *) continue ;; esac
    # tag 名:新建/推进 tag 看 local 侧;删除 tag(local 侧 `(nil)`)看远端侧
    case "$_tg_lref" in
      refs/tags/*) _tg_name="${_tg_lref#refs/tags/}" ;;
      *) _tg_name="${_tg_rref#refs/tags/}" ;;
    esac
    # 删除 tag:local sha 全 0 ⇒ 本次推送不携带它的任何对象
    case "$_tg_lsha" in
      *[!0]*) : ;;
      *) continue ;;
    esac
    _tg_checked=$((_tg_checked + 1))
    case "$_tg_name" in
      desktop-v*|cli-v*) _tg_is_release=1 ;;
      *) _tg_is_release=0 ;;
    esac
    case "$_tg_name" in
      lost-commit/*|backup/*|backup-*) _tg_is_backup=1 ;;
      *) _tg_is_backup=0 ;;
    esac
    _tg_commit="$(git rev-parse --verify --quiet "refs/tags/${_tg_name}^{commit}" 2>/dev/null)"
    if [ -z "$_tg_commit" ]; then
      printf '%s\n' "❌ tag ${_tg_name} 解引用不到 commit 对象 ⇒ 拒绝推送" >&2
      _tg_bad=1
      continue
    fi
    # §22 备份命名空间:不判祖先(见上注),其余 tag 一律要过祖先判据
    [ "$_tg_is_backup" -eq 1 ] && continue
    if [ -n "$_tg_main" ] && git merge-base --is-ancestor "$_tg_commit" origin/main 2>/dev/null; then
      :
    else
      printf '%s\n' "❌ tag ${_tg_name} 指向的提交 ${_tg_commit} 不在 origin/main 的祖先链上 ⇒ 拒绝推送" >&2
      printf '%s\n' "   规则:tag 只允许指向 origin/main 或其祖先的提交(§22 备份 tag lost-commit/*、backup/* 除外),防止用 tag 把未进 main 的提交(含 --no-verify 提交)推上远端。" >&2
      _tg_bad=1
      continue
    fi
    if [ "$_tg_is_release" -eq 1 ]; then
      if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        printf '%s\n' "❌ 发布 tag ${_tg_name} 推送时工作树不干净(git status --porcelain 非空)⇒ 拒绝推送" >&2
        printf '%s\n' "   规则:发布 tag 必须打在与 origin/main 相同或为其祖先的提交上,且工作树干净(避免把未提交草稿随 tag 送走)。" >&2
        _tg_bad=1
      fi
    fi
  done <<EOF
$PUSH_REFS
EOF
  if [ "$_tg_bad" -ne 0 ]; then
    printf '%s\n' "❌ tag 推送校验未通过,推送已阻止(共检查 ${_tg_checked} 个新建/推进 tag)" >&2
    exit 1
  fi
  printf '%s\n' "ℹ️ 本次只推 tag(${_tag_n} 个引用,无分支推进;祖先/备份判据逐条通过)⇒ 不跑代码质量门(§22 tag 备份通道)" >&2
  exit 0
fi
# <<< tag-ancestor-gate (end)

# ─── 生成物拦截(推送侧,--rev 面;2026-11-12 补)──────────────────────────────
# 立因:pre-commit 只审暂存区,`git commit --no-verify` 整段可绕;而 post-commit 会自动 push
#   (`.husky/post-commit` → git-push-guard),绕门提交会立刻进远端。本块在推送前用
#   `remote_sha..local_sha` 复核被推区间的改动面,判据与提交侧同源
#   (scripts/check-staged-artifacts.mjs 的 judgePath),不新造第二套判据。
# 范围:只判分支引用(refs/heads/*)。纯 tag 推送已在上面 exit;tag 指向的提交由祖先判据
#   约束为 origin/main 的祖先(备份 tag 命名空间除外)⇒ 不引入未审提交。
# 三态:0 = 区间面无生成物;1 = 检出生成物,阻断;2 = 取不到区间面(不报绿,阻断)。
# 应急:HUSKY_SKIP_STAGED_ARTIFACTS=1(与提交侧同一开关,仅判据确有误报时按)。
_art_args=""
_art_ref_n=0
_art_undetermined=0
_art_undetermined_why=""
while IFS=' ' read -r _a_lref _a_lsha _a_rref _a_rsha; do
  [ -z "$_a_rref" ] && continue
  case "$_a_lref" in refs/heads/*) : ;; *) continue ;; esac
  case "$_a_lsha" in ''|*[!0]*) : ;; *) continue ;; esac   # 删分支:不携带任何 blob
  _art_ref_n=$((_art_ref_n + 1))
  _a_range=""
  case "$_a_rsha" in
    *[!0]*)
      # 远端 sha 本地可见 ⇒ 直接取差集;不可见(远端被他人推进且本机未 fetch)⇒ 退合并基点,
      # 绝不把"取不到面"变成一次 exit 2 的整条 push 收口(2026-11-13 实测踩中)。
      if git cat-file -e "${_a_rsha}^{commit}" 2>/dev/null; then
        _a_range="${_a_rsha}..${_a_lsha}"
      else
        _a_base="$(git merge-base origin/main "$_a_lsha" 2>/dev/null)"
        [ -n "$_a_base" ] && _a_range="${_a_base}..${_a_lsha}"
      fi
      ;;
    *)
      # 新分支:相对 origin/main 的合并基点取差集(与 push-scope 新分支推导同源)
      _a_base="$(git merge-base origin/main "$_a_lsha" 2>/dev/null)"
      [ -n "$_a_base" ] && _a_range="${_a_base}..${_a_lsha}"
      ;;
  esac
  if [ -z "$_a_range" ]; then
    _art_undetermined=1
    _art_undetermined_why="${_art_undetermined_why} ${_a_lref#refs/heads/}(${_a_lsha})"
    continue
  fi
  _art_args="$_art_args --rev $_a_range"
done <<EOF
$PUSH_REFS
EOF
if [ "$_art_ref_n" -gt 0 ] && [ -n "$_art_args" ]; then
  # 逐词拆开是刻意:每个 `--rev <range>` 是一对参数(range 内无空格)
  wscript //nologo scripts/hook-run-hidden.vbs pre-push-artifacts scripts/check-staged-artifacts.mjs $_art_args
  _art_rc=$?
  if [ "$_art_rc" -eq 1 ]; then
    tail -40 .ihui-agent/state/hook-logs/pre-push-artifacts.log >&2 || true
    printf '%s\n' "❌ 推送区间含生成物,推送已阻止(按出路修提交后重推;日志: .ihui-agent/state/hook-logs/pre-push-artifacts.log)" >&2
    exit 1
  elif [ "$_art_rc" -ne 0 ]; then
    tail -40 .ihui-agent/state/hook-logs/pre-push-artifacts.log >&2 || true
    printf '%s\n' "❌ 生成物拦截未判定(exit ${_art_rc}:取不到推送区间改动面)⇒ 不报绿,推送已阻止" >&2
    printf '%s\n' "   应急(确认区间面确实取不到时):HUSKY_SKIP_STAGED_ARTIFACTS=1 git push ..." >&2
    exit 2
  else
    tail -3 .ihui-agent/state/hook-logs/pre-push-artifacts.log >&2 || true
  fi
fi
if [ "$_art_undetermined" -eq 1 ]; then
  printf '%s\n' "❌ 生成物拦截未判定:以下分支取不到可复核区间(无 origin/main 合并基点):${_art_undetermined_why}" >&2
  printf '%s\n' "   不报绿:无法证明该推送区间不含生成物。应急:HUSKY_SKIP_STAGED_ARTIFACTS=1 git push ..." >&2
  exit 2
fi

# >>> push-receipt-gate (begin) ─────────────────────────────────────────────
# 提交侧 worker 已对「完整 HEAD 树」跑完 13 门 + 文档数字门 + i18n 审计并签发签名凭据时,
# 推送侧只做内容寻址校验(tree/commit/远端基线/门脚本 blob/签名)即可放行。
# fail-closed:凭据缺失、树不符、缺一门、签名坏、门脚本被改、过期 ⇒ 一律不 exit 0,
# 继续走下方**原样保留**的真跑门路径。此处绝不伪造通过。
if [ -n "$PUSH_REFS" ]; then
  export PUSH_REFS
  wscript //nologo scripts/hook-run-hidden.vbs pre-push-receipt scripts/push-receipt.mjs --verify
  _receipt_rc=$?
  if [ "$_receipt_rc" -eq 0 ]; then
    tail -n 2 .ihui-agent/state/hook-logs/pre-push-receipt.log >&2 || true
    printf '%s\n' "✅ push 门凭据校验通过:提交侧已对完整 HEAD 树求值,本次推送不再重复跑门" >&2
    exit 0
  fi
  tail -n 2 .ihui-agent/state/hook-logs/pre-push-receipt.log >&2 || true
  printf '%s\n' "⏭️  push 门凭据不可用,回落真跑门(判据不降级)" >&2
fi
# <<< push-receipt-gate (end)

# ─── 跨分支推送告警(纯告警:不改退出码/不阻断/不 export)─────────────────
# 背景(2026-11-09 实测):从 HEAD=别的分支的检出推 feat/* 时,push 门按「当前 HEAD+工作树」
#   取材(guardian-runner.mjs 的 IG 门 args 硬编码 origin/main..HEAD;gate-face.mjs:48
#   ls-tree HEAD;knip/parity 门 readFileSync 磁盘)—— PUSH_REFS 在本钩子里只被折算成
#   文件名单(PUSH_SCOPE_FILES),被推 ref 的 sha 从未传给下游 ⇒ 跨分支推送必审错树。
#   实测:289s 全量门误红 5 道,同一棵树在正确检出复跑全绿。此处只告警指路,不动任何判据。
_cur_head="$(git rev-parse --verify -q HEAD 2>/dev/null)"
_cur_branch="$(git symbolic-ref -q --short HEAD 2>/dev/null)"
while IFS=' ' read -r _w_lref _w_lsha _w_rref _w_rsha; do
  [ -z "$_w_rref" ] && continue
  case "$_w_lref" in refs/heads/*) : ;; *) continue ;; esac   # 推 tag/其他 ref 跳过
  case "$_w_lsha" in ''|*[!0]*) : ;; *) continue ;; esac      # 删分支(local sha 全 0)跳过
  [ "$_w_lsha" = "$_cur_head" ] && continue                   # 推的就是当前检出分支,不告警
  printf '\n%s\n' "⚠️  跨分支推送:被推 ${_w_lref#refs/heads/} = ${_w_lsha}" >&2
  printf '%s\n' "    当前检出 HEAD = ${_cur_head} (${_cur_branch:-detached HEAD})" >&2
  printf '%s\n' "    push 门审的是【当前 HEAD + 工作树】面,不是被推 ref 的内容 —— 本次门的红/绿都不属于该分支。" >&2
  printf '%s\n' "    正确做法:env -C <该分支 worktree> git push origin ${_w_lref#refs/heads/}" >&2
done <<EOF
$PUSH_REFS
EOF
: # 显式收口为 0,不改变后续判据与退出码

# ─── 全量 typecheck 强制门 ────────────────────────────────────────────
# 背景:第 11-12 轮发现 subagent 报告"全绿"靠 .tsbuildinfo 缓存假象
#      pre-push 强制清缓存 + 串行全量 typecheck 修复该问题
# 跳过的方法:HUSKY_SKIP_TYPECHECK=1(仅跳过 T1 全量 typecheck,其余 12 道 push 门照跑;
#          紧急 push 时使用,但建议修复后正常 push)
# 注意:用 printf >&2 替代 echo,避免 Windows git hooks stdout 关闭导致 Bad file descriptor
#
# 2026-08-31 改版:pnpm typecheck:full → guardian-runner --push-gate 编排
#   - T1 = scripts/check-typecheck.mjs 包装(清缓存全量 tsc/mypy 行为不变)
#   - staged-scope 降级:暂存区非空且全部报错文件不在暂存区(并行会话工作区噪音)→ 降级警告放行,
#     报错文件在暂存区 → 维持阻塞(宁误拦不放过,解析不到报错文件=tsc 未真正运行按失败)
#   - 多会话并行开发时不再被其他会话未完成文件误伤(AGENTS.md §12d 配套)
#
# 工作区检测(2026-07-19 优化):
#   原行为:无脑跑全量 typecheck,工作区有未提交改动时阻塞无关 push,且无明确指引
#   新行为:检测工作区是否干净,不干净时打印明确指引(3 个选项),再跑 typecheck
#   不用 git stash 隔离方案:stash pop 在工作区被 lint-staged/IDE 等工具修改后会冲突,
#   需手动恢复(实测踩坑),风险高于收益。保留全量 typecheck 闸门,加智能提示更稳妥。
# 2026-11-08 DG-09 修正:旧版该判断的 else 分支一直包到 push 门调用结束 ⇒ 设变量等于
#   「整条 push 门链(13 道 blocking)一道都不跑」,与文案「仅跳过 typecheck」不符。
#   现改为:设变量 ⇒ 只导出 IHUI_PUSH_GATE_SKIP_IDS=T1(由 guardian-runner 逐 id 过滤并打印
#   skippedGates),后面 PUSH_SCOPE_FILES 计算与 guardian-runner --push-gate 调用**照常执行**,
#   其余 12 道 push 门不降级;runner 侧同时强制 --no-cache,避免缓存命中把其余门短路。
if [ "${HUSKY_SKIP_TYPECHECK:-0}" = "1" ]; then
  printf '%s\n' "⚠️  HUSKY_SKIP_TYPECHECK=1 — 仅跳过 T1(全量 typecheck),其余 12 道 push 门照跑(不推荐)" >&2
  export IHUI_PUSH_GATE_SKIP_IDS="T1"
fi
printf '\n%s\n' "🔍 全量 typecheck 验证(清 .tsbuildinfo 缓存后;HUSKY_SKIP_TYPECHECK=1 时 T1 由 runner 跳过)..." >&2
cd "$(git rev-parse --show-toplevel)" || { printf '%s\n' "❌ 无法定位仓库根目录" >&2; exit 1; }

# 检测工作区是否有未提交改动(tracked)
if ! git diff --quiet HEAD --; then
    printf '%s\n' "" >&2
    printf '%s\n' "⚠️  工作区有未提交改动,typecheck 将包含这些改动(可能阻塞 push)" >&2
    printf '%s\n' "    若 push 被阻塞,可选:" >&2
    printf '%s\n' "      1. 先 commit/stash 工作区改动,再 push" >&2
    printf '%s\n' "      2. 用 HUSKY_SKIP_TYPECHECK=1 git push 仅跳过 T1(其余 12 道 push 门照跑)(不推荐)" >&2
    printf '%s\n' "      3. 修复 typecheck 错误后正常 push" >&2
    printf '%s\n' "" >&2
  fi

  # ─── 计算本次推送的改动文件范围(2026-09-03 push-scope 修复) ──────────
  # 背景:降级判据原只用暂存区推断「我的改动范围」。但 `git push <sha>:<ref>` 这类
  #       refspec 推送不产生暂存区,若此刻他人也没 staged 文件,降级直接失效 →
  #       他人并行会话的半编辑态报错会硬拦本次 push(实测连撞 miniapp-taro TS1005、
  #       web TS2345,单独复验均为 0 错误,属窗口期假报错)。
  # 修复:优先用 git 传入的 remote_sha..local_sha 计算真实改动文件,导出 PUSH_SCOPE_FILES;
  #       暂存区仅作兜底(判定逻辑见 scripts/check-typecheck.mjs)。
  PUSH_SCOPE_FILES=""
  if [ -n "$PUSH_REFS" ]; then
    PUSH_SCOPE_FILES="$(
      printf '%s\n' "$PUSH_REFS" | while IFS=' ' read -r _lref lsha _rref rsha; do
        [ -z "$lsha" ] && continue
        # 删除分支(local 全 0)→ 无改动文件
        case "$lsha" in 0000000000000000000000000000000000000000) continue ;; esac
        # >>> push-scope-new-branch (begin; scripts/tests/pre-push-new-branch-scope.test.mjs 逐字抽取)
        case "$rsha" in
          0000000000000000000000000000000000000000)
            # 新分支:先取该 commit 自身改动。tip 是 merge commit 时 git show 的 combined diff
            # 恒为空(实测 0 行),不能把「取不到面」读成「没有改动」—— 那会让 PUSH_SCOPE_FILES
            # 为空,下游门退回 HEAD 全量面(实测 47p 31224ms)。
            # 二级推导(2026-11-03):相对目标分支的合并基点取差集,即这条新分支真实新增的内容。
            # 同场实测:merge tip 下非空 9 行,且不含 main 侧自带改动;另两条候选不采用 ——
            # diff-tree --first-parent 单用同样 0 行,加 -m 会把 main 侧自带的那枚文件混进来(10 行)。
            # 两档都取不到 ⇒ 输出空,由下游维持原有「回退全量面 + 告警」,绝不伪造空 scope。
            _nb_scope="$(git show --name-only --format= "$lsha" 2>/dev/null)"
            if [ -z "$_nb_scope" ]; then
              _nb_base="$(git merge-base origin/main "$lsha" 2>/dev/null)"
              if [ -n "$_nb_base" ]; then
                _nb_scope="$(git diff --name-only "$_nb_base" "$lsha" 2>/dev/null)"
              fi
            fi
            if [ -n "$_nb_scope" ]; then
              printf '%s\n' "$_nb_scope"
            fi
            ;;
          *)
            # 远端 sha 本地不可见(远端被他人推进且本机未 fetch)时 `git diff` 直接失败 ⇒
            # 旧写法把它留成空 scope,47p 只能判"未判定",整条推送收不了口。退到合并基点取差集。
            _ps_scope="$(git diff --name-only "$rsha" "$lsha" 2>/dev/null)"
            if [ -z "$_ps_scope" ]; then
              _ps_base="$(git merge-base origin/main "$lsha" 2>/dev/null)"
              if [ -n "$_ps_base" ]; then
                _ps_scope="$(git diff --name-only "$_ps_base" "$lsha" 2>/dev/null)"
                [ -n "$_ps_scope" ] && printf '%s\n' "⚠️  远端 $(printf '%.12s' "$rsha") 本地不可见,推送范围按 origin/main 合并基点派生" >&2
              fi
            fi
            if [ -n "$_ps_scope" ]; then
              printf '%s\n' "$_ps_scope"
            fi
            ;;
        esac
        # <<< push-scope-new-branch (end)
      # 注:不做反斜杠归一化 —— check-typecheck.mjs 内 getScopeFiles() 已统一
      #     replaceAll('\\','/')(shell 侧 sed 转义在 sh/hook 双重解析下极易写错,已踩坑)
      done | grep -v '^$' | sort -u
    )"
  fi
  # ─── 无文件面判据(2026-11-04 立,纯 ref 删除被两道门误拦的根因)────────────
  # 现场(2026-11-04 实测):`git push origin --delete <branch>` 只删远端引用、零 blob 变更,
  #   上一步算出的 PUSH_SCOPE_FILES 必然为空。下游两道门都把"空"读成"取不到面":
  #     · 47p 水印门退回 HEAD 全量面(日志原文「未取到 PUSH_SCOPE_FILES ⇒ 退回 HEAD 全量面」),
  #       于是别人的存量水印欠账被算到这次"删除"头上;
  #     · T1 typecheck 退回暂存区/head-diff 兜底 ⇒ 跑全量 tsc,撞上他人暂存面与另一枚在飞
  #       全量 typecheck 的串行锁(超时判红)——一次不携带任何文件的推送,两个红。
  # 判据必须是**显式可证**的三值判定(不许静默 skip、不许把门设成 advisory、不许 if: false):
  #   ① 空 scope 有两种来路:「真的零文件」与「派生失败」,必须逐条 ref 复核把二者分开;
  #   ② 删除引用(local sha 全 0)不携带 blob,直接证成零文件;
  #   ③ 非删除引用用只读 `git diff --quiet <旧树> <新树>` 复核:退出 0 = 树相同 = 零文件变更,
  #      1 = 有差异(此时 PUSH_SCOPE_FILES 本来就非空,够不着本档),>1 = 派生失败;
  #      新分支(remote sha 全 0)取 `git merge-base origin/main <lsha>` 作旧树,取不到 ⇒ 派生失败;
  #   ④ 只有每条 ref 都被证成零文件才导出 PUSH_NO_FILE_FACE=1 与依据;
  #      任一派生失败 ⇒ 维持原有「回退全量面 + 告警」路径,**绝不伪造"无文件"**。
  PUSH_NO_FILE_FACE=0
  PUSH_NO_FILE_FACE_BASIS=""
  if [ -n "$PUSH_REFS" ] && [ -z "$PUSH_SCOPE_FILES" ]; then
    _nf_ref_n="$(printf '%s\n' "$PUSH_REFS" | awk 'NF>=3' | wc -l | tr -d '[:space:]')"
    _nf_del_n="$(printf '%s\n' "$PUSH_REFS" | awk 'NF>=3 && $2 ~ /^0+$/ {c++} END{print c+0}')"
    _nf_zero_face=1
    while IFS=' ' read -r _nf_lref _nf_lsha _nf_rref _nf_rsha; do
      [ -z "$_nf_lsha" ] && continue
      # 删除引用:local sha 全 0 ⇒ 本次推送不携带它的任何 blob
      case "$_nf_lsha" in
        *[!0]*) : ;;
        *) continue ;;
      esac
      case "$_nf_rsha" in
        *[!0]*)
          git diff --quiet "$_nf_rsha" "$_nf_lsha" 2>/dev/null || _nf_zero_face=0
          ;;
        *)
          _nf_base="$(git merge-base origin/main "$_nf_lsha" 2>/dev/null)" || _nf_zero_face=0
          if [ -n "$_nf_base" ]; then
            git diff --quiet "$_nf_base" "$_nf_lsha" 2>/dev/null || _nf_zero_face=0
          else
            _nf_zero_face=0
          fi
          ;;
      esac
    done <<EOF
$PUSH_REFS
EOF
    if [ "$_nf_zero_face" -eq 1 ] && [ "$_nf_ref_n" -gt 0 ]; then
      PUSH_NO_FILE_FACE=1
      if [ "$_nf_del_n" -eq "$_nf_ref_n" ]; then
        PUSH_NO_FILE_FACE_BASIS="push refs=${_nf_ref_n} 条全部为删除引用(local sha 全 0),不携带任何 blob ⇒ git 面零文件变更"
      else
        PUSH_NO_FILE_FACE_BASIS="push refs=${_nf_ref_n} 条(删除 ${_nf_del_n} 条);其余 $((_nf_ref_n - _nf_del_n)) 条经 git diff --quiet 复核树相同 ⇒ 零文件变更"
      fi
      printf '%s\n' "ℹ️  无文件面判定:${PUSH_NO_FILE_FACE_BASIS}" >&2
    else
      printf '%s\n' "⚠️  push scope 为空且逐条复核未证成零文件(派生失败)⇒ 水印门将判「未判定」exit 2(不再回退整面)" >&2
    fi
  fi
  # 安全阀:改动文件过多时 env 长度不可靠 ⇒ 改走**清单文件**,不再清空 scope。
  # 原行为是清空 PUSH_SCOPE_FILES 让门"退回更大的面"—— 2026-11-09 实测事故的直接触发点:
  # 47p 拿不到范围后退回整张 HEAD 面并自愈写盘,把水印注进 190 个与本次推送无关的文件。
  # 现口径:清空 = 未判定 = exit 2。清单文件由支持清单来源的门(水印 47p)读取。
  PUSH_SCOPE_MANIFEST=""
  if [ -n "$PUSH_SCOPE_FILES" ]; then
    _scope_count="$(printf '%s\n' "$PUSH_SCOPE_FILES" | grep -c .)"
    if [ "$_scope_count" -gt 300 ]; then
      _scope_manifest_dir="${TMPDIR:-/tmp}/ihui-push-scope-$$"
      if mkdir -p "$_scope_manifest_dir" 2>/dev/null \
        && printf '%s\n' "$PUSH_SCOPE_FILES" > "$_scope_manifest_dir/files.txt" 2>/dev/null; then
        PUSH_SCOPE_MANIFEST="$_scope_manifest_dir/files.txt"
        printf '%s\n' "ℹ️  推送改动文件 ${_scope_count} 个 > 300:清单已写入 ${PUSH_SCOPE_MANIFEST}(水印 47p 读取;不清空 scope)" >&2
      else
        printf '%s\n' "⚠️  推送改动文件 ${_scope_count} 个 > 300 且清单写入失败 ⇒ 水印门将判未判定(exit 2),不退回整面" >&2
      fi
      PUSH_SCOPE_FILES=""
    fi
  fi
  export PUSH_SCOPE_FILES PUSH_SCOPE_MANIFEST
  export PUSH_NO_FILE_FACE PUSH_NO_FILE_FACE_BASIS

  # ─── 弹窗根治(2026-09-22,详见 scripts/hook-run-hidden.vbs 头注释) ────
  # 原 3 处裸 node 在无 console 上下文(GUI git 面板/WMI 链/IDE 隐藏 shell)触发
  # push 时各弹可见控制台窗口;统一 wscript 隐藏包装,输出转 hook-logs 并按需回显。
  wscript //nologo scripts/hook-run-hidden.vbs pre-push-gate scripts/guardian-runner.mjs --push-gate
  _gate_rc=$?
  # 清理本次范围清单(门已跑完,临时文件不再需要;失败也不影响判定)。
  if [ -n "$PUSH_SCOPE_MANIFEST" ]; then
    rm -rf "$(dirname "$PUSH_SCOPE_MANIFEST")" 2>/dev/null || true
  fi
  if [ "$_gate_rc" -eq 75 ]; then
    # 2026-09-18 中断分类:typecheck 进程被外部中断(CTRL_C 注入/宿主清树/管道中断,
    # 实测 39 次 exit 3221225786)≠ 类型检查结论。以 75 + 标记文件通知 push guard
    # 「临时失败,带 hook 重试」,避免被误判为"其他 agent 代码失败"而 --no-verify 绕过真实门禁。
    printf '%s\n' "⏭️ push 门被中断(exit 75,临时失败)—— 已标记可重试,本次推送中止" >&2
    wscript //nologo scripts/hook-run-hidden.vbs pre-push-mark scripts/lib/push-gate-mark.mjs 75
    exit 75
  fi
  if [ "$_gate_rc" -ne 0 ]; then
    tail -40 .ihui-agent/state/hook-logs/pre-push-gate.log >&2 || true
    printf '%s\n' "❌ push 门校验失败,推送已阻止(完整日志: .ihui-agent/state/hook-logs/pre-push-gate.log)" >&2
    exit 1
  fi
  tail -3 .ihui-agent/state/hook-logs/pre-push-gate.log >&2 || true
  printf '%s\n' "✅ push 门校验通过(push-scope/staged-scope 降级已启用)" >&2

# ─── 旧底稿整份回退哨兵(push-range 面硬拦截,2026-11-11 立) ─────────────────
# 立因:门 84 只判暂存面且 --no-verify 可绕过;worktree-preserving 收敛让共享索引常年
# 落后 HEAD,某席用旧索引快照提交会把整批文件退回旧版(git 视角只是"少了几行"),
# 行数门/diff 门都不响。2026-11-11 的 52991b5365 据此把 173 文件整份退回。
# 本哨兵判**提交面/推送区间面**:逐提交取改动路径的 blob,回查其自身祖先版本,命中即整份旧版。
# 正常编辑内容不可能等于任何祖先版本 ⇒ 零误报;命中≥阈值(3)即判红并逐条点名祖先提交。
# 同时挂在 post-commit(每次落提交即报警,--no-verify 绕不过),本处在推送前硬拦。
# 跳过:HUSKY_SKIP_STALE_BASELINE_SENTINEL=1(不推荐)。未判定(exit≠0,1 之外,如 origin/main
# 解析不到)= 不阻断推送(防误拦);只有确证整份回退(exit 1)才拦。
if [ "${HUSKY_SKIP_STALE_BASELINE_SENTINEL:-0}" = "1" ]; then
  printf '%s\n' "ℹ️  旧底稿哨兵已按 HUSKY_SKIP_STALE_BASELINE_SENTINEL=1 跳过" >&2
else
  wscript //nologo scripts/hook-run-hidden.vbs pre-push-stale-sentinel scripts/check-stale-baseline-sentinel.mjs --range origin/main..HEAD --push-gate
  _sentinel_rc=$?
  if [ "$_sentinel_rc" -eq 1 ]; then
    tail -40 .ihui-agent/state/hook-logs/pre-push-stale-sentinel.log >&2 || true
    printf '%s\n' "❌ 旧底稿整份回退哨兵检出推送区间内存在整份退回旧版,推送已阻止(按 HEAD 面回植后重建提交,或走 git revert / 在提交信息写 intentional-revert: <理由>;日志: .ihui-agent/state/hook-logs/pre-push-stale-sentinel.log)" >&2
    exit 1
  elif [ "$_sentinel_rc" -ne 0 ]; then
    printf '%s\n' "⚠️  旧底稿哨兵未判定(exit $_sentinel_rc,取值失败或 origin/main 解析不到)⇒ 不阻断推送(防误拦);日志: .ihui-agent/state/hook-logs/pre-push-stale-sentinel.log)" >&2
  else
    tail -3 .ihui-agent/state/hook-logs/pre-push-stale-sentinel.log >&2 || true
  fi
fi

# ─── 文档数字对账(DN2 head 面全量,2026-11-05 挂 pre-push) ─────────────────────
# 提交链只判"本轮触及 README 的那枚"(DN4 防恒红)⇒"只加测试不碰 README"会让正文静默过期;推送频次低 ⇒ 不恒红。
# 语义 = 不许把带过期正文的树推上去;判据复用门 173,一行未改。
if [ "${PUSH_NO_FILE_FACE:-0}" = "1" ]; then
  printf '%s\n' "ℹ️  零文件推送(已逐条证成)⇒ 不跑文档数字门:${PUSH_NO_FILE_FACE_BASIS}" >&2
else
  printf '\n%s\n' "🔍 文档数字对账(DN2 head 面全量:正文/生成块必须等于现算值)..." >&2
  wscript //nologo scripts/hook-run-hidden.vbs pre-push-doc-numbers scripts/check-doc-numbers.mjs --strict --push
  if [ $? -ne 0 ]; then
    tail -30 .ihui-agent/state/hook-logs/pre-push-doc-numbers.log >&2 || true
    printf '%s\n' "❌ 文档数字对账失败,推送已阻止(修 README 正文/块后重推;日志: .ihui-agent/state/hook-logs/pre-push-doc-numbers.log)" >&2
    exit 1
  fi
  tail -3 .ihui-agent/state/hook-logs/pre-push-doc-numbers.log >&2 || true
fi

# ─── i18n 死 key 审计警告(2026-07-26 集成,非阻塞) ─────────────────────
# 扫描 zh-CN.json 中已声明但代码无 t()/useTranslations() 引用的死 key,
# 仅打印末尾 3 行摘要,exit 1 由 || true 吞掉,不阻塞 push(对应 CI 阻塞).
# 跳过方法:HUSKY_SKIP_I18N_AUDIT=1(不推荐,CI 仍会阻塞).
wscript //nologo scripts/hook-run-hidden.vbs pre-push-i18n scripts/scan-dead-i18n-keys.mjs --dry-run || true
tail -3 .ihui-agent/state/hook-logs/pre-push-i18n.log >&2 || true
