#!/bin/sh
# ─── post-commit 薄壳(2026-10-16 立,2026-10-19 复位) ─────────────────────────
# 病理(2026-10-16 实测):本文件原是 #!/usr/bin/env node 脚本 ⇒ 钩子被 spawn 时的
# PATH 里没有 node 就整层静默死 —— Git for Windows 回落用 sh 解释本文件,第 2 行
# JS 注释即报 syntax error,而 post-commit 不拦提交 ⇒ safe-commit 照样打
# "✅ post-commit hook 将自动调用 git-push-guard 推送",自动推送/自愈整段无声没跑
# (.workbuddy/hook-logs/post-commit-*.log 零新增可证,随触发方 env 浮动、间歇性)。
# 2026-10-19 复位立因:本薄壳在 00eab50bc96(一枚只动 apps/cli 的 ws 取档的提交)里被
# 并发的旧基线索引整份写回成 node 正文,同日实测间歇死重现 —— 07:19:20 那枚提交三条腿
# 日志都动了(07:19:21/24/34),07:31:17 那枚一条没动。防复发闸见
# scripts/check-husky-hook-form.mjs(钩子必须是 sh 薄壳,node 正文只能在 scripts/lib)。
# 根治:与 .husky/pre-commit 同型 —— 本文件只做 sh 薄壳,经
#   wscript //nologo scripts/hook-run-hidden.vbs(GUI 子系统,自身不依赖 node)
# 启动正文 scripts/lib/post-commit-hook.js(node 逻辑整体在那边,含 git 写锁 /
# push-guard / pollution / tag-sync / plan-heal / plan-state-heal 各段,日志 label
# 与段编号与迁入前逐字一致)。
# 失败语义:commit 已落地,钩子失败只回显日志末 40 行,不静默、不阻断提交。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH
wscript //nologo scripts/hook-run-hidden.vbs post-commit scripts/lib/post-commit-hook.js "$@" || {
  printf '%s\n' "❌ post-commit 链失败(commit 已落地;推送/自愈段未完成)—— 日志末 40 行:" >&2
  tail -40 .workbuddy/hook-logs/post-commit.log >&2 || true
  printf '%s\n' "   手动复跑:node scripts/lib/post-commit-hook.js;推送核验:node scripts/git-push-converge.mjs" >&2
  exit 1
}
