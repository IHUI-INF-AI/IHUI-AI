shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
node-linker=isolated
prefer-workspace-packages=true

# 供应链安全(D29-H5):build script 防护配置已迁移到 pnpm-workspace.yaml(2026-08-03)
# pnpm 11 不再读取 .npmrc 的 onlyBuiltDependencies[] 数组语法(类似 overrides 迁移),
# 白名单配置见 pnpm-workspace.yaml 的 onlyBuiltDependencies 列表。
