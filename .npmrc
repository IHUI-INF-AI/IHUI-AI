shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
node-linker=isolated
prefer-workspace-packages=true
# 临时:避免 pnpm 重命名已有 junction 时与 IDE ESLint 服务冲突(EPERM)
package-import-method=clone-or-copy

# 供应链安全(D29-H5):build script 防护配置
# 禁止未授权依赖自动执行 postinstall/preinstall 脚本,防供应链投毒
# 不设 ignore-scripts=true(会破坏 argon2/sharp 等 native 依赖 build)
# 改用 onlyBuiltDependencies 白名单:pnpm 只允许以下依赖执行 build script,其他自动跳过
# 如有新依赖需要 build script,在此追加并 review
onlyBuiltDependencies[]=argon2
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=playwright

# ============== mobile-rn (Expo + RN) Metro hoist 配置 ==============
# 解决 pnpm isolated linker 与 Metro bundler 不兼容问题(2026-07-25)
# Metro 0.81 默认不 follow pnpm 的 .pnpm/<pkg>/node_modules symlink 真实路径,
# 导致 react-native / @react-navigation/native 的传递依赖(invariant, @react-navigation/core
# 等)无法解析,报 "Unable to resolve module"。
# 方案:用 public-hoist-pattern 把 RN/Expo 生态的传递依赖 hoist 到根 node_modules 顶层,
# Metro 的 hierarchical lookup 即可找到。
# 影响范围:仅 RN/Expo 生态包,其他 7 端(api/web/ai-service/desktop/extension/miniapp-taro/cli)
#          不引用这些包,无影响。调研报告:.trae-cn/tmp/mobile-rn-pnpm-hoist-report.md

# ----- 通配符:覆盖 RN/Expo/Metro 生态 -----
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*react-navigation*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*nativewind*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*solito*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-native-*/*
public-hoist-pattern[]=@react-navigation/*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@ide/*

# ----- react-native 0.79.6 非 scoped 传递依赖(Metro bundle 必需) -----
public-hoist-pattern[]=invariant
public-hoist-pattern[]=nullthrows
public-hoist-pattern[]=memoize-one
public-hoist-pattern[]=scheduler
public-hoist-pattern[]=stacktrace-parser
public-hoist-pattern[]=pretty-format
public-hoist-pattern[]=regenerator-runtime
public-hoist-pattern[]=anser
public-hoist-pattern[]=ansi-regex
public-hoist-pattern[]=chalk
public-hoist-pattern[]=commander
public-hoist-pattern[]=glob
public-hoist-pattern[]=event-target-shim
public-hoist-pattern[]=abort-controller
public-hoist-pattern[]=base64-js
public-hoist-pattern[]=whatwg-fetch
public-hoist-pattern[]=ws
public-hoist-pattern[]=yargs
public-hoist-pattern[]=semver
public-hoist-pattern[]=promise
public-hoist-pattern[]=react-devtools-core
public-hoist-pattern[]=react-refresh
public-hoist-pattern[]=flow-enums-runtime
public-hoist-pattern[]=babel-jest
public-hoist-pattern[]=jest-environment-node
public-hoist-pattern[]=babel-plugin-syntax-hermes-parser
public-hoist-pattern[]=@jest/create-cache-key-function

# ----- @react-navigation / expo 非 scoped 传递依赖 -----
public-hoist-pattern[]=escape-string-regexp
public-hoist-pattern[]=fast-deep-equal
public-hoist-pattern[]=nanoid
public-hoist-pattern[]=query-string
public-hoist-pattern[]=react-is
public-hoist-pattern[]=use-latest-callback
public-hoist-pattern[]=color
public-hoist-pattern[]=warn-once
public-hoist-pattern[]=whatwg-url-without-unicode
public-hoist-pattern[]=babel-preset-expo
public-hoist-pattern[]=ua-parser-js
public-hoist-pattern[]=assert
public-hoist-pattern[]=badgin

# ----- react-native-* / nativewind / workspace 包的非 scoped 传递依赖 -----
public-hoist-pattern[]=react-freeze
public-hoist-pattern[]=comment-json
public-hoist-pattern[]=debug
public-hoist-pattern[]=lightningcss
public-hoist-pattern[]=convert-source-map
public-hoist-pattern[]=merge-options
public-hoist-pattern[]=html2canvas
public-hoist-pattern[]=events
public-hoist-pattern[]=js-sha1
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=class-variance-authority
public-hoist-pattern[]=clsx
public-hoist-pattern[]=tailwind-merge
public-hoist-pattern[]=xstate
public-hoist-pattern[]=zod
